From 3abaf17f213c916bf51dd89ca276e3cd3c3f2495 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 18:28:18 +0000
Subject: [PATCH 04/27] libos/linux: Use the kernel's MINSIGSTKSZ and SIGSTKSZ

The aarch64 kernel rejects alternate signal stacks smaller than 5120
bytes, so sigaltstack failed with ENOMEM for a MINSIGSTKSZ (2048)
stack. Let libos/linux supply the values in <sys/_signal.h>, which
<signal.h> includes when present.
---
 libc/include/signal.h             |  9 ++++--
 libos/linux/include/sys/_signal.h | 51 +++++++++++++++++++++++++++++++
 libos/linux/meson.build           |  5 +--
 3 files changed, 61 insertions(+), 4 deletions(-)
 create mode 100644 libos/linux/include/sys/_signal.h

diff --git a/libc/include/signal.h b/libc/include/signal.h
index 6505783980..3276d62c97 100644
--- a/libc/include/signal.h
+++ b/libc/include/signal.h
@@ -175,9 +175,14 @@ struct sigevent {
 #if __BSD_VISIBLE || __XSI_VISIBLE >= 4 || __POSIX_VISIBLE >= 200809
 
 /*
- * Minimum and default signal stack constants. Allow for target overrides
- * from <sys/features.h>.
+ * Minimum and default signal stack constants. Allow for overrides from
+ * the OS in <sys/_signal.h>.
  */
+#if defined(__has_include)
+#if __has_include(<sys/_signal.h>)
+#include <sys/_signal.h>
+#endif
+#endif
 #ifndef MINSIGSTKSZ
 #define MINSIGSTKSZ 2048
 #endif
diff --git a/libos/linux/include/sys/_signal.h b/libos/linux/include/sys/_signal.h
new file mode 100644
index 0000000000..40dffca3dd
--- /dev/null
+++ b/libos/linux/include/sys/_signal.h
@@ -0,0 +1,51 @@
