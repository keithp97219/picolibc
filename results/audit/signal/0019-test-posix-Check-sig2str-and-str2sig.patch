+# glibc doesn't have sig2str and str2sig
+test_skip_native += ['test-sig2str']
diff --git a/test/test-posix/test-signal/test-sig2str.c b/test/test-posix/test-signal/test-sig2str.c
new file mode 100644
index 0000000000..d58c8edcf6
--- /dev/null
+++ b/test/test-posix/test-signal/test-sig2str.c
@@ -0,0 +1,160 @@
