index 450725072d..7fd9a33b0d 100644
--- a/test/test-posix/test-signal/CMakeLists.txt
+++ b/test/test-posix/test-signal/CMakeLists.txt
@@ -39,6 +39,7 @@ set(tests
   test-psiginfo
   test-rtsig
   test-si_code
+  test-sig2str
   test-sigaction
   test-sigaltstack
   test-signal
diff --git a/test/test-posix/test-signal/meson.build b/test/test-posix/test-signal/meson.build
index 03aca5ff57..2e71fe3b1c 100644
--- a/test/test-posix/test-signal/meson.build
+++ b/test/test-posix/test-signal/meson.build
@@ -39,6 +39,7 @@ dir_tests = [
   'test-psiginfo',
   'test-rtsig',
   'test-si_code',
+  'test-sig2str',
   'test-sigaction',
   'test-sigaltstack',
   'test-signal',
@@ -51,3 +52,6 @@ dir_tests = [
   'test-sigwait',
