 test/test-posix/test-signal/meson.build    |   4 +
 test/test-posix/test-signal/test-sig2str.c | 160 +++++++++++++++++++++
 3 files changed, 165 insertions(+)
 create mode 100644 test/test-posix/test-signal/test-sig2str.c

