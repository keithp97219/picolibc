From 3a6409ac3ef97fff4a8b84bc6be73a3ff4df96af Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 18:33:30 +0000
Subject: [PATCH 09/27] signal: Make sigev_notify_attributes a pthread_attr_t
 pointer

POSIX declares it pthread_attr_t *. Keep void * when there are no
thread types.
---
 libc/include/signal.h | 21 ++++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/libc/include/signal.h b/libc/include/signal.h
index e3fe2a34f7..77bae7a9a3 100644
--- a/libc/include/signal.h
+++ b/libc/include/signal.h
@@ -197,13 +197,24 @@ typedef struct sigaltstack {
     NOTE: P1003.1c/D10, p. 34 adds sigev_notify_function and
           sigev_notify_attributes to the sigevent structure.  */
 
+/* pthread_t and pthread_attr_t, when there are threads */
+#if defined(__has_include)
+#if __has_include(<sys/_pthreadtypes.h>)
+#include <sys/_pthreadtypes.h>
+#define __SIGEV_ATTR_TYPE pthread_attr_t
+#endif
+#endif
+#ifndef __SIGEV_ATTR_TYPE
+#define __SIGEV_ATTR_TYPE void
+#endif
+
 struct sigevent {
-    int          sigev_notify; /* Notification type */
-    int          sigev_signo;  /* Signal number */
-    union sigval sigev_value;  /* Signal value */
-    void         (*sigev_notify_function)(union sigval);
+    int                sigev_notify; /* Notification type */
+    int                sigev_signo;  /* Signal number */
+    union sigval       sigev_value;  /* Signal value */
+    void               (*sigev_notify_function)(union sigval);
     /* Notification function */
-    void        *sigev_notify_attributes; /* Notification Attributes */
+    __SIGEV_ATTR_TYPE *sigev_notify_attributes; /* Notification Attributes */
 };
 #endif /* __POSIX_VISIBLE >= 199309 */
 
