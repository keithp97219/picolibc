+#define _POSIX_C_SOURCE 202405L
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/* sigemptyset, sigfillset, sigaddset, sigdelset and sigismember */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+static const int signals[] = {
+    SIGABRT, SIGALRM, SIGBUS,   SIGCHLD, SIGCONT, SIGFPE,  SIGHUP,    SIGILL,  SIGINT,
+    SIGKILL, SIGPIPE, SIGQUIT,  SIGSEGV, SIGSTOP, SIGTERM, SIGTSTP,   SIGTTIN, SIGTTOU,
+    SIGUSR1, SIGUSR2, SIGWINCH, SIGSYS,  SIGTRAP, SIGURG,  SIGVTALRM, SIGXCPU, SIGXFSZ,
+};
+
+#define NSIGNALS (sizeof(signals) / sizeof(signals[0]))
+
+/* Calls through pointers, so the functions are used and not the macros */
+static int (* const p_sigemptyset)(sigset_t *) = sigemptyset;
+static int (* const p_sigfillset)(sigset_t *) = sigfillset;
+static int (* const p_sigaddset)(sigset_t *, int) = sigaddset;
+static int (* const p_sigdelset)(sigset_t *, int) = sigdelset;
+static int (* const p_sigismember)(const sigset_t *, int) = sigismember;
+
+static void
+check_sets(int use_functions)
+{
+    sigset_t empty, full, set;
+    size_t   i;
+    int      sig;
+
+    check((use_functions ? p_sigemptyset(&empty) : sigemptyset(&empty)) == 0, "sigemptyset");
+    check((use_functions ? p_sigfillset(&full) : sigfillset(&full)) == 0, "sigfillset");
+    for (i = 0; i < NSIGNALS; i++) {
+        sig = signals[i];
+        check((use_functions ? p_sigismember(&empty, sig) : sigismember(&empty, sig)) == 0,
+              "empty set excludes every signal");
+        check((use_functions ? p_sigismember(&full, sig) : sigismember(&full, sig)) == 1,
+              "full set includes every signal");
+    }
+    for (sig = SIGRTMIN; sig <= SIGRTMAX; sig++) {
+        check(sigismember(&empty, sig) == 0, "empty set excludes real-time signals");
+        check(sigismember(&full, sig) == 1, "full set includes real-time signals");
+    }
+
+    /* Adding and deleting changes only that signal */
+    set = empty;
+    check((use_functions ? p_sigaddset(&set, SIGUSR1) : sigaddset(&set, SIGUSR1)) == 0,
+          "sigaddset");
+    check((use_functions ? p_sigaddset(&set, SIGRTMAX) : sigaddset(&set, SIGRTMAX)) == 0,
+          "sigaddset SIGRTMAX");
+    for (i = 0; i < NSIGNALS; i++)
+        check(sigismember(&set, signals[i]) == (signals[i] == SIGUSR1),
+              "sigaddset adds only that signal");
+    check(sigismember(&set, SIGRTMAX) == 1 && sigismember(&set, SIGRTMIN) == 0,
+          "sigaddset real-time");
+    check((use_functions ? p_sigaddset(&set, SIGUSR1) : sigaddset(&set, SIGUSR1)) == 0,
+          "adding twice");
+    check((use_functions ? p_sigdelset(&set, SIGUSR1) : sigdelset(&set, SIGUSR1)) == 0,
+          "sigdelset");
+    check((use_functions ? p_sigdelset(&set, SIGUSR1) : sigdelset(&set, SIGUSR1)) == 0,
+          "deleting an absent signal");
+    check(sigismember(&set, SIGUSR1) == 0 && sigismember(&set, SIGRTMAX) == 1,
+          "sigdelset deletes only that signal");
+
+    set = full;
+    check((use_functions ? p_sigdelset(&set, SIGINT) : sigdelset(&set, SIGINT)) == 0,
+          "sigdelset from full");
+    for (i = 0; i < NSIGNALS; i++)
+        check(sigismember(&set, signals[i]) == (signals[i] != SIGINT),
+              "sigdelset removes only that signal");
+}
+
+int
+main(void)
+{
+    check_sets(0);
+    check_sets(1);
+    printf("success\n");
+    return 0;
+}
