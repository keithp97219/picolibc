+dir_thread_tests = [
+  'test-raise-thread',
+]
+
 # glibc doesn't have sig2str and str2sig
 test_skip_native += ['test-sig2str']
diff --git a/test/test-posix/test-signal/test-raise-thread.c b/test/test-posix/test-signal/test-raise-thread.c
new file mode 100644
index 0000000000..5f4983453e
--- /dev/null
+++ b/test/test-posix/test-signal/test-raise-thread.c
@@ -0,0 +1,152 @@
