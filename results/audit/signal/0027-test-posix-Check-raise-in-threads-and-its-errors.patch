diff --git a/test/test-posix/test-signal/CMakeLists.txt b/test/test-posix/test-signal/CMakeLists.txt
index 5393a22549..82e0256fc2 100644
--- a/test/test-posix/test-signal/CMakeLists.txt
+++ b/test/test-posix/test-signal/CMakeLists.txt
@@ -37,6 +37,7 @@ set(tests
   test-kill
   test-killpg
   test-psiginfo
