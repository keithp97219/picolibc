+#ifndef _LOCAL_UIO_H_
+#define _LOCAL_UIO_H_
+
+#include "local-linux.h"
+#include <limits.h>
+#include <stdbool.h>
+#include <sys/uio.h>
+
+/*
+ * The kernel quietly shortens a transfer whose lengths add up past
+ * SSIZE_MAX, where POSIX requires EINVAL. Checks an array whose count
+ * the kernel would accept; returns false with errno set when the sum
+ * overflows.
+ */
+static inline bool
+_iov_total_fits(const struct iovec *iov, int iovcnt)
+{
+    size_t total = 0;
+
+    for (int i = 0; i < iovcnt; i++) {
+        if (iov[i].iov_len > (size_t)SSIZE_MAX - total) {
+            errno = EINVAL;
+            return false;
+        }
+        total += iov[i].iov_len;
+    }
+    return true;
+}
+
+#endif /* _LOCAL_UIO_H_ */
diff --git a/libos/linux/readv.c b/libos/linux/readv.c
index 15414bb56f..08adc82f3f 100644
--- a/libos/linux/readv.c
+++ b/libos/linux/readv.c
@@ -33,15 +33,21 @@
  * OF THE POSSIBILITY OF SUCH DAMAGE.
  */
 
-#include "local-linux.h"
+#include "local-uio.h"
 #include "local-cancel.h"
-#include <sys/uio.h>
 
 ssize_t
 readv(int fd, const struct iovec *iov, int iovcnt)
 {
-    void *cancel = _cancel_enter();
-    long  ret = _syscall(LINUX_SYS_readv, fd, iov, iovcnt);
+    void *cancel;
+    long  ret;
+
+    cancel = _cancel_enter();
+    if (iovcnt > 0 && iovcnt <= IOV_MAX && !_iov_total_fits(iov, iovcnt)) {
+        _cancel_leave(cancel);
+        return -1;
+    }
+    ret = _syscall(LINUX_SYS_readv, fd, iov, iovcnt);
 
     _cancel_leave(cancel);
     return (ssize_t)ret;
diff --git a/libos/linux/writev.c b/libos/linux/writev.c
index 9de00ba4d8..e720d12ec5 100644
--- a/libos/linux/writev.c
+++ b/libos/linux/writev.c
@@ -33,15 +33,21 @@
  * OF THE POSSIBILITY OF SUCH DAMAGE.
  */
 
-#include "local-linux.h"
+#include "local-uio.h"
 #include "local-cancel.h"
-#include <sys/uio.h>
 
 ssize_t
 writev(int fd, const struct iovec *iov, int iovcnt)
 {
-    void *cancel = _cancel_enter();
-    long  ret = _syscall(LINUX_SYS_writev, fd, iov, iovcnt);
+    void *cancel;
+    long  ret;
+
+    cancel = _cancel_enter();
+    if (iovcnt > 0 && iovcnt <= IOV_MAX && !_iov_total_fits(iov, iovcnt)) {
+        _cancel_leave(cancel);
+        return -1;
+    }
+    ret = _syscall(LINUX_SYS_writev, fd, iov, iovcnt);
 
     _cancel_leave(cancel);
     return (ssize_t)ret;
