From c4c0035966b6d310cfb1985721277c2b6510ed84 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:51:48 +0000
Subject: [PATCH 13/41] libos/linux: Return IOV_MAX from sysconf(_SC_IOV_MAX)

sysconf fell back to the minimum, _XOPEN_IOV_MAX (16), while
<limits.h> defines IOV_MAX as 1024, the kernel's UIO_MAXIOV.
---
 libos/linux/sysconf.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libos/linux/sysconf.c b/libos/linux/sysconf.c
index b2e036eb06..aa9a893508 100644
--- a/libos/linux/sysconf.c
+++ b/libos/linux/sysconf.c
@@ -68,6 +68,9 @@ sysconf(int name)
             return -1;
         value /= 4;
         return value < _POSIX_ARG_MAX ? _POSIX_ARG_MAX : value;
+    case _SC_IOV_MAX:
+        /* The kernel's UIO_MAXIOV */
+        return IOV_MAX;
     case _SC_CLK_TCK:
         /* The kernel's USER_HZ, which times() counts in */
         return 100;
