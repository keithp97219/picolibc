From ed119daa5b36c4776d7ab2762c5c9bf4a2cd9034 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:56:08 +0000
Subject: [PATCH 22/41] test-posix: Check backlogs, readiness and errors in
 listen

SO_ACCEPTCONN, SOMAXCONN, a listening socket becomes readable with a
connection waiting, binding by listen, a negative backlog acting as 0,
EINVAL, EOPNOTSUPP, ENOTSOCK, EBADF and EDESTADDRREQ.
---
 .../test-posix/test-sys-socket/CMakeLists.txt |   1 +
 test/test-posix/test-sys-socket/meson.build   |   1 +
 test/test-posix/test-sys-socket/test-listen.c | 261 ++++++++++++++++++
 3 files changed, 263 insertions(+)
 create mode 100644 test/test-posix/test-sys-socket/test-listen.c

diff --git a/test/test-posix/test-sys-socket/CMakeLists.txt b/test/test-posix/test-sys-socket/CMakeLists.txt
index 75e5a56817..a3275308b9 100644
--- a/test/test-posix/test-sys-socket/CMakeLists.txt
+++ b/test/test-posix/test-sys-socket/CMakeLists.txt
@@ -37,6 +37,7 @@ set(tests
   test-accept4
   test-bind
   test-connect
+  test-listen
   test-send
   test-sendmsg
   test-sendto
diff --git a/test/test-posix/test-sys-socket/meson.build b/test/test-posix/test-sys-socket/meson.build
index 5acdb1cc21..29b3332a8a 100644
--- a/test/test-posix/test-sys-socket/meson.build
+++ b/test/test-posix/test-sys-socket/meson.build
@@ -37,6 +37,7 @@ dir_tests = [
   'test-accept4',
   'test-bind',
   'test-connect',
+  'test-listen',
   'test-send',
   'test-sendmsg',
   'test-sendto',
diff --git a/test/test-posix/test-sys-socket/test-listen.c b/test/test-posix/test-sys-socket/test-listen.c
new file mode 100644
index 0000000000..37b1dc9c23
--- /dev/null
+++ b/test/test-posix/test-sys-socket/test-listen.c
@@ -0,0 +1,261 @@
