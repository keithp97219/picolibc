From b912f2723c7bb5d0c16ace5334e20898cb6890c1 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:56:08 +0000
Subject: [PATCH 16/41] test-posix: Check that the socket, uio, poll and select
 headers keep to their names

With only _POSIX_C_SOURCE, <sys/socket.h>, <sys/uio.h>, <poll.h> and
<sys/select.h> must not define the <endian.h> byte-order names or
NFDBITS.
---
 .../test-posix/test-sys-socket/CMakeLists.txt |   1 +
 test/test-posix/test-sys-socket/meson.build   |   1 +
 .../test-sys-socket/test-sys_socket_names.c   | 103 ++++++++++++++++++
 3 files changed, 105 insertions(+)
 create mode 100644 test/test-posix/test-sys-socket/test-sys_socket_names.c

diff --git a/test/test-posix/test-sys-socket/CMakeLists.txt b/test/test-posix/test-sys-socket/CMakeLists.txt
index 159fc784c4..75e5a56817 100644
--- a/test/test-posix/test-sys-socket/CMakeLists.txt
+++ b/test/test-posix/test-sys-socket/CMakeLists.txt
@@ -46,6 +46,7 @@ set(tests
   test-socket
   test-socketpair
   test-sys_socket_h
+  test-sys_socket_names
   )
 
 foreach(test IN LISTS tests)
diff --git a/test/test-posix/test-sys-socket/meson.build b/test/test-posix/test-sys-socket/meson.build
index bc27caa903..5acdb1cc21 100644
--- a/test/test-posix/test-sys-socket/meson.build
+++ b/test/test-posix/test-sys-socket/meson.build
@@ -46,4 +46,5 @@ dir_tests = [
   'test-socket',
   'test-socketpair',
   'test-sys_socket_h',
+  'test-sys_socket_names',
 ]
diff --git a/test/test-posix/test-sys-socket/test-sys_socket_names.c b/test/test-posix/test-sys-socket/test-sys_socket_names.c
new file mode 100644
index 0000000000..f1e8829d37
--- /dev/null
+++ b/test/test-posix/test-sys-socket/test-sys_socket_names.c
@@ -0,0 +1,103 @@
