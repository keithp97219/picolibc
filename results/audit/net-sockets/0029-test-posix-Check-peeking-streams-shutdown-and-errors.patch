From 19e32949fdbdbb7824280009aa6046dbee36e710 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:56:09 +0000
Subject: [PATCH 29/41] test-posix: Check peeking, streams, shutdown and errors
 in recv

MSG_PEEK and MSG_WAITALL across sends, EAGAIN, EINVAL for MSG_OOB, 0
after an orderly shutdown, ECONNRESET, ENOTCONN, EOPNOTSUPP, ENOTSOCK
and EBADF, for recv and recvfrom.
---
 .../test-posix/test-sys-socket/CMakeLists.txt |   1 +
 test/test-posix/test-sys-socket/meson.build   |   1 +
 test/test-posix/test-sys-socket/test-recv.c   | 192 ++++++++++++++++++
 3 files changed, 194 insertions(+)
 create mode 100644 test/test-posix/test-sys-socket/test-recv.c

diff --git a/test/test-posix/test-sys-socket/CMakeLists.txt b/test/test-posix/test-sys-socket/CMakeLists.txt
index 68cf37e05e..49b815a7ee 100644
--- a/test/test-posix/test-sys-socket/CMakeLists.txt
+++ b/test/test-posix/test-sys-socket/CMakeLists.txt
@@ -39,6 +39,7 @@ set(tests
   test-connect
   test-getpeername
   test-listen
+  test-recv
   test-send
   test-sendmsg
   test-sendto
diff --git a/test/test-posix/test-sys-socket/meson.build b/test/test-posix/test-sys-socket/meson.build
index 333eb8e1af..1e3cd4ce0f 100644
--- a/test/test-posix/test-sys-socket/meson.build
+++ b/test/test-posix/test-sys-socket/meson.build
@@ -39,6 +39,7 @@ dir_tests = [
   'test-connect',
   'test-getpeername',
   'test-listen',
+  'test-recv',
   'test-send',
   'test-sendmsg',
   'test-sendto',
diff --git a/test/test-posix/test-sys-socket/test-recv.c b/test/test-posix/test-sys-socket/test-recv.c
new file mode 100644
index 0000000000..865d4b7514
--- /dev/null
+++ b/test/test-posix/test-sys-socket/test-recv.c
@@ -0,0 +1,192 @@
