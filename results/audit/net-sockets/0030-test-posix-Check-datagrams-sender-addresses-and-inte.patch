From 7a51eba6748d118feea6f0dadc855fdfedbe3340 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:56:09 +0000
Subject: [PATCH 30/41] test-posix: Check datagrams, sender addresses and
 interruption in recvfrom

One datagram per call with the excess discarded, MSG_PEEK keeping it,
the sender's address and its truncation, and EINTR.
---
 .../test-posix/test-sys-socket/CMakeLists.txt |   1 +
 test/test-posix/test-sys-socket/meson.build   |   1 +
 .../test-sys-socket/test-recvfrom.c           | 222 ++++++++++++++++++
 3 files changed, 224 insertions(+)
 create mode 100644 test/test-posix/test-sys-socket/test-recvfrom.c

diff --git a/test/test-posix/test-sys-socket/CMakeLists.txt b/test/test-posix/test-sys-socket/CMakeLists.txt
index 49b815a7ee..3d02cf5481 100644
--- a/test/test-posix/test-sys-socket/CMakeLists.txt
+++ b/test/test-posix/test-sys-socket/CMakeLists.txt
@@ -40,6 +40,7 @@ set(tests
   test-getpeername
   test-listen
   test-recv
+  test-recvfrom
   test-send
   test-sendmsg
   test-sendto
diff --git a/test/test-posix/test-sys-socket/meson.build b/test/test-posix/test-sys-socket/meson.build
index 1e3cd4ce0f..3b88f60a19 100644
--- a/test/test-posix/test-sys-socket/meson.build
+++ b/test/test-posix/test-sys-socket/meson.build
@@ -40,6 +40,7 @@ dir_tests = [
   'test-getpeername',
   'test-listen',
   'test-recv',
+  'test-recvfrom',
   'test-send',
   'test-sendmsg',
   'test-sendto',
diff --git a/test/test-posix/test-sys-socket/test-recvfrom.c b/test/test-posix/test-sys-socket/test-recvfrom.c
new file mode 100644
index 0000000000..f76484f681
--- /dev/null
+++ b/test/test-posix/test-sys-socket/test-recvfrom.c
@@ -0,0 +1,222 @@
