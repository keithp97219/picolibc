+
+#define _POSIX_C_SOURCE 202405L
+#include <unistd.h>
+
+/* Without the system support this test needs, it is skipped */
+#if !defined(__PICOLIBC__)                                                       \
+    || (defined(__PICOLIBC_POSIX_NETWORKING) && __PICOLIBC_POSIX_NETWORKING > 0)
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+#include <time.h>
+
+/* recvfrom takes whole datagrams and their senders, and can be interrupted */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+/* Skips the test when the system has no sockets of this family */
+static int
+make_socket(int family, int type)
+{
+    int fd = socket(family, type, 0);
+
+    if (fd < 0 && (errno == EAFNOSUPPORT || errno == EACCES || errno == EPERM)) {
+        printf("no sockets of family %d, skipping\n", family);
+        exit(77);
+    }
+    check(fd >= 0, "socket");
+    return fd;
+}
+
+/* A loopback IPv4 socket address with port 0 */
+static struct sockaddr_in
+loopback(void)
+{
+    struct sockaddr_in sin;
+
+    memset(&sin, 0, sizeof(sin));
+    sin.sin_family = AF_INET;
+    sin.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    return sin;
+}
+
+/* A connected pair of TCP sockets over the loopback interface */
+static void
+tcp_pair(int *client, int *server)
+{
+    struct sockaddr_in sin = loopback();
+    socklen_t          len = sizeof(sin);
+    int                listener = make_socket(AF_INET, SOCK_STREAM);
+
+    check(bind(listener, (struct sockaddr *)&sin, sizeof(sin)) == 0, "bind");
+    check(listen(listener, 1) == 0, "listen");
+    check(getsockname(listener, (struct sockaddr *)&sin, &len) == 0, "getsockname");
+    *client = make_socket(AF_INET, SOCK_STREAM);
+    check(connect(*client, (struct sockaddr *)&sin, sizeof(sin)) == 0, "connect");
+    *server = accept(listener, NULL, NULL);
+    check(*server >= 0, "accept");
+    check(close(listener) == 0, "close listener");
+}
+
+/*
+ * A child that sends SIGUSR1 every 10ms to a handler installed without
+ * SA_RESTART, so a call that blocks is interrupted whenever it starts
+ */
+static volatile sig_atomic_t interrupts;
+
+static void
+on_interrupt(int sig)
+{
+    (void)sig;
+    interrupts++;
+}
+
+static pid_t
+start_interrupts(void)
+{
+    struct sigaction act;
+    pid_t            parent = getpid(), pid;
+
+    memset(&act, 0, sizeof(act));
+    act.sa_handler = on_interrupt;
+    sigemptyset(&act.sa_mask);
+    check(sigaction(SIGUSR1, &act, NULL) == 0, "sigaction");
+    pid = fork();
+    check(pid >= 0, "fork");
+    if (pid == 0) {
+        struct timespec ts = { 0, 10 * 1000 * 1000 };
+
+        for (;;) {
+            kill(parent, SIGUSR1);
+            nanosleep(&ts, NULL);
+        }
+    }
+    return pid;
+}
+
+static void
+stop_interrupts(pid_t pid)
+{
+    check(kill(pid, SIGKILL) == 0 && waitpid(pid, NULL, 0) == pid, "stop the interrupter");
+    check(signal(SIGUSR1, SIG_IGN) != SIG_ERR, "ignore SIGUSR1");
+}
+
+int
+main(void)
+{
+    struct sockaddr_in a = loopback(), b = loopback(), from;
+    unsigned char      small[sizeof(struct sockaddr_in)];
+    socklen_t          len;
+    pid_t              interrupter;
+    int                sa, sb;
+    char               buf[16];
+
+    /* Datagrams: one per call, and the excess is discarded */
+    sa = make_socket(AF_INET, SOCK_DGRAM);
+    sb = make_socket(AF_INET, SOCK_DGRAM);
+    len = sizeof(a);
+    check(bind(sa, (struct sockaddr *)&a, sizeof(a)) == 0
+              && getsockname(sa, (struct sockaddr *)&a, &len) == 0,
+          "bind a");
+    len = sizeof(b);
+    check(bind(sb, (struct sockaddr *)&b, sizeof(b)) == 0
+              && getsockname(sb, (struct sockaddr *)&b, &len) == 0,
+          "bind b");
+    check(sendto(sa, "first", 5, 0, (struct sockaddr *)&b, sizeof(b)) == 5
+              && sendto(sa, "second", 6, 0, (struct sockaddr *)&b, sizeof(b)) == 6,
+          "sendto");
+    check(recv(sb, buf, 3, MSG_PEEK) == 3 && memcmp(buf, "fir", 3) == 0, "peek a datagram");
+    len = sizeof(from);
+    check(recvfrom(sb, buf, sizeof(buf), MSG_PEEK, (struct sockaddr *)&from, &len) == 5,
+          "peek keeps it whole");
+    check(recv(sb, buf, 3, 0) == 3 && memcmp(buf, "fir", 3) == 0, "truncated datagram");
+    /* The sender's address, cut to fit */
+    memset(small, 0xa5, sizeof(small));
+    len = 4;
+    check(recvfrom(sb, buf, sizeof(buf), 0, (struct sockaddr *)small, &len) == 6
+              && memcmp(buf, "second", 6) == 0,
+          "the next datagram");
+    check(len == sizeof(struct sockaddr_in) && small[4] == 0xa5 && memcmp(small, &a, 4) == 0,
+          "truncated address");
+    check(sendto(sa, "third", 5, 0, (struct sockaddr *)&b, sizeof(b)) == 5, "sendto");
+    len = sizeof(from);
+    check(recvfrom(sb, buf, sizeof(buf), 0, (struct sockaddr *)&from, &len) == 5
+              && len == sizeof(from) && from.sin_family == AF_INET && from.sin_port == a.sin_port
+              && from.sin_addr.s_addr == a.sin_addr.s_addr,
+          "sender address");
+    /* A blocking receive waits until a signal interrupts it */
+    interrupter = start_interrupts();
+    errno = 0;
+    check(recv(sb, buf, sizeof(buf), 0) == -1 && errno == EINTR, "EINTR");
+    errno = 0;
+    check(recvfrom(sb, buf, sizeof(buf), 0, NULL, NULL) == -1 && errno == EINTR, "recvfrom EINTR");
+    stop_interrupts(interrupter);
+    check(close(sa) == 0 && close(sb) == 0, "close");
+
+    (void)tcp_pair;
+    printf("success\n");
+    return 0;
+}
+
+#else
+
+#include <stdio.h>
+
+int
+main(void)
+{
+    printf("no system support, skipping\n");
+    return 77;
+}
+
+#endif
