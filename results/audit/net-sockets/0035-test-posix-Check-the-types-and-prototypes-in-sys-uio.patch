 test/test-posix/test-sys-uio/meson.build      |  1 +
 test/test-posix/test-sys-uio/test-sys_uio_h.c | 82 +++++++++++++++++++
 3 files changed, 84 insertions(+)
 create mode 100644 test/test-posix/test-sys-uio/test-sys_uio_h.c

diff --git a/test/test-posix/test-sys-uio/CMakeLists.txt b/test/test-posix/test-sys-uio/CMakeLists.txt
index a372cbcacf..0c616a8309 100644
--- a/test/test-posix/test-sys-uio/CMakeLists.txt
+++ b/test/test-posix/test-sys-uio/CMakeLists.txt
@@ -35,6 +35,7 @@
 
 set(tests
   test-readv
+  test-sys_uio_h
   test-writev
   )
 
diff --git a/test/test-posix/test-sys-uio/meson.build b/test/test-posix/test-sys-uio/meson.build
index df98baab65..912666732c 100644
--- a/test/test-posix/test-sys-uio/meson.build
+++ b/test/test-posix/test-sys-uio/meson.build
@@ -35,5 +35,6 @@
 
 dir_tests = [
   'test-readv',
+  'test-sys_uio_h',
   'test-writev',
 ]
diff --git a/test/test-posix/test-sys-uio/test-sys_uio_h.c b/test/test-posix/test-sys-uio/test-sys_uio_h.c
new file mode 100644
index 0000000000..258bb7b58f
--- /dev/null
+++ b/test/test-posix/test-sys-uio/test-sys_uio_h.c
@@ -0,0 +1,82 @@
