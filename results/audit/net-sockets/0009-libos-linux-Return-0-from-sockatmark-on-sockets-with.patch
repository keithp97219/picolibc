From 03a2125e6fe131a4c7448fbb7552cf2a6d6d9990 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:51:48 +0000
Subject: [PATCH 09/41] libos/linux: Return 0 from sockatmark on sockets
 without out-of-band marks

Linux rejects SIOCATMARK with ENOTTY on sockets whose protocol has no
marks (UDP, AF_UNIX on this kernel), and POSIX keeps ENOTTY for
descriptors that aren't sockets: "if there is no mark ... the
sockatmark() function shall return 0".
---
 libos/linux/sockatmark.c | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/libos/linux/sockatmark.c b/libos/linux/sockatmark.c
index e65e8839b2..ac608e16c4 100644
--- a/libos/linux/sockatmark.c
+++ b/libos/linux/sockatmark.c
@@ -34,13 +34,24 @@
  */
 
 #include "local-socket.h"
+#include <linux/linux-errno.h>
 
 int
 sockatmark(int fd)
 {
-    int atmark;
+    int       atmark, type;
+    socklen_t len = sizeof(type);
+    long      ret = _syscall_raw(LINUX_SYS_ioctl, fd, LINUX_SIOCATMARK, &atmark);
 
-    if (_syscall(LINUX_SYS_ioctl, fd, LINUX_SIOCATMARK, &atmark) < 0)
-        return -1;
-    return atmark;
+    if (ret == 0)
+        return atmark;
+    /*
+     * Sockets whose protocol has no out-of-band marks, like UDP, reject
+     * the request; they are never at a mark
+     */
+    if (ret == -LINUX_ENOTTY
+        && _syscall_raw(LINUX_SYS_getsockopt, fd, SOL_SOCKET, SO_TYPE, &type, &len) == 0)
+        return 0;
+    errno = _syscall_errno(ret);
+    return -1;
 }
