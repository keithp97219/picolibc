+
+#define _DEFAULT_SOURCE
+#include "local-pthread.h"
+#include <threads.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+/*
+ * The generic thrd_create can't tell a lack of memory from the other
+ * reasons pthread_create gives EAGAIN for; this one can.
+ */
+
+struct __thrd_start {
+    thrd_start_t func;
+    void        *arg;
+};
+
+static void *
+__thrd_run(void *p)
+{
+    struct __thrd_start start = *(struct __thrd_start *)p;
+
+    free(p);
+    return (void *)(intptr_t)start.func(start.arg);
+}
+
+int
+thrd_create(thrd_t *thr, thrd_start_t func, void *arg)
+{
+    struct __thrd_start *start = malloc(sizeof(*start));
+    int                  ret;
+
+    if (!start)
+        return thrd_nomem;
+    start->func = func;
+    start->arg = arg;
+    ret = _pthread_create(thr, NULL, __thrd_run, start);
+    if (ret == 0)
+        return thrd_success;
+    free(start);
+    return ret == ENOMEM ? thrd_nomem : thrd_error;
+}
