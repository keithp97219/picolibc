index 0000000000..488569c0bc
--- /dev/null
+++ b/test/test-posix/test-threads/test-thrd_sleep.c
@@ -0,0 +1,272 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright © 2026 Keith Packard
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ *
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ *
+ * 2. Redistributions in binary form must reproduce the above
+ *    copyright notice, this list of conditions and the following
+ *    disclaimer in the documentation and/or other materials provided
+ *    with the distribution.
+ *
+ * 3. Neither the name of the copyright holder nor the names of its
+ *    contributors may be used to endorse or promote products derived
+ *    from this software without specific prior written permission.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS
+ * FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE
+ * COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT,
+ * INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES
+ * (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
+ * SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT,
+ * STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED
+ * OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#define _POSIX_C_SOURCE 202405L
+#include <unistd.h>
+
+/* Without the system support this test needs, it is skipped */
+#if !defined(__PICOLIBC__) || (defined(_POSIX_THREADS) && _POSIX_THREADS > 0)
+
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <threads.h>
+#include <time.h>
+
+/*
+ * thrd_sleep: it sleeps at least the duration as TIME_UTC measures
+ * it, returns -1 with the remaining time when a caught signal
+ * interrupts it, a negative value with errno for invalid durations,
+ * and is a cancellation point
+ */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+#define NSEC 1000000000LL
+
+static volatile int    signalled;
+static volatile int    done;
+static volatile int    returned;
+
+/* What the interrupted sleep reported */
+static struct timespec sleep_duration, sleep_remaining;
+static long long       sleep_elapsed;
+static int             sleep_ret, sleep_errno;
+
+static void
+handler(int sig)
+{
+    (void)sig;
+    signalled++;
+}
+
+static long long
+now_ns(void)
+{
+    struct timespec ts;
+
+    check(timespec_get(&ts, TIME_UTC) == TIME_UTC, "timespec_get");
+    return ts.tv_sec * NSEC + ts.tv_nsec;
+}
+
+static long long
+ns(const struct timespec *ts)
+{
+    return ts->tv_sec * NSEC + ts->tv_nsec;
+}
+
+/* Sleeps 30 s, which main's signals interrupt; arg asks for one timespec for both */
+static int
+sleeper(void *arg)
+{
+    struct timespec duration = { 30, 0 }, remaining = { -1, -1 };
+    long long       start = now_ns();
+
+    sleep_duration = duration;
+    if (arg) {
+        sleep_ret = thrd_sleep(&duration, &duration);
+        remaining = duration;
+    } else {
+        sleep_ret = thrd_sleep(&duration, &remaining);
+    }
+    sleep_errno = errno;
+    sleep_elapsed = now_ns() - start;
+    sleep_remaining = remaining;
+    __atomic_store_n(&done, 1, __ATOMIC_RELEASE);
+    return 0;
+}
+
+static void
+check_interrupted(int same)
+{
+    struct timespec ts = { 0, 20000000 };
+    thrd_t          thr;
+    int             i, res;
+    long long       remaining;
+
+    done = 0;
+    signalled = 0;
+    check(thrd_create(&thr, sleeper, same ? &thr : NULL) == thrd_success, "thrd_create");
+    /* A signal sent before the sleep starts doesn't end it, so keep sending */
+    for (i = 0; i < 1000 && !__atomic_load_n(&done, __ATOMIC_ACQUIRE); i++) {
+        check(pthread_kill(thr, SIGUSR1) == 0, "pthread_kill");
+        thrd_sleep(&ts, NULL);
+    }
+    check(thrd_join(thr, &res) == thrd_success, "thrd_join");
+    check(signalled > 0, "handler ran");
+    check(sleep_ret == -1, "thrd_sleep interrupted returns -1");
+#ifndef __GLIBC__
+    /* glibc's thrd_sleep leaves errno alone */
+    check(sleep_errno == EINTR, "errno is EINTR");
+#else
+    (void)sleep_errno;
+#endif
+    check(sleep_remaining.tv_nsec >= 0 && sleep_remaining.tv_nsec < NSEC,
+          "remaining time is valid");
+    remaining = ns(&sleep_remaining);
+    printf("%s timespec: interrupted after %lld ns with %lld ns remaining\n", same ? "one" : "two",
+           sleep_elapsed, remaining);
+    /*
+     * The requested interval minus the time actually slept. Linux
+     * computes it from the timer's expiry, which includes the
+     * thread's timer slack (50 us by default), so when the signal
+     * comes within the slack of the start it can exceed the request
+     * by up to that much; allow 1 ms.
+     */
+    check(remaining > 0 && remaining <= ns(&sleep_duration) + NSEC / 1000,
+          "remaining time in range");
+    check(remaining >= ns(&sleep_duration) - sleep_elapsed - NSEC / 10,
+          "remaining time accounts for the time slept");
+}
+
+static pthread_t main_thread;
+
+/* Sends main an ignored signal while it sleeps */
+static void *
+ignored_sender(void *arg)
+{
+    struct timespec ts = { 0, 10000000 };
+    int             i;
+
+    (void)arg;
+    for (i = 0; i < 5; i++) {
+        thrd_sleep(&ts, NULL);
+        pthread_kill(main_thread, SIGUSR2);
+    }
+    return NULL;
+}
+
+static void *
+cancelled_sleeper(void *arg)
+{
+    struct timespec duration = { 60, 0 };
+
+    (void)arg;
+    pthread_cancel(pthread_self());
+    (void)thrd_sleep(&duration, NULL);
+    returned = 1;
+    return NULL;
+}
+
+int
+main(void)
+{
+    struct sigaction act;
+    struct timespec  ts;
+    long long        start, elapsed;
+    pthread_t        pthr;
+    void            *pres = NULL;
+
+    alarm(120);
+
+    ts = (struct timespec) { 0, 0 };
+    check(thrd_sleep(&ts, NULL) == 0, "thrd_sleep zero");
+
+    /* Never shorter than requested */
+    ts = (struct timespec) { 0, 50000000 };
+    start = now_ns();
+    check(thrd_sleep(&ts, NULL) == 0, "thrd_sleep 50 ms");
+    elapsed = now_ns() - start;
+    check(elapsed >= ns(&ts), "slept at least 50 ms");
+
+    ts = (struct timespec) { 1, 0 };
+    start = now_ns();
+    check(thrd_sleep(&ts, &ts) == 0, "thrd_sleep 1 s");
+    elapsed = now_ns() - start;
+    check(elapsed >= NSEC, "slept at least 1 s");
+
+    /* A negative value, with errno set, for invalid durations */
+    ts = (struct timespec) { 0, -1 };
+    errno = 0;
+    check(thrd_sleep(&ts, NULL) < 0, "thrd_sleep negative nanoseconds");
+#ifndef __GLIBC__
+    /* glibc's thrd_sleep leaves errno alone */
+    check(errno == EINVAL, "errno for negative nanoseconds");
+#endif
+    ts = (struct timespec) { 0, 1000000000L };
+    errno = 0;
+    check(thrd_sleep(&ts, NULL) < 0, "thrd_sleep a billion nanoseconds");
+#ifndef __GLIBC__
+    check(errno == EINVAL, "errno for a billion nanoseconds");
+#endif
+
+    memset(&act, 0, sizeof(act));
+    act.sa_handler = handler;
+    sigemptyset(&act.sa_mask);
+    check(sigaction(SIGUSR1, &act, NULL) == 0, "sigaction");
+    check_interrupted(0);
+    check_interrupted(1);
+
+    /* An ignored signal doesn't end the sleep */
+    act.sa_handler = SIG_IGN;
+    check(sigaction(SIGUSR2, &act, NULL) == 0, "sigaction");
+    ts = (struct timespec) { 0, 200000000 };
+    main_thread = pthread_self();
+    check(pthread_create(&pthr, NULL, ignored_sender, NULL) == 0, "pthread_create");
+    start = now_ns();
+    check(thrd_sleep(&ts, NULL) == 0, "ignored signals");
+    check(now_ns() - start >= ns(&ts), "slept at least 200 ms");
+    check(pthread_join(pthr, NULL) == 0, "pthread_join");
+
+    /* A cancellation point */
+    check(pthread_create(&pthr, NULL, cancelled_sleeper, NULL) == 0, "pthread_create");
+    check(pthread_join(pthr, &pres) == 0, "pthread_join");
+    check(pres == PTHREAD_CANCELED && !returned, "thrd_sleep is a cancellation point");
+
+    printf("success\n");
+    return 0;
+}
+
+#else
+
+#include <stdio.h>
+
+int
+main(void)
+{
+    printf("no system support, skipping\n");
+    return 77;
+}
+
+#endif
diff --git a/test/test-posix/test-threads/test-threads_h.c b/test/test-posix/test-threads/test-threads_h.c
new file mode 100644
index 0000000000..9ae9df3a79
--- /dev/null
+++ b/test/test-posix/test-threads/test-threads_h.c
@@ -0,0 +1,284 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright © 2026 Keith Packard
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ *
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ *
+ * 2. Redistributions in binary form must reproduce the above
+ *    copyright notice, this list of conditions and the following
+ *    disclaimer in the documentation and/or other materials provided
+ *    with the distribution.
+ *
+ * 3. Neither the name of the copyright holder nor the names of its
+ *    contributors may be used to endorse or promote products derived
+ *    from this software without specific prior written permission.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS
+ * FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE
+ * COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT,
+ * INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES
+ * (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
+ * SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT,
+ * STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED
+ * OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#define _POSIX_C_SOURCE 202405L
+#include <threads.h>
+
+/*
+ * The contents of <threads.h>: types, enumeration constants, macros
+ * and prototypes, the <time.h> symbols it makes visible, and names
+ * it must not declare
+ */
+
+/*
+ * <threads.h> may not declare these: the pthread_ prefix is reserved
+ * for <pthread.h> and sched_ for <sched.h>. A declaration would
+ * conflict with these definitions.
+ */
+static int
+pthread_create(void)
+{
+    return 1;
+}
+
+static int
+pthread_mutex_lock(void)
+{
+    return 2;
+}
+
+static int
+pthread_key_create(void)
+{
+    return 3;
+}
+
+static int
+sched_yield(void)
+{
+    return 4;
+}
+
+/* <time.h> symbols, with nothing else included yet */
+static struct timespec time_spec;
+static time_t          time_value;
+static clockid_t       clock_value = CLOCK_REALTIME;
+_Static_assert(TIME_UTC > 0, "TIME_UTC");
+
+/* Complete object types, and the function pointer types */
+_Static_assert(sizeof(cnd_t) > 0 && sizeof(mtx_t) > 0 && sizeof(once_flag) > 0 && sizeof(thrd_t) > 0
+                   && sizeof(tss_t) > 0,
+               "complete types");
+_Static_assert(_Generic((thrd_start_t)0, int (*)(void *): 1, default: 0), "thrd_start_t");
+_Static_assert(_Generic((tss_dtor_t)0, void (*)(void *): 1, default: 0), "tss_dtor_t");
+
+/* Enumeration constants, not macros */
+#if defined(mtx_plain) || defined(mtx_recursive) || defined(mtx_timed) || defined(thrd_busy) \
+    || defined(thrd_error) || defined(thrd_nomem) || defined(thrd_success)                   \
+    || defined(thrd_timedout)
+#error <threads.h> constants are macros
+#endif
+
+/* Duplicate case labels would fail to compile */
+static int
+thrd_result_distinct(int v)
+{
+    switch (v) {
+    case thrd_success:
+    case thrd_busy:
+    case thrd_error:
+    case thrd_nomem:
+    case thrd_timedout:
+        return 1;
+    }
+    return 0;
+}
+
+static int
+mtx_type_distinct(int v)
+{
+    switch (v) {
+    case mtx_plain:
+    case mtx_timed:
+    case mtx_plain | mtx_recursive:
+    case mtx_timed | mtx_recursive:
+        return 1;
+    }
+    return 0;
+}
+
+/* TSS_DTOR_ITERATIONS works in #if */
+#if TSS_DTOR_ITERATIONS < 4
+#error TSS_DTOR_ITERATIONS is below _POSIX_THREAD_DESTRUCTOR_ITERATIONS
+#endif
+
+#if !defined(__cplusplus) && __STDC_VERSION__ < 202311L
+#ifndef thread_local
+#error thread_local is not defined
+#endif
+#endif
+
+#define str(x)  #x
+#define xstr(x) str(x)
+
+static thread_local int per_thread = 1;
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#if defined(PTHREAD_DESTRUCTOR_ITERATIONS) && TSS_DTOR_ITERATIONS != PTHREAD_DESTRUCTOR_ITERATIONS
+#error TSS_DTOR_ITERATIONS differs from PTHREAD_DESTRUCTOR_ITERATIONS
+#endif
+
+#if defined(__STDC_NO_THREADS__) && !defined(_POSIX_SUBPROFILE)
+#error __STDC_NO_THREADS__ is defined
+#endif
+
+/* thrd_t is pthread_t */
+_Static_assert(_Generic((thrd_t) { 0 }, pthread_t: 1, default: 0), "thrd_t is pthread_t");
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+/* The checks that need no library support */
+static void
+header_checks(void)
+{
+    (void)time_spec;
+    (void)time_value;
+    (void)clock_value;
+
+    check(pthread_create() == 1 && pthread_mutex_lock() == 2 && pthread_key_create() == 3
+              && sched_yield() == 4,
+          "names left to the application");
+
+    check(thrd_result_distinct(thrd_success) && mtx_type_distinct(mtx_plain), "constants");
+
+#if !defined(__cplusplus) && __STDC_VERSION__ < 202311L
+    check(strcmp(xstr(thread_local), "_Thread_local") == 0,
+          "thread_local expands to _Thread_local");
+#endif
+    check(per_thread == 1, "thread_local initializer");
+}
+
+/* Without the system support this test needs, it is skipped */
+#if !defined(__PICOLIBC__) || (defined(_POSIX_THREADS) && _POSIX_THREADS > 0)
+
+static once_flag once = ONCE_FLAG_INIT;
+
+/* The prototypes, through pointers of the specified types */
+static void      (     *volatile p_call_once)(once_flag *, void (*)(void)) = call_once;
+static int       (      *volatile p_cnd_broadcast)(cnd_t *) = cnd_broadcast;
+static void      (     *volatile p_cnd_destroy)(cnd_t *) = cnd_destroy;
+static int       (      *volatile p_cnd_init)(cnd_t *) = cnd_init;
+static int       (      *volatile p_cnd_signal)(cnd_t *) = cnd_signal;
+static int       (      *volatile p_cnd_timedwait)(cnd_t       *restrict, mtx_t       *restrict,
+                                        const struct timespec       *restrict)
+    = cnd_timedwait;
+static int  ( *volatile p_cnd_wait)(cnd_t *, mtx_t *) = cnd_wait;
+static void (* volatile p_mtx_destroy)(mtx_t *) = mtx_destroy;
+static int  ( *volatile p_mtx_init)(mtx_t *, int) = mtx_init;
+static int  ( *volatile p_mtx_lock)(mtx_t *) = mtx_lock;
+static int  ( *volatile p_mtx_timedlock)(mtx_t  *restrict, const struct timespec  *restrict)
+    = mtx_timedlock;
+static int    (   *volatile p_mtx_trylock)(mtx_t *) = mtx_trylock;
+static int    (   *volatile p_mtx_unlock)(mtx_t *) = mtx_unlock;
+static int    (   *volatile p_thrd_create)(thrd_t *, thrd_start_t, void *) = thrd_create;
+static thrd_t (* volatile p_thrd_current)(void) = thrd_current;
+static int    (   *volatile p_thrd_detach)(thrd_t) = thrd_detach;
+static int    (   *volatile p_thrd_equal)(thrd_t, thrd_t) = thrd_equal;
+static void   (  *volatile p_thrd_exit)(int) = thrd_exit;
+static int    (   *volatile p_thrd_join)(thrd_t, int *) = thrd_join;
+static int    (   *volatile p_thrd_sleep)(const struct timespec *, struct timespec *) = thrd_sleep;
+static void   (  *volatile p_thrd_yield)(void) = thrd_yield;
+static int    (   *volatile p_tss_create)(tss_t *, tss_dtor_t) = tss_create;
+static void   (  *volatile p_tss_delete)(tss_t) = tss_delete;
+static void  *( *volatile p_tss_get)(tss_t) = tss_get;
+static int    (   *volatile p_tss_set)(tss_t, void *) = tss_set;
+
+static int    once_count;
+
+static void
+once_init(void)
+{
+    once_count++;
+}
+
+static int
+read_per_thread(void *arg)
+{
+    (void)arg;
+    return per_thread;
+}
+
+int
+main(void)
+{
+    thrd_t thr;
+    int    res = -1;
+    long   iterations;
+
+    /* <time.h> functions are declared too */
+    check(timespec_get(&time_spec, TIME_UTC) == TIME_UTC, "timespec_get");
+    check(clock_gettime(clock_value, &time_spec) == 0, "clock_gettime");
+    time_value = time(NULL);
+    check(time_value != (time_t)-1, "time");
+
+    header_checks();
+
+    iterations = sysconf(_SC_THREAD_DESTRUCTOR_ITERATIONS);
+    check(iterations == -1 || iterations >= TSS_DTOR_ITERATIONS,
+          "TSS_DTOR_ITERATIONS within sysconf's value");
+
+    check(p_call_once && p_cnd_broadcast && p_cnd_destroy && p_cnd_init && p_cnd_signal
+              && p_cnd_timedwait && p_cnd_wait && p_mtx_destroy && p_mtx_init && p_mtx_lock
+              && p_mtx_timedlock && p_mtx_trylock && p_mtx_unlock && p_thrd_create && p_thrd_current
+              && p_thrd_detach && p_thrd_equal && p_thrd_exit && p_thrd_join && p_thrd_sleep
+              && p_thrd_yield && p_tss_create && p_tss_delete && p_tss_get && p_tss_set,
+          "functions");
+
+    p_call_once(&once, once_init);
+    p_call_once(&once, once_init);
+    check(once_count == 1, "ONCE_FLAG_INIT");
+
+    /* A thread_local object is per thread */
+    per_thread = 2;
+    check(thrd_create(&thr, read_per_thread, NULL) == thrd_success, "thrd_create");
+    check(thrd_join(thr, &res) == thrd_success && res == 1, "thread_local");
+
+    printf("success\n");
+    return 0;
+}
+
+#else
+
+int
+main(void)
+{
+    header_checks();
+    printf("no system support, skipping\n");
+    return 77;
+}
+
+#endif
diff --git a/test/test-posix/test-threads/test-tss_delete.c b/test/test-posix/test-threads/test-tss_delete.c
new file mode 100644
index 0000000000..fc484024f4
--- /dev/null
+++ b/test/test-posix/test-threads/test-tss_delete.c
@@ -0,0 +1,273 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright © 2026 Keith Packard
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ *
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ *
+ * 2. Redistributions in binary form must reproduce the above
+ *    copyright notice, this list of conditions and the following
+ *    disclaimer in the documentation and/or other materials provided
+ *    with the distribution.
+ *
+ * 3. Neither the name of the copyright holder nor the names of its
+ *    contributors may be used to endorse or promote products derived
+ *    from this software without specific prior written permission.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS
+ * FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE
+ * COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT,
+ * INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES
+ * (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
+ * SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT,
+ * STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED
+ * OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#define _POSIX_C_SOURCE 202405L
+#include <unistd.h>
+
+/* Without the system support this test needs, it is skipped */
+#if !defined(__PICOLIBC__) || (defined(_POSIX_THREADS) && _POSIX_THREADS > 0)
+
+#include <errno.h>
+#include <limits.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <threads.h>
+#include <time.h>
+
+/*
+ * tss_ destructors: how often they run (TSS_DTOR_ITERATIONS), what
+ * tss_get says inside them, tss_delete and tss_set running none, and
+ * none running at process termination. Thread exit also runs
+ * pthread_key_create destructors.
+ */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+static tss_t         key_always, key_twice, key_null, key_nodtor, key_deleted, key_late;
+static pthread_key_t pkey;
+static int           always_calls, twice_calls, null_calls, deleted_calls, pkey_calls;
+static int           bad_value, bad_get;
+static int           value, other;
+static sem_t         created, go;
+
+/* Sets its value again every time, so only the iteration limit stops it */
+static void
+dtor_always(void *p)
+{
+    always_calls++;
+    if (p != &value)
+        bad_value++;
+    if (tss_get(key_always) != NULL)
+        bad_get++;
+    tss_set(key_always, &value);
+}
+
+/* Sets its value again twice, so it runs three times */
+static void
+dtor_twice(void *p)
+{
+    if (p != &other)
+        bad_value++;
+    if (tss_get(key_twice) != NULL)
+        bad_get++;
+    if (++twice_calls < 3)
+        tss_set(key_twice, &other);
+}
+
+static void
+dtor_null(void *p)
+{
+    (void)p;
+    null_calls++;
+}
+
+static void
+dtor_deleted(void *p)
+{
+    (void)p;
+    deleted_calls++;
+}
+
+static void
+dtor_pkey(void *p)
+{
+    if (p == &value)
+        pkey_calls++;
+}
+
+static int
+user(void *arg)
+{
+    (void)arg;
+    if (tss_set(key_always, &value) != thrd_success || tss_set(key_twice, &other) != thrd_success
+        || tss_set(key_nodtor, &value) != thrd_success
+        || tss_set(key_deleted, &value) != thrd_success || pthread_setspecific(pkey, &value) != 0)
+        return 1;
+    /* tss_set doesn't run the destructor on the value it replaces */
+    if (tss_set(key_twice, &value) != thrd_success || tss_set(key_twice, &other) != thrd_success)
+        return 2;
+    /* key_null keeps its null value */
+    if (tss_get(key_null) != NULL)
+        return 3;
+    /* Deleting a key with a value runs no destructor, then or at exit */
+    tss_delete(key_deleted);
+    thrd_exit(0);
+}
+
+/* Started before key_late exists */
+static int
+early(void *arg)
+{
+    (void)arg;
+    sem_post(&created);
+    while (sem_wait(&go) != 0)
+        ;
+    return tss_get(key_late) == NULL ? 0 : 1;
+}
+
+static tss_t key_self;
+
+static void
+dtor_self(void *p)
+{
+    (void)p;
+    /* tss_delete can be called from a destructor */
+    tss_delete(key_self);
+    deleted_calls += 100;
+}
+
+static int
+self_deleter(void *arg)
+{
+    (void)arg;
+    return tss_set(key_self, &value) == thrd_success ? 0 : 1;
+}
+
+/* In a child: destructors don't run at process termination */
+static int   child_wfd;
+static tss_t key_child;
+
+static void
+dtor_child(void *p)
+{
+    char c = 'D';
+
+    (void)p;
+    if (write(child_wfd, &c, 1) != 1)
+        _exit(3);
+}
+
+static void
+child(int wfd)
+{
+    child_wfd = wfd;
+    if (tss_create(&key_child, dtor_child) != thrd_success
+        || tss_set(key_child, &value) != thrd_success)
+        _exit(2);
+    exit(0);
+}
+
+int
+main(void)
+{
+    thrd_t thr;
+    int    res = -1, fds[2], status;
+    pid_t  pid;
+    char   buf[4];
+
+    alarm(60);
+    check(sem_init(&created, 0, 0) == 0 && sem_init(&go, 0, 0) == 0, "sem_init");
+
+#if TSS_DTOR_ITERATIONS < 4
+#error TSS_DTOR_ITERATIONS is below _POSIX_THREAD_DESTRUCTOR_ITERATIONS
+#endif
+
+    check(tss_create(&key_always, dtor_always) == thrd_success, "tss_create");
+    check(tss_create(&key_twice, dtor_twice) == thrd_success, "tss_create");
+    check(tss_create(&key_null, dtor_null) == thrd_success, "tss_create");
+    check(tss_create(&key_nodtor, NULL) == thrd_success, "tss_create");
+    check(tss_create(&key_deleted, dtor_deleted) == thrd_success, "tss_create");
+    check(pthread_key_create(&pkey, dtor_pkey) == 0, "pthread_key_create");
+    check(key_always != key_twice && key_twice != key_null && key_null != key_nodtor,
+          "distinct keys");
+
+    check(thrd_create(&thr, user, NULL) == thrd_success, "thrd_create");
+    check(thrd_join(thr, &res) == thrd_success && res == 0, "user");
+    printf("TSS_DTOR_ITERATIONS %d, destructor that always sets a value ran %d times\n",
+           TSS_DTOR_ITERATIONS, always_calls);
+    check(always_calls >= TSS_DTOR_ITERATIONS && always_calls <= TSS_DTOR_ITERATIONS + 1,
+          "destructor rounds stop at TSS_DTOR_ITERATIONS");
+    check(twice_calls == 3, "destructor rounds repeat while values remain");
+    check(bad_value == 0, "destructors get the previous value");
+    check(bad_get == 0, "tss_get is null in the key's destructor");
+    check(null_calls == 0, "no destructor call for null values");
+    check(deleted_calls == 0, "tss_delete runs no destructor");
+    check(pkey_calls == 1, "thrd_exit runs pthread_key_create destructors");
+
+    /* tss_delete called from a destructor */
+    check(tss_create(&key_self, dtor_self) == thrd_success, "tss_create");
+    check(thrd_create(&thr, self_deleter, NULL) == thrd_success, "thrd_create");
+    check(thrd_join(thr, &res) == thrd_success && res == 0, "self_deleter");
+    check(deleted_calls == 100, "destructor that deletes its key ran once");
+
+    /* A new key is null in threads that already exist */
+    check(thrd_create(&thr, early, NULL) == thrd_success, "thrd_create");
+    check(sem_wait(&created) == 0, "sem_wait");
+    check(tss_create(&key_late, dtor_null) == thrd_success, "tss_create");
+    check(tss_set(key_late, &value) == thrd_success, "tss_set");
+    check(sem_post(&go) == 0, "sem_post");
+    check(thrd_join(thr, &res) == thrd_success && res == 0, "new key null in existing thread");
+    check(tss_get(key_late) == &value, "main's value");
+
+    /* Destructors don't run at process termination */
+    check(pipe(fds) == 0, "pipe");
+    pid = fork();
+    check(pid >= 0, "fork");
+    if (pid == 0) {
+        close(fds[0]);
+        child(fds[1]);
+    }
+    close(fds[1]);
+    check(read(fds[0], buf, sizeof(buf)) == 0, "no destructor output");
+    check(waitpid(pid, &status, 0) == pid, "waitpid");
+    check(WIFEXITED(status) && WEXITSTATUS(status) == 0, "child exit status");
+    check(null_calls == 0, "no destructor in the parent");
+
+    printf("success\n");
+    return 0;
+}
