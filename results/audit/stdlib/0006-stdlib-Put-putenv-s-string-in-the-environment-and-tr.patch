From 8136d5aca17ca4462d52104aa826d45de3e36aac Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 06:41:24 +0000
Subject: [PATCH 06/24] stdlib: Put putenv's string in the environment, and
 track setenv's storage

POSIX: putenv's string becomes part of the environment, so changing it
changes the environment; putenv copied it into setenv. A string
without '=' now fails with EINVAL rather than returning 1.

setenv freed the old environ array whenever it had allocated one
before, even after the application had assigned its own array to
environ, and crashed when environ was null. It also overwrote the
existing value in place, which would write into putenv's (or the
initial environment's) strings. Keep track of the array and the
entries setenv allocated: only those are reused or freed, by setenv,
putenv and unsetenv.
---
 libc/stdlib/_findenv.c |  22 ++--
 libc/stdlib/local.h    |  10 +-
 libc/stdlib/putenv.c   |  29 +++--
 libc/stdlib/setenv.c   | 244 ++++++++++++++++++++++++++++-------------
 libc/stdlib/unsetenv.c |  24 +++-
 5 files changed, 220 insertions(+), 109 deletions(-)

diff --git a/libc/stdlib/_findenv.c b/libc/stdlib/_findenv.c
index f37ea0cf99..7c4009118c 100644
--- a/libc/stdlib/_findenv.c
+++ b/libc/stdlib/_findenv.c
@@ -69,19 +69,12 @@ permit '=' to be in identifiers.
 
 uint32_t __environ_sequence; /* incremented each time env changes */
 
-/* libc lock must be held on entry */
+/* libc lock must be held on entry; name is name_len bytes long */
 char *
-__findenv(const char *name, size_t *offset)
+__findenv_n(const char *name, size_t name_len, size_t *offset)
 {
     char **env;
     char  *entry;
-    size_t name_len;
-
-    /* Identifiers may not contain an '=', so cannot match if does */
-    if (strchr(name, '='))
-        return NULL;
-
-    name_len = strlen(name);
 
     if (!environ)
         return NULL;
@@ -94,3 +87,14 @@ __findenv(const char *name, size_t *offset)
     }
     return NULL;
 }
+
+/* libc lock must be held on entry */
+char *
+__findenv(const char *name, size_t *offset)
+{
+    /* Identifiers may not contain an '=', so cannot match if does */
+    if (strchr(name, '='))
+        return NULL;
+
+    return __findenv_n(name, strlen(name), offset);
+}
diff --git a/libc/stdlib/local.h b/libc/stdlib/local.h
index a6895e897c..b4ca61cd01 100644
--- a/libc/stdlib/local.h
+++ b/libc/stdlib/local.h
@@ -10,11 +10,15 @@ All rights reserved.
 #include <stdint.h>
 #include <stddef.h>
 
-char           *_gcvt(double, int, char *, char, int);
+char         *_gcvt(double, int, char *, char, int);
 
-extern char   **environ;
+extern char **environ;
 
-char           *__findenv(const char *name, size_t *offset);
+char         *__findenv(const char *name, size_t *offset);
+char         *__findenv_n(const char *name, size_t name_len, size_t *offset);
+int           __env_put(const char *name, size_t l_name, char *entry, _Bool owned, _Bool overwrite,
+                        _Bool *used);
+_Bool         __env_disown(const char *entry);
 
 extern uint32_t __environ_sequence;
 
diff --git a/libc/stdlib/putenv.c b/libc/stdlib/putenv.c
index b7536cc911..3a28bd7dc6 100644
--- a/libc/stdlib/putenv.c
+++ b/libc/stdlib/putenv.c
@@ -19,26 +19,25 @@
 #define _DEFAULT_SOURCE
 #include <stdlib.h>
 #include <string.h>
+#include <errno.h>
+#include <stdbool.h>
+#include "local.h"
 
+/*
+ * POSIX: the string itself becomes part of the environment, so
+ * changing it later changes the environment. A string without '='
+ * (or with an empty name) is rejected with EINVAL.
+ */
 int
 putenv(char *str)
 {
-    register char *p, *equal;
-    int            rval;
-
-    p = strdup(str);
+    char *equal;
+    bool  used;
 
-    if (!p)
-        return 1;
-
-    if (!(equal = strchr(p, '='))) {
-        (void)free(p);
-        return 1;
+    if (str == NULL || (equal = strchr(str, '=')) == NULL || equal == str) {
+        errno = EINVAL;
+        return -1;
     }
 
-    *equal = '\0';
-    rval = setenv(p, equal + 1, 1);
-    (void)free(p);
-
-    return rval;
+    return __env_put(str, (size_t)(equal - str), str, false, true, &used);
 }
diff --git a/libc/stdlib/setenv.c b/libc/stdlib/setenv.c
index 1ac169254e..a376dfec39 100644
--- a/libc/stdlib/setenv.c
+++ b/libc/stdlib/setenv.c
@@ -26,122 +26,214 @@
 #include <sys/lock.h>
 #include "local.h"
 
+extern char **environ;
+
 /*
- * setenv --
- *	Set the value of the environmental variable "name" to be
- *	"value".  If rewrite is set, replace any current value.
+ * The environ array allocated here, if environ still points at it,
+ * and the entries setenv allocated, so that they can be reused or
+ * freed when replaced. Everything else, the initial environment, the
+ * strings given to putenv and any array the application assigned to
+ * environ, belongs to someone else and is left alone.
  */
+static char **env_array;
+static char **env_owned;
+static size_t env_owned_len, env_owned_size;
 
-extern char **environ;
-static bool   setenv_alloced; /* if allocated space before */
-
-int
-setenv(const char *name, const char *value, int rewrite)
+/* Whether setenv allocated entry; the caller holds the lock */
+static bool
+__env_owned(const char *entry)
 {
-    size_t   offset;
-    char    *cur_entry;
-    char   **new_environ;
-    char   **old_environ = NULL;
-    char    *new_entry;
-    uint32_t old_sequence;
-    size_t   l_value, l_name;
+    size_t i;
 
-    /* Name cannot be NULL, empty, or contain an equal sign.  */
-    if (name == NULL || name[0] == '\0' || strchr(name, '=')) {
-        errno = EINVAL;
-        return -1;
-    }
+    for (i = 0; i < env_owned_len; i++)
+        if (env_owned[i] == entry)
+            return true;
+    return false;
+}
 
-    l_value = strlen(value);
+/*
+ * Forget an entry setenv allocated, returning whether it was one;
+ * the caller holds the lock and frees it after releasing the lock.
+ */
+bool
+__env_disown(const char *entry)
+{
+    size_t i;
 
-    /*
-     * Loop until we manage to perform all operations without being
-     * interrupted by another thread
-     */
+    for (i = 0; i < env_owned_len; i++)
+        if (env_owned[i] == entry) {
+            env_owned[i] = env_owned[--env_owned_len];
+            return true;
+        }
+    return false;
+}
+
+/*
+ * Make entry, "name=value" with a name of l_name bytes, the
+ * environment's definition of the name, replacing an existing one
+ * when overwrite is set. 'owned' says that setenv allocated entry.
+ * *used says whether entry went in. Allocation happens without the
+ * lock (malloc and free take it), so the work starts over if the
+ * environment changes meanwhile.
+ */
+int
+__env_put(const char *name, size_t l_name, char *entry, bool owned, bool overwrite, bool *used)
+{
+    char **new_environ;
+    char **new_owned;
+    size_t new_owned_size;
+    size_t offset = 0;
+    size_t n_environ = 0;
+    char  *old_entry = NULL;
+    char **old_environ = NULL;
+    char **old_owned = NULL;
+
+    *used = false;
     for (;;) {
+        uint32_t old_sequence;
+        bool     found;
+        bool     need_owned;
 
         new_environ = NULL;
-        new_entry = NULL;
+        new_owned = NULL;
+        new_owned_size = 0;
 
         __LIBC_LOCK();
-
-        /* Record current sequence value */
         old_sequence = __environ_sequence;
-
-        if ((cur_entry = __findenv(name, &offset))) { /* find if already exists */
-            if (!rewrite) {
-                __LIBC_UNLOCK();
-                return 0;
-            }
-            if (strlen(cur_entry) >= l_value) { /* old larger; copy over */
-                strcpy(cur_entry, value);
-                __LIBC_UNLOCK();
-                return 0;
-            }
-        } else { /* create new slot */
-            size_t n_environ = 0;
-            char **env;
-
-            for (env = environ; *env; ++env)
-                n_environ++;
-
+        found = __findenv_n(name, l_name, &offset) != NULL;
+        if (found && !overwrite) {
             __LIBC_UNLOCK();
+            return 0;
+        }
+        need_owned = owned && env_owned_len == env_owned_size;
+        if (found && !need_owned)
+            break;
 
-            new_environ = calloc(n_environ + 2, sizeof(char *));
-            if (!new_environ)
-                return -1;
-
-            __LIBC_LOCK();
-            if (__environ_sequence != old_sequence)
-                goto retry;
+        if (!found) {
+            char **env;
 
-            memcpy(new_environ, environ, n_environ * sizeof(char *));
-            new_environ[n_environ + 1] = NULL;
-            offset = n_environ;
+            n_environ = 0;
+            if (environ)
+                for (env = environ; *env; ++env)
+                    n_environ++;
         }
-
+        if (need_owned)
+            new_owned_size = env_owned_size ? env_owned_size * 2 : 8;
         __LIBC_UNLOCK();
 
-        l_name = strlen(name);
-
-        new_entry = malloc(l_name + 1 + l_value + 1);
-
-        if (!new_entry) {
+        if (!found)
+            new_environ = malloc((n_environ + 2) * sizeof(char *));
+        if (need_owned)
+            new_owned = malloc(new_owned_size * sizeof(char *));
+        if ((!found && !new_environ) || (need_owned && !new_owned)) {
             free(new_environ);
+            free(new_owned);
+            errno = ENOMEM;
             return -1;
         }
 
-        char *eq = stpcpy(new_entry, name);
-        *eq++ = '=';
-        strcpy(eq, value);
-
         __LIBC_LOCK();
-
         if (__environ_sequence == old_sequence)
             break;
-
-    retry:
         __LIBC_UNLOCK();
         free(new_environ);
-        free(new_entry);
+        free(new_owned);
     }
 
-    /* note change in environment */
+    /* Holding the lock, with nothing changed since the search */
     __environ_sequence++;
 
+    if (new_owned) {
+        if (env_owned_len)
+            memcpy(new_owned, env_owned, env_owned_len * sizeof(char *));
+        old_owned = env_owned;
+        env_owned = new_owned;
+        env_owned_size = new_owned_size;
+    }
+
     if (new_environ) {
-        if (setenv_alloced)
+        if (n_environ)
+            memcpy(new_environ, environ, n_environ * sizeof(char *));
+        new_environ[n_environ] = entry;
+        new_environ[n_environ + 1] = NULL;
+        if (env_array && environ == env_array)
             old_environ = environ;
-        environ = new_environ;
-        setenv_alloced = true;
+        environ = env_array = new_environ;
+    } else {
+        old_entry = environ[offset];
+        environ[offset] = entry;
+        if (!__env_disown(old_entry))
+            old_entry = NULL;
     }
 
-    environ[offset] = new_entry;
+    if (owned)
+        env_owned[env_owned_len++] = entry;
 
     __LIBC_UNLOCK();
 
-    /* free takes the lock too, so release the old array afterwards */
+    /* free takes the lock too, so release the old storage afterwards */
     free(old_environ);
+    free(old_owned);
+    free(old_entry);
+
+    *used = true;
+    return 0;
+}
+
+/*
+ * setenv --
+ *	Set the value of the environmental variable "name" to be
+ *	"value".  If rewrite is set, replace any current value.
+ */
+
+int
+setenv(const char *name, const char *value, int rewrite)
+{
+    char  *cur_entry;
+    char  *new_entry;
+    size_t offset;
+    size_t l_value, l_name;
+    bool   used;
+
+    /* Name cannot be NULL, empty, or contain an equal sign.  */
+    if (name == NULL || name[0] == '\0' || strchr(name, '=')) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    l_name = strlen(name);
+    l_value = strlen(value);
+
+    /* An existing entry that setenv allocated may have room for the value */
+    __LIBC_LOCK();
+    cur_entry = __findenv(name, &offset);
+    if (cur_entry) {
+        if (!rewrite) {
+            __LIBC_UNLOCK();
+            return 0;
+        }
+        if (__env_owned(environ[offset]) && strlen(cur_entry) >= l_value) {
+            strcpy(cur_entry, value);
+            __environ_sequence++;
+            __LIBC_UNLOCK();
+            return 0;
+        }
+    }
+    __LIBC_UNLOCK();
+
+    new_entry = malloc(l_name + 1 + l_value + 1);
+    if (!new_entry)
+        return -1;
 
+    char *eq = stpcpy(new_entry, name);
+    *eq++ = '=';
+    strcpy(eq, value);
+
+    if (__env_put(name, l_name, new_entry, true, rewrite != 0, &used) < 0) {
+        free(new_entry);
+        return -1;
+    }
+    if (!used)
+        free(new_entry);
     return 0;
 }
diff --git a/libc/stdlib/unsetenv.c b/libc/stdlib/unsetenv.c
index aca028afb5..c4643952e1 100644
