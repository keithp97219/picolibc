diff --git a/test/test-posix/test-stdlib/test-a64l.c b/test/test-posix/test-stdlib/test-a64l.c
new file mode 100644
index 0000000000..ec69893623
--- /dev/null
+++ b/test/test-posix/test-stdlib/test-a64l.c
@@ -0,0 +1,120 @@
+/*
