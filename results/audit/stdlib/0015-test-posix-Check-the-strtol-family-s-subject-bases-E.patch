diff --git a/test/test-posix/test-stdlib/test-strtol.c b/test/test-posix/test-stdlib/test-strtol.c
new file mode 100644
index 0000000000..c4975d1965
--- /dev/null
+++ b/test/test-posix/test-stdlib/test-strtol.c
@@ -0,0 +1,139 @@
