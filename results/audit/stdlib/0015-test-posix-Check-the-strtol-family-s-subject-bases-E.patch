 test/test-posix/test-stdlib/meson.build    |   1 +
 test/test-posix/test-stdlib/test-strtol.c  | 139 +++++++++++++++++++++
 3 files changed, 141 insertions(+)
 create mode 100644 test/test-posix/test-stdlib/test-strtol.c

