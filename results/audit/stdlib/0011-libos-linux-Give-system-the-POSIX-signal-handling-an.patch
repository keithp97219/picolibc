From fffda323637c7ea7fc5b62bf118f5c1f19038d78 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 06:41:48 +0000
Subject: [PATCH 11/24] libos/linux: Give system the POSIX signal handling, --
 and waiting

POSIX: system shall ignore SIGINT and SIGQUIT, and block SIGCHLD,
while waiting for the command, and the child runs the shell with the
caller's dispositions and mask. The shell is run as
execl(<shell>, "sh", "-c", "--", command, NULL), so a command
starting with '-' isn't taken as an option, and a null command always
gets non-zero. The generic version did none of that, and returned an
uninitialized status when a signal interrupted waitpid.
---
 libos/linux/meson.build |   1 +
 libos/linux/system.c    | 110 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 111 insertions(+)
 create mode 100644 libos/linux/system.c

diff --git a/libos/linux/meson.build b/libos/linux/meson.build
index 2893a1cce8..fc49cadd3c 100644
--- a/libos/linux/meson.build
+++ b/libos/linux/meson.build
@@ -271,6 +271,7 @@ if fs.is_dir(machine_dir)
     'symlink.c',
     'symlinkat.c',
     'sync.c',
+    'system.c',
     '_syscall.c',
     '_syscall_errno.c',
     'sysconf.c',
diff --git a/libos/linux/system.c b/libos/linux/system.c
new file mode 100644
index 0000000000..7114f2d6b9
--- /dev/null
+++ b/libos/linux/system.c
@@ -0,0 +1,110 @@
