+#define _POSIX_C_SOURCE 202405L
+#include <errno.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/wait.h>
+
+extern char **environ;
+
+/*
+ * As POSIX describes: fork, then execl(<shell>, "sh", "-c", "--",
+ * command, NULL). SIGINT and SIGQUIT are ignored and SIGCHLD blocked
+ * while waiting; the child gets the caller's dispositions and mask
+ * back before running the shell.
+ */
+int
+system(const char *command)
+{
+    struct sigaction ign = { .sa_handler = SIG_IGN };
+    struct sigaction old_int, old_quit;
+    sigset_t         chld, old_mask;
+    char            *argv[5];
+    pid_t            pid;
+    int              status;
+    int              err = 0;
+
+    /* There is always a shell */
+    if (command == NULL)
+        return 1;
+
+    sigemptyset(&ign.sa_mask);
+    sigemptyset(&chld);
+    sigaddset(&chld, SIGCHLD);
+
+    (void)sigprocmask(SIG_BLOCK, &chld, &old_mask);
+    (void)sigaction(SIGINT, &ign, &old_int);
+    (void)sigaction(SIGQUIT, &ign, &old_quit);
+
+    argv[0] = "sh";
+    argv[1] = "-c";
+    argv[2] = "--";
+    argv[3] = (char *)command;
+    argv[4] = NULL;
+
+    pid = fork();
+    if (pid == 0) {
+        (void)sigaction(SIGINT, &old_int, NULL);
+        (void)sigaction(SIGQUIT, &old_quit, NULL);
+        (void)sigprocmask(SIG_SETMASK, &old_mask, NULL);
+        execve("/bin/sh", argv, environ);
+        _exit(127);
+    }
+
+    if (pid < 0) {
+        err = errno;
+        status = -1;
+    } else {
+        /* Other signals may interrupt the wait; it ends with the child */
+        while (waitpid(pid, &status, 0) < 0) {
+            if (errno != EINTR) {
+                err = errno;
+                status = -1;
+                break;
+            }
+        }
+    }
+
+    (void)sigaction(SIGINT, &old_int, NULL);
+    (void)sigaction(SIGQUIT, &old_quit, NULL);
+    (void)sigprocmask(SIG_SETMASK, &old_mask, NULL);
+
+    if (status == -1)
+        errno = err;
+    return status;
+}
