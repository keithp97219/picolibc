From 7f1b31d30675f597947449b9e59f5c4184a12077 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 06:41:24 +0000
Subject: [PATCH 07/24] stdlib: Give rand its own sequence, and make random the
 shared BSD generator

rand called random and srand called srandom, so srandom, initstate,
setstate and mkstemp (which calls random) moved rand's sequence. POSIX:
the implementation shall behave as if no function calls rand or srand.
rand now keeps its own state, with the same sequence as before.

random, srandom, initstate and setstate must be thread-safe, but
random's default state was per thread (srandom in one thread didn't
seed the others) while initstate's array was shared without a lock.
They also used one 64-bit linear congruential generator whatever the
state size, where POSIX describes a non-linear additive feedback
generator whose period grows with the state (more than 2^69 with 256
bytes). Use the BSD generator, with all four functions sharing one
state under the libc lock.
---
 libc/stdlib/initstate.c |  30 +++++--
 libc/stdlib/local.h     |   6 +-
 libc/stdlib/rand.c      |  14 +++-
 libc/stdlib/random.c    | 168 ++++++++++++++++++++++++++++++++++------
 libc/stdlib/setstate.c  |  16 +++-
 libc/stdlib/srand.c     |   3 +-
 libc/stdlib/srandom.c   |  12 ++-
 7 files changed, 205 insertions(+), 44 deletions(-)

diff --git a/libc/stdlib/initstate.c b/libc/stdlib/initstate.c
index 6f609fc40d..7be1c3fd87 100644
--- a/libc/stdlib/initstate.c
+++ b/libc/stdlib/initstate.c
@@ -36,26 +36,40 @@
 #define _DEFAULT_SOURCE
 #include <stdlib.h>
 #include <errno.h>
-#include <string.h>
+#include <sys/lock.h>
 #include "local.h"
 
-/* Stands for the built-in state when initstate or setstate returns it */
-char __random_builtin[8];
-
 /*
- * random keeps 64 bits of state, so any array of at least 8 bytes
- * holds all of it.
+ * The size picks the generator: 8 to 31 bytes give the linear
+ * congruential one, and 32, 64, 128 and 256 bytes (sizes in between
+ * round down) additive feedback generators of 7, 15, 31 and 63 words.
  */
 char *
 initstate(unsigned seed, char *state, size_t size)
 {
-    char *prev = __random_state ? __random_state : __random_builtin;
+    char *prev;
+    int   type;
 
     if (size < 8) {
         errno = EINVAL;
         return NULL;
     }
+    if (size < 32)
+        type = 0;
+    else if (size < 64)
+        type = 1;
+    else if (size < 128)
+        type = 2;
+    else if (size < 256)
+        type = 3;
+    else
+        type = 4;
+
+    __LIBC_LOCK();
+    __random_init();
+    prev = __random_state;
+    __random_seed(state, type, seed);
     __random_state = state;
-    srandom(seed);
+    __LIBC_UNLOCK();
     return prev;
 }
diff --git a/libc/stdlib/local.h b/libc/stdlib/local.h
index b4ca61cd01..4e89191290 100644
--- a/libc/stdlib/local.h
+++ b/libc/stdlib/local.h
@@ -29,8 +29,12 @@ extern uint32_t __environ_sequence;
 #endif
 
 extern __THREAD_LOCAL uint64_t _rand_next;
+
+/* random, srandom, initstate and setstate; these need the libc lock */
 extern char                   *__random_state;
-extern char                    __random_builtin[8];
+int                            __random_type(const char *state);
+void                           __random_seed(char *state, int type, unsigned seed);
+void                           __random_init(void);
 
 #ifdef __AVR__
 typedef unsigned int uwchar_t;
diff --git a/libc/stdlib/rand.c b/libc/stdlib/rand.c
index ca94cf0fdb..58a884a302 100644
--- a/libc/stdlib/rand.c
+++ b/libc/stdlib/rand.c
@@ -59,9 +59,21 @@ on two different systems.
 
 #define _DEFAULT_SOURCE
 #include <stdlib.h>
+#include "local.h"
+
+/*
+ * rand keeps a sequence of its own: POSIX says implementations behave
+ * as if no other function calls rand() or srand(), so random() and
+ * srandom() mustn't move it.
+ */
+__THREAD_LOCAL uint64_t _rand_next = 1;
 
 int
 rand(void)
 {
-    return (int)(random() & RAND_MAX);
+    /* This multiplier was obtained from Knuth, D.E., "The Art of
+       Computer Programming," Vol 2, Seminumerical Algorithms, Third
+       Edition, Addison-Wesley, 1998, p. 106 (line 26) & p. 108 */
+    _rand_next = _rand_next * 6364136223846793005ULL + 1;
+    return (int)((_rand_next >> 32) & RAND_MAX);
 }
diff --git a/libc/stdlib/random.c b/libc/stdlib/random.c
index 809e5f0008..5d3465664f 100644
--- a/libc/stdlib/random.c
+++ b/libc/stdlib/random.c
@@ -24,12 +24,11 @@ The algorithm depends on a static variable called the ``random seed'';
 starting with a given value of the random seed always produces the
 same sequence of numbers in successive calls to <<random>>.
 
-You can set the random seed using <<srandom>>; it does nothing beyond
-storing its argument in the static variable used by <<rand>>.  You can
+You can set the random seed using <<srandom>>.  You can
 exploit this to make the pseudo-random sequence less predictable, if
 you wish, by using some other unpredictable value (often the least
 significant parts of a time-varying value) as the random seed before
-beginning a sequence of calls to <<rand>>; or, if you wish to ensure
+beginning a sequence of calls to <<random>>; or, if you wish to ensure
 (for example, while debugging) that successive runs of your program
 use the same ``random'' numbers, you can use <<srandom>> to set the same
 random seed at the outset.
@@ -41,13 +40,13 @@ number between <<0>> and <<2**31 - 1>> (inclusive).
 <<srandom>> does not return a result.
 
 NOTES
-<<random>> and <<srandom>> are unsafe for multi-threaded applications.
+<<random>> and <<srandom>> share one state, protected by a lock.
 
 _XOPEN_SOURCE may be any value >= 500.
 
 PORTABILITY
-<<random>> is required by XSI. This implementation uses the same
-algorithm as <<rand>>.
+<<random>> is required by XSI. This implementation uses the additive
+feedback generator from BSD, with a sequence independent of <<rand>>.
 
 <<random>> requires no supporting OS subroutines.
 */
@@ -55,30 +54,151 @@ algorithm as <<rand>>.
 #define _DEFAULT_SOURCE
 #include <stdlib.h>
 #include <stdint.h>
+#include <stdbool.h>
 #include <string.h>
+#include <sys/lock.h>
 #include "local.h"
 
-__THREAD_LOCAL uint64_t _rand_next = 1;
+/*
+ * The non-linear additive feedback generator POSIX describes (the BSD
+ * one). A state array holds a header word, MAX_TYPES * rear + type,
+ * and then 'deg' words of state. The front index is always 'sep'
+ * words after the rear one. Each step adds the rear word to the front
+ * one and returns the sum without its lowest bit. Arrays of 8 to 31
+ * bytes use a linear congruential generator instead. The words are
+ * copied in and out, as the application's array may be unaligned.
+ *
+ * All four functions must be thread-safe, so they share one state,
+ * guarded by the libc lock.
+ */
+
+#define MAX_TYPES 5
+
+static const struct {
+    uint8_t deg, sep;
+} __random_types[MAX_TYPES] = {
+    { 0,  0 },
+    { 7,  3 },
+    { 15, 1 },
+    { 31, 3 },
+    { 63, 1 },
+};
+
+/* The default: as if initstate(1, state, 128) had been called */
+#define RANDOM_DEFAULT_TYPE 3
+static uint32_t __random_builtin[1 + 31] = { RANDOM_DEFAULT_TYPE };
+static bool     __random_builtin_seeded;
+char           *__random_state = (char *)__random_builtin;
+
+static uint32_t
+__random_get(const char *state, unsigned i)
+{
+    uint32_t v;
+
+    memcpy(&v, state + i * sizeof(v), sizeof(v));
+    return v;
+}
+
+static void
+__random_put(char *state, unsigned i, uint32_t v)
+{
+    memcpy(state + i * sizeof(v), &v, sizeof(v));
+}
+
+/* Check the header of a state array; returns the type or -1 */
+int
+__random_type(const char *state)
+{
+    uint32_t header = __random_get(state, 0);
+    unsigned type = header % MAX_TYPES;
+    unsigned rear = header / MAX_TYPES;
+
+    if (rear >= __random_types[type].deg && rear != 0)
+        return -1;
+    return (int)type;
+}
+
+/* The next value from a state array; the caller holds the lock */
+static long
+__random_step(char *state)
+{
+    uint32_t header = __random_get(state, 0);
+    unsigned type = header % MAX_TYPES;
+    unsigned rear = header / MAX_TYPES;
+    unsigned deg = __random_types[type].deg;
+    unsigned front;
+    uint32_t v;
+
+    if (deg == 0) {
+        v = (__random_get(state, 1) * 1103515245U + 12345U) & 0x7fffffff;
+        __random_put(state, 1, v);
+        return (long)v;
+    }
+
+    front = rear + __random_types[type].sep;
+    if (front >= deg)
+        front -= deg;
+    v = __random_get(state, 1 + front) + __random_get(state, 1 + rear);
+    __random_put(state, 1 + front, v);
+    if (++rear >= deg)
+        rear = 0;
+    __random_put(state, 0, MAX_TYPES * rear + type);
+    return (long)(v >> 1);
+}
+
+/* Seed a state array of the given type; the caller holds the lock */
+void
+__random_seed(char *state, int type, unsigned seed)
+{
+    unsigned deg = __random_types[type].deg;
+    int32_t  word;
+    unsigned i;
+
+    if (state == (char *)__random_builtin)
+        __random_builtin_seeded = true;
+
+    __random_put(state, 0, (uint32_t)type);
+
+    /* Zero would be a fixed point */
+    if (seed == 0)
+        seed = 1;
+    __random_put(state, 1, seed);
+    if (deg == 0)
+        return;
+
+    /* Fill the rest with 16807 * previous % (2^31 - 1), by Schrage's method */
+    word = (int32_t)seed;
+    for (i = 1; i < deg; i++) {
+        int32_t hi = word / 127773;
+        int32_t lo = word % 127773;
+
+        word = 16807 * lo - 2836 * hi;
+        if (word < 0)
+            word += 2147483647;
+        __random_put(state, 1 + i, (uint32_t)word);
+    }
+
+    /* Discard the start of the sequence, where the seed shows through */
+    for (i = 0; i < 10 * deg; i++)
+        (void)__random_step(state);
+}
 
-/* The state array initstate or setstate selected, or NULL for _rand_next */
-char                   *__random_state;
+/* Seed the built-in array on first use; the caller holds the lock */
+void
+__random_init(void)
+{
+    if (!__random_builtin_seeded)
+        __random_seed((char *)__random_builtin, RANDOM_DEFAULT_TYPE, 1);
+}
 
 long int
 random(void)
 {
-    uint64_t next;
-
-    if (__random_state)
-        memcpy(&next, __random_state, sizeof(next));
-    else
-        next = _rand_next;
-    /* This multiplier was obtained from Knuth, D.E., "The Art of
-       Computer Programming," Vol 2, Seminumerical Algorithms, Third
-       Edition, Addison-Wesley, 1998, p. 106 (line 26) & p. 108 */
-    next = next * 6364136223846793005ULL + 1;
-    if (__random_state)
-        memcpy(__random_state, &next, sizeof(next));
-    else
-        _rand_next = next;
-    return (long int)((next >> 32) & 0x7fffffffL);
+    long v;
+
+    __LIBC_LOCK();
+    __random_init();
+    v = __random_step(__random_state);
+    __LIBC_UNLOCK();
+    return v;
 }
diff --git a/libc/stdlib/setstate.c b/libc/stdlib/setstate.c
index e2575ce2e0..8ee82b60ec 100644
--- a/libc/stdlib/setstate.c
+++ b/libc/stdlib/setstate.c
@@ -35,13 +35,25 @@
 
 #define _DEFAULT_SOURCE
 #include <stdlib.h>
+#include <errno.h>
+#include <sys/lock.h>
 #include "local.h"
 
+/* Switch to a state array from initstate, keeping its position */
 char *
 setstate(char *state)
 {
-    char *prev = __random_state ? __random_state : __random_builtin;
+    char *prev;
 
-    __random_state = state == __random_builtin ? NULL : state;
+    __LIBC_LOCK();
+    __random_init();
+    if (__random_type(state) < 0) {
+        __LIBC_UNLOCK();
+        errno = EINVAL;
+        return NULL;
+    }
+    prev = __random_state;
+    __random_state = state;
+    __LIBC_UNLOCK();
     return prev;
 }
diff --git a/libc/stdlib/srand.c b/libc/stdlib/srand.c
index 33d53b4954..c4e252a400 100644
--- a/libc/stdlib/srand.c
+++ b/libc/stdlib/srand.c
@@ -59,9 +59,10 @@ on two different systems.
 
 #define _DEFAULT_SOURCE
 #include <stdlib.h>
+#include "local.h"
 
 void
 srand(unsigned int seed)
 {
-    srandom(seed);
+    _rand_next = seed;
 }
