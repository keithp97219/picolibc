Date: Sat, 21 Nov 2026 06:55:41 +0000
Subject: [PATCH 14/24] test-posix: Check <stdlib.h>'s macros, types,
 prototypes and namespace

---
 test/test-posix/test-stdlib/CMakeLists.txt    |   3 +
 test/test-posix/test-stdlib/meson.build       |   6 +
 .../test-stdlib/test-stdlib_h-iso.c           |  77 +++++++
 .../test-stdlib/test-stdlib_h-names.c         | 132 ++++++++++++
 test/test-posix/test-stdlib/test-stdlib_h.c   | 202 ++++++++++++++++++
 5 files changed, 420 insertions(+)
 create mode 100644 test/test-posix/test-stdlib/test-stdlib_h-iso.c
 create mode 100644 test/test-posix/test-stdlib/test-stdlib_h-names.c
 create mode 100644 test/test-posix/test-stdlib/test-stdlib_h.c

diff --git a/test/test-posix/test-stdlib/CMakeLists.txt b/test/test-posix/test-stdlib/CMakeLists.txt
index ab7930c7d2..eb914ed7f2 100644
--- a/test/test-posix/test-stdlib/CMakeLists.txt
+++ b/test/test-posix/test-stdlib/CMakeLists.txt
@@ -42,6 +42,9 @@ set(tests
   test-ptsname_r
   test-realpath
   test-secure_getenv
+  test-stdlib_h
+  test-stdlib_h-iso
+  test-stdlib_h-names
   test-system
   test-unlockpt
   )
diff --git a/test/test-posix/test-stdlib/meson.build b/test/test-posix/test-stdlib/meson.build
index 7cf67e6c8c..8f9bf516a3 100644
--- a/test/test-posix/test-stdlib/meson.build
+++ b/test/test-posix/test-stdlib/meson.build
@@ -42,6 +42,12 @@ dir_tests = [
   'test-ptsname_r',
   'test-realpath',
   'test-secure_getenv',
+  'test-stdlib_h',
+  'test-stdlib_h-iso',
+  'test-stdlib_h-names',
   'test-system',
   'test-unlockpt',
 ]
