+# glibc's -native build sees _REENTRANT from -pthread, so isn't strict ISO C
+test_skip_native += ['test-stdlib_h-iso']
diff --git a/test/test-posix/test-stdlib/test-stdlib_h-iso.c b/test/test-posix/test-stdlib/test-stdlib_h-iso.c
new file mode 100644
index 0000000000..4f24cf3ccb
--- /dev/null
+++ b/test/test-posix/test-stdlib/test-stdlib_h-iso.c
@@ -0,0 +1,77 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright © 2026 Keith Packard
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
