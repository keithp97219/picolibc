From f74f3c9914294f269d1839af6a4c3cc765bf54e1 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 18:39:07 +0000
Subject: [PATCH 21/21] test-posix: Check the types, constants and address
 macros in netinet/in.h

---
 .../test-posix/test-netinet-in/CMakeLists.txt |   1 +
 test/test-posix/test-netinet-in/meson.build   |   1 +
 .../test-netinet-in/test-netinet_in_h.c       | 244 ++++++++++++++++++
 3 files changed, 246 insertions(+)
 create mode 100644 test/test-posix/test-netinet-in/test-netinet_in_h.c

diff --git a/test/test-posix/test-netinet-in/CMakeLists.txt b/test/test-posix/test-netinet-in/CMakeLists.txt
index 61970de77b..023d91536f 100644
--- a/test/test-posix/test-netinet-in/CMakeLists.txt
+++ b/test/test-posix/test-netinet-in/CMakeLists.txt
@@ -35,6 +35,7 @@
 
 set(tests
   test-in6addr_any
+  test-netinet_in_h
   )
 
 foreach(test IN LISTS tests)
diff --git a/test/test-posix/test-netinet-in/meson.build b/test/test-posix/test-netinet-in/meson.build
index b7d1f1a269..89708e7aa4 100644
--- a/test/test-posix/test-netinet-in/meson.build
+++ b/test/test-posix/test-netinet-in/meson.build
@@ -35,4 +35,5 @@
 
 dir_tests = [
   'test-in6addr_any',
+  'test-netinet_in_h',
 ]
diff --git a/test/test-posix/test-netinet-in/test-netinet_in_h.c b/test/test-posix/test-netinet-in/test-netinet_in_h.c
new file mode 100644
index 0000000000..bb164251ee
--- /dev/null
+++ b/test/test-posix/test-netinet-in/test-netinet_in_h.c
@@ -0,0 +1,244 @@
