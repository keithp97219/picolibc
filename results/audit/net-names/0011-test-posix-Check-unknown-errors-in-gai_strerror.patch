From eeb583b71a9bb900e64134772c5e577469b397d8 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 18:34:54 +0000
Subject: [PATCH 11/21] test-posix: Check unknown errors in gai_strerror

---
 test/test-posix/test-netdb/test-gai_strerror.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/test/test-posix/test-netdb/test-gai_strerror.c b/test/test-posix/test-netdb/test-gai_strerror.c
index a67051c590..0dee462237 100644
--- a/test/test-posix/test-netdb/test-gai_strerror.c
+++ b/test/test-posix/test-netdb/test-gai_strerror.c
@@ -120,6 +120,15 @@ main(void)
         for (j = 0; j < i; j++)
             check(strcmp(s, gai_strerror(errors[j])) != 0, "distinct messages");
     }
+
+    /* Anything else is an unknown error */
+    {
+        const char *s = gai_strerror(12345);
+
+        check(s != NULL && *s, "unknown error");
+        for (i = 0; i < sizeof(errors) / sizeof(errors[0]); i++)
+            check(strcmp(s, gai_strerror(errors[i])) != 0, "unknown error message");
+    }
     (void)make_socket;
     (void)tcp_pair;
     printf("success\n");
-- 
