From c98412914bdb6d1fa55749ab73a2dfb6d9ba2c82 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 18:28:52 +0000
Subject: [PATCH 06/21] libc/netdb: Add the IPv6 scope identifier to numeric
 names in getnameinfo

The sin6_scope_id was dropped. Follow the address with '%' and the
scope: the interface name for link-local addresses, otherwise or with
NI_NUMERICSCOPE the number, as POSIX describes for NI_NUMERICSCOPE and
as glibc does.
---
 libc/posix/netdb/getnameinfo.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/libc/posix/netdb/getnameinfo.c b/libc/posix/netdb/getnameinfo.c
index 5b3451d64f..4dab8e9364 100644
--- a/libc/posix/netdb/getnameinfo.c
+++ b/libc/posix/netdb/getnameinfo.c
@@ -34,6 +34,7 @@
  */
 
 #include "local-netdb.h"
+#include <net/if.h>
 #include <string.h>
 
 #define __GNI_FLAGS                                                                          \
@@ -45,6 +46,7 @@ getnameinfo(const struct sockaddr * __restrict sa, socklen_t salen, char * __res
 {
     const void *addr, *lookup_addr;
     int         family, lookup_family, port;
+    uint32_t    scope = 0;
     char        name[__NETDB_LINE_MAX];
 
     if (flags & ~__GNI_FLAGS)
@@ -62,6 +64,7 @@ getnameinfo(const struct sockaddr * __restrict sa, socklen_t salen, char * __res
 
         addr = &sin6->sin6_addr;
         port = ntohs(sin6->sin6_port);
+        scope = sin6->sin6_scope_id;
     } else {
         return EAI_FAMILY;
     }
@@ -103,6 +106,17 @@ getnameinfo(const struct sockaddr * __restrict sa, socklen_t salen, char * __res
                 return EAI_NONAME;
             if (!inet_ntop(family, addr, name, sizeof(name)))
                 return EAI_SYSTEM;
+            /* The scope follows a '%', as an interface name for link-local addresses */
+            if (scope) {
+                const struct in6_addr *a6 = addr;
+                char                  *end = name + strlen(name);
+
+                *end++ = '%';
+                if ((flags & NI_NUMERICSCOPE)
+                    || !(IN6_IS_ADDR_LINKLOCAL(a6) || IN6_IS_ADDR_MC_LINKLOCAL(a6))
+                    || !if_indextoname(scope, end))
+                    snprintf(end, IF_NAMESIZE, "%lu", (unsigned long)scope);
+            }
         }
         if (strlen(name) >= hostlen)
             return EAI_OVERFLOW;
