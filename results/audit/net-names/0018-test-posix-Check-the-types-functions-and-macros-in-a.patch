+/* What <arpa/inet.h> provides */
+
+#define _POSIX_C_SOURCE 202405L
+#include <arpa/inet.h>
+
+#define same_type(a, T) _Generic((a), T: 1, default: 0)
+
+/* The byte order functions, which may also be macros, and their types */
+static uint32_t u32;
+static uint16_t u16;
+_Static_assert(sizeof(u32) == 4 && sizeof(u16) == 2, "uint32_t and uint16_t");
+_Static_assert(same_type(htonl(u32), uint32_t) && same_type(htons(u16), uint16_t)
+                   && same_type(ntohl(u32), uint32_t) && same_type(ntohs(u16), uint16_t),
+               "byte order results");
+static uint32_t (* const p_htonl)(uint32_t) = (htonl);
+static uint16_t (* const p_htons)(uint16_t) = (htons);
+static uint32_t (* const p_ntohl)(uint32_t) = (ntohl);
+static uint16_t (* const p_ntohs)(uint16_t) = (ntohs);
+
+#include <unistd.h>
+
+/* Without the system support this test needs, it is skipped */
+#if !defined(__PICOLIBC__)                                                       \
+    || (defined(__PICOLIBC_POSIX_NETWORKING) && __PICOLIBC_POSIX_NETWORKING > 0)
+
+/* The types and macros from <netinet/in.h> and <sys/socket.h> */
+static in_port_t      port;
+static in_addr_t      addr;
+static socklen_t      len;
+static struct in_addr in;
+_Static_assert(same_type(port, uint16_t) && same_type(addr, uint32_t) && sizeof(len) > 0
+                   && same_type(in.s_addr, in_addr_t),
+               "in_port_t, in_addr_t, socklen_t and struct in_addr");
+#if INET_ADDRSTRLEN != 16 || INET6_ADDRSTRLEN != 46
+#error INET_ADDRSTRLEN and INET6_ADDRSTRLEN
+#endif
+
+/* The conversion functions */
+static in_addr_t   (  *const p_inet_addr)(const char *) = inet_addr;
+static char       *(      *const p_inet_ntoa)(struct in_addr) = inet_ntoa;
+static const char *(* const p_inet_ntop)(int, const void * restrict, char * restrict, socklen_t)
+    = inet_ntop;
+static int (* const p_inet_pton)(int, const char * restrict, void * restrict) = inet_pton;
+
+#include <stdio.h>
+
+int
+main(void)
+{
+    (void)p_htonl;
+    (void)p_htons;
+    (void)p_ntohl;
+    (void)p_ntohs;
+    (void)port;
+    (void)addr;
+    (void)len;
+    (void)in;
+    (void)p_inet_addr;
+    (void)p_inet_ntoa;
+    (void)p_inet_ntop;
+    (void)p_inet_pton;
+    printf("success\n");
+    return 0;
+}
+
+#else
+
+#include <stdio.h>
+
+int
+main(void)
+{
+    (void)p_htonl;
+    (void)p_htons;
+    (void)p_ntohl;
+    (void)p_ntohs;
+    printf("no system support, skipping\n");
+    return 77;
+}
+
+#endif
