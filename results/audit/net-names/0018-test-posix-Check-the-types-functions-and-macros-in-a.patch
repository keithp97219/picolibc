   'test-inet_pton',
 ]
diff --git a/test/test-posix/test-arpa-inet/test-arpa_inet_h.c b/test/test-posix/test-arpa-inet/test-arpa_inet_h.c
new file mode 100644
index 0000000000..0351c1c14c
--- /dev/null
+++ b/test/test-posix/test-arpa-inet/test-arpa_inet_h.c
@@ -0,0 +1,116 @@
