 test/test-posix/test-arpa-inet/meson.build    |   1 +
 .../test-arpa-inet/test-arpa_inet_h.c         | 116 ++++++++++++++++++
 3 files changed, 118 insertions(+)
 create mode 100644 test/test-posix/test-arpa-inet/test-arpa_inet_h.c

