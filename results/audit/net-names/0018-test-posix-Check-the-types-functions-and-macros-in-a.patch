index 4fcb317150..1f27de9ac5 100644
--- a/test/test-posix/test-arpa-inet/CMakeLists.txt
+++ b/test/test-posix/test-arpa-inet/CMakeLists.txt
@@ -38,6 +38,7 @@ set(tests
   test-inet_addr
   test-inet_ntoa
   test-inet_ntop
+  test-arpa_inet_h
   test-inet_pton
   )
 
diff --git a/test/test-posix/test-arpa-inet/meson.build b/test/test-posix/test-arpa-inet/meson.build
index 1bdd9e9612..edbcd3a938 100644
--- a/test/test-posix/test-arpa-inet/meson.build
+++ b/test/test-posix/test-arpa-inet/meson.build
@@ -38,5 +38,6 @@ dir_tests = [
   'test-inet_addr',
   'test-inet_ntoa',
   'test-inet_ntop',
