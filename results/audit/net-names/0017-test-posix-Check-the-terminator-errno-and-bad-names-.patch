From e90d40ca7cdcc5a9dcb8fee3f64efb10aeba209d Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 18:39:07 +0000
Subject: [PATCH 17/21] test-posix: Check the terminator, errno and bad names
 in if_nameindex

---
 test/test-posix/test-net-if/test-if_nameindex.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/test/test-posix/test-net-if/test-if_nameindex.c b/test/test-posix/test-net-if/test-if_nameindex.c
index 9a133e1029..5cf7d800ef 100644
--- a/test/test-posix/test-net-if/test-if_nameindex.c
+++ b/test/test-posix/test-net-if/test-if_nameindex.c
@@ -119,9 +119,19 @@ main(void)
         check(if_indextoname(i->if_index, name) == name && strcmp(name, i->if_name) == 0,
               "if_indextoname");
     }
+    check(i->if_name == NULL, "terminator");
+
+    /* if_freenameindex leaves errno alone */
+    errno = EDOM;
     if_freenameindex(list);
+    check(errno == EDOM, "if_freenameindex errno");
+
     check(if_nametoindex("no-such-if") == 0, "missing name");
     check(if_indextoname(0x7fffffff, name) == NULL && errno == ENXIO, "missing index");
+    check(if_nametoindex("a-name-much-too-long-for-an-interface") == 0, "long name");
+    check(if_nametoindex("") == 0, "empty name");
+    errno = 0;
+    check(if_indextoname(0, name) == NULL && errno == ENXIO, "index zero");
     (void)make_socket;
     (void)tcp_pair;
     printf("success\n");
-- 
