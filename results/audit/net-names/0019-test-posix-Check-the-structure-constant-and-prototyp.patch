+++ b/test/test-posix/test-net-if/CMakeLists.txt
@@ -35,6 +35,7 @@
 
 set(tests
   test-if_nameindex
+  test-net_if_h
   )
 
 foreach(test IN LISTS tests)
diff --git a/test/test-posix/test-net-if/meson.build b/test/test-posix/test-net-if/meson.build
index 3c8d96de9a..a899f73f83 100644
--- a/test/test-posix/test-net-if/meson.build
+++ b/test/test-posix/test-net-if/meson.build
@@ -35,4 +35,5 @@
 
 dir_tests = [
   'test-if_nameindex',
+  'test-net_if_h',
 ]
