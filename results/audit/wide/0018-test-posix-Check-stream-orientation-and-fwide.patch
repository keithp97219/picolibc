diff --git a/test/test-posix/test-wchar/test-fwide.c b/test/test-posix/test-wchar/test-fwide.c
new file mode 100644
index 0000000000..161ddaf5f5
--- /dev/null
+++ b/test/test-posix/test-wchar/test-fwide.c
@@ -0,0 +1,198 @@
