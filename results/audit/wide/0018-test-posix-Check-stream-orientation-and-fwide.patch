   test-mbrtowc
   test-mbsrtowcs
   test-open_wmemstream
diff --git a/test/test-posix/test-wchar/meson.build b/test/test-posix/test-wchar/meson.build
index 5f0fc294cb..1ea6bafcff 100644
--- a/test/test-posix/test-wchar/meson.build
+++ b/test/test-posix/test-wchar/meson.build
@@ -34,6 +34,7 @@
