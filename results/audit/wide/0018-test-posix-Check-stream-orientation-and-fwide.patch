From e2a2711ed3d2479258d7ed3e0af61c3feadd8b83 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 08:26:23 +0000
Subject: [PATCH 18/22] test-posix: Check stream orientation and fwide

Streams, the standard ones included, start unoriented; byte and wide
functions orient them; fwide changes only an unoriented stream;
freopen removes the orientation, and perror leaves an unoriented
stderr alone. test-freopen now expects no orientation after freopen.
---
 test/test-posix/test-stdio/test-freopen.c |   3 +-
 test/test-posix/test-wchar/CMakeLists.txt |   1 +
 test/test-posix/test-wchar/meson.build    |   1 +
 test/test-posix/test-wchar/test-fwide.c   | 198 ++++++++++++++++++++++
 4 files changed, 201 insertions(+), 2 deletions(-)
 create mode 100644 test/test-posix/test-wchar/test-fwide.c

diff --git a/test/test-posix/test-stdio/test-freopen.c b/test/test-posix/test-stdio/test-freopen.c
index 78e8760f20..8c7b194331 100644
--- a/test/test-posix/test-stdio/test-freopen.c
+++ b/test/test-posix/test-stdio/test-freopen.c
@@ -107,8 +107,7 @@ main(void)
     check(fputs("bee", f) >= 0 && fseek(f, 0, SEEK_SET) == 0 && fgetc(f) == 'b', "update mode");
     check(freopen("b", "r", f) == f && fwide(f, 1) > 0, "make the new stream wide");
     check(freopen("a", "r", f) == f, "freopen a");
-    /* POSIX says 0 (no orientation); picolibc's fwide reports byte orientation instead */
-    check(fwide(f, 0) <= 0, "orientation cleared");
+    check(fwide(f, 0) == 0, "orientation cleared");
     check(fgetc(f) == 'n', "byte input after freopen");
 
     /* 'e' and 'x' as for fopen */
diff --git a/test/test-posix/test-wchar/CMakeLists.txt b/test/test-posix/test-wchar/CMakeLists.txt
index dca2430cae..2f57f1a7b3 100644
--- a/test/test-posix/test-wchar/CMakeLists.txt
+++ b/test/test-posix/test-wchar/CMakeLists.txt
@@ -34,6 +34,7 @@
