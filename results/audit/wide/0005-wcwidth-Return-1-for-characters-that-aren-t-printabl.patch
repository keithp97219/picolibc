From 5271b8f4c702dc3a0f38820872eea2b845ff3034 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 07:53:32 +0000
Subject: [PATCH 05/22] wcwidth: Return -1 for characters that aren't printable
 in the locale

POSIX: wcwidth returns -1 if wc "does not correspond to a printable
wide-character code", and wcswidth then returns -1. Without
__MB_CAPABLE, control characters gave 0; with it, characters from
0xa0 up had widths in the C locale, where nothing outside ASCII is
printable.
---
 libc/string/wcwidth.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/libc/string/wcwidth.c b/libc/string/wcwidth.c
index ac2575bbe2..66b7f37756 100644
--- a/libc/string/wcwidth.c
+++ b/libc/string/wcwidth.c
@@ -93,7 +93,7 @@ PORTABILITY
 #include <wchar.h>
 #include <stdint.h>
 #ifndef __MB_CAPABLE
-#include <wctype.h> /* iswprint, iswcntrl */
+#include <wctype.h> /* iswprint */
 #endif
 #include "local.h"
 
@@ -193,6 +193,10 @@ __wcwidth(const wint_t _ucs)
     if (ucs < 0xa0)
         return -1;
 
+    /* The C locale has no printable characters outside ASCII */
+    if (__locale_is_C(0))
+        return -1;
+
     /* Test for surrogate pair values. */
     if (ucs >= (uint32_t)0xd800 && ucs <= (uint32_t)0xdfff)
         return -1;
@@ -216,10 +220,10 @@ __wcwidth(const wint_t _ucs)
     else
         return 1;
 #else  /* !__MB_CAPABLE */
+    if (ucs == L'\0')
+        return 0;
     if (iswprint(ucs))
         return 1;
-    if (iswcntrl(ucs) || ucs == L'\0')
-        return 0;
     return -1;
 #endif /* __MB_CAPABLE */
 }
