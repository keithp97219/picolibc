 libc/stdio/fgetc.c       |  1 +
 libc/stdio/fgetwc.c      |  2 +-
 libc/stdio/fputc.c       |  1 +
 libc/stdio/fputs.c       |  1 +
 libc/stdio/fputwc.c      |  2 +-
 libc/stdio/fread.c       |  1 +
 libc/stdio/freopen.c     |  2 +-
 libc/stdio/fwide.c       | 16 +++++++++++++---
 libc/stdio/fwrite.c      |  1 +
 libc/stdio/local-stdio.h | 19 +++++++++++++++++++
 libc/stdio/perror.c      |  7 ++++++-
 libc/stdio/puts.c        |  1 +
 libc/stdio/ungetc.c      |  2 ++
 libc/stdio/ungetwc.c     |  2 ++
 libc/stdio/vfprintf.c    |  6 ++++++
 libc/stdio/vfscanf.c     |  6 ++++++
 17 files changed, 64 insertions(+), 7 deletions(-)

diff --git a/libc/include/stdio.h b/libc/include/stdio.h
index 806aa33c4b..e33638b8bb 100644
--- a/libc/include/stdio.h
+++ b/libc/include/stdio.h
@@ -99,6 +99,7 @@ struct __file {
 #define __SEXT   0x0020                /* struct is __file_ext */
 #define __SBUF   0x0040                /* struct is __file_bufio */
 #define __SWIDE  0x0080                /* wide-oriented */
+#define __SBYTE  0x0100                /* byte-oriented */
 #define __SWCHAR 0x0200                /* get and put move the bytes of wchar_t values */
     int (*put)(char, struct __file *); /* function to write one char to device */
     int (*get)(struct __file *);       /* function to read one char from device */
diff --git a/libc/stdio/fgetc.c b/libc/stdio/fgetc.c
index a6b4b6b477..4f0725bb4f 100644
--- a/libc/stdio/fgetc.c
+++ b/libc/stdio/fgetc.c
@@ -40,6 +40,7 @@ __STDIO_UNLOCKED(getc)(FILE *stream)
     int        rv;
     __ungetc_t unget;
 
+    __stdio_orient_byte(stream);
     if ((stream->flags & __SRD) == 0) {
         __stdio_bad_dir(stream);
         return EOF;
diff --git a/libc/stdio/fgetwc.c b/libc/stdio/fgetwc.c
index bce0a4e0e2..ca63e1e881 100644
--- a/libc/stdio/fgetwc.c
+++ b/libc/stdio/fgetwc.c
@@ -44,7 +44,7 @@ __STDIO_UNLOCKED(getwc)(FILE *stream)
     __ungetc_t unget;
     mbstate_t  ps;
 
-    stream->flags |= __SWIDE;
+    __stdio_orient_wide(stream);
 
     if ((stream->flags & __SRD) == 0) {
         __stdio_bad_dir(stream);
diff --git a/libc/stdio/fputc.c b/libc/stdio/fputc.c
index 8367377390..4b5c4fab1a 100644
--- a/libc/stdio/fputc.c
+++ b/libc/stdio/fputc.c
@@ -37,6 +37,7 @@
 int
 __STDIO_UNLOCKED(putc)(int c, FILE *stream)
 {
+    __stdio_orient_byte(stream);
     if ((stream->flags & __SWR) == 0) {
         __stdio_bad_dir(stream);
         return EOF;
diff --git a/libc/stdio/fputs.c b/libc/stdio/fputs.c
index 241e786135..9f4020f85b 100644
--- a/libc/stdio/fputs.c
+++ b/libc/stdio/fputs.c
@@ -39,6 +39,7 @@ fputs(const char *str, FILE *stream)
     int  ret = EOF;
 
     __flockfile(stream);
+    __stdio_orient_byte(stream);
     if ((stream->flags & __SWR) == 0) {
         __stdio_bad_dir(stream);
         goto fail;
diff --git a/libc/stdio/fputwc.c b/libc/stdio/fputwc.c
index a49b709bcb..a032ba0c18 100644
--- a/libc/stdio/fputwc.c
+++ b/libc/stdio/fputwc.c
@@ -43,7 +43,7 @@ __STDIO_UNLOCKED(putwc)(wchar_t c, FILE *stream)
     char  *out = mb;
     size_t len, i;
 
-    stream->flags |= __SWIDE;
+    __stdio_orient_wide(stream);
 
     if ((stream->flags & __SWR) == 0) {
         __stdio_bad_dir(stream);
diff --git a/libc/stdio/fread.c b/libc/stdio/fread.c
index 3b208f0484..8afe560ecc 100644
--- a/libc/stdio/fread.c
+++ b/libc/stdio/fread.c
@@ -49,6 +49,7 @@ fread(void *ptr, size_t size, size_t nmemb, FILE *stream)
     if (size == 0 || nmemb == 0)
         __funlock_return(stream, 0);
 
+    __stdio_orient_byte(stream);
     if ((stream->flags & __SRD) == 0) {
         __stdio_bad_dir(stream);
         __funlock_return(stream, 0);
diff --git a/libc/stdio/freopen.c b/libc/stdio/freopen.c
index 588cab144a..52edd077ca 100644
--- a/libc/stdio/freopen.c
+++ b/libc/stdio/freopen.c
@@ -76,7 +76,7 @@ freopen(const char *pathname, const char *mode, FILE *stream)
     }
 
     /* Errors and end-of-file are cleared, as is the orientation */
-    stream->flags &= ~(__SRD | __SWR | __SERR | __SEOF | __SWIDE);
+    stream->flags &= ~(__SRD | __SWR | __SERR | __SEOF | __SWIDE | __SBYTE);
     __atomic_store_ungetc(&stream->unget, 0);
     pf->ptr = (void *)(intptr_t)(fd);
     pf->dir = 0;
diff --git a/libc/stdio/fwide.c b/libc/stdio/fwide.c
index 0c3150bfbf..4b9dbaf5ff 100644
--- a/libc/stdio/fwide.c
+++ b/libc/stdio/fwide.c
@@ -38,8 +38,18 @@
 int
 fwide(FILE *stream, int mode)
 {
+    int ret;
+
     __flockfile(stream);
-    if (mode != 0)
-        stream->flags = (stream->flags & ~__SWIDE) | ((mode > 0) ? __SWIDE : 0);
-    __funlock_return(stream, (stream->flags & __SWIDE) ? 1 : -1);
+    if (mode > 0)
+        __stdio_orient_wide(stream);
+    else if (mode < 0)
+        __stdio_orient_byte(stream);
+    if (stream->flags & __SWIDE)
+        ret = 1;
+    else if (stream->flags & __SBYTE)
+        ret = -1;
+    else
+        ret = 0;
+    __funlock_return(stream, ret);
 }
diff --git a/libc/stdio/fwrite.c b/libc/stdio/fwrite.c
index c2ab0bf254..17f9047e4f 100644
--- a/libc/stdio/fwrite.c
+++ b/libc/stdio/fwrite.c
@@ -45,6 +45,7 @@ fwrite(const void *ptr, size_t size, size_t nmemb, FILE *stream)
     if (size == 0 || nmemb == 0)
         __funlock_return(stream, 0);
 
+    __stdio_orient_byte(stream);
     if ((stream->flags & __SWR) == 0) {
         __stdio_bad_dir(stream);
         __funlock_return(stream, 0);
diff --git a/libc/stdio/local-stdio.h b/libc/stdio/local-stdio.h
index a73a9cd676..c12714b00c 100644
--- a/libc/stdio/local-stdio.h
+++ b/libc/stdio/local-stdio.h
@@ -585,6 +585,25 @@ void       __picolibc_non_atomic_store_ungetc(__ungetc_t *p, __ungetc_t v);
 
 #endif /* __ATOMIC_UNGETC */
 
+/*
+ * The first byte or wide-character input/output function applied to
+ * a stream without orientation makes it byte- or wide-oriented (XSH
+ * 2.5.2). Only fwide and freopen change it after that.
+ */
+static inline void
+__stdio_orient_byte(FILE *stream)
+{
+    if ((stream->flags & (__SWIDE | __SBYTE)) == 0)
+        stream->flags |= __SBYTE;
+}
+
+static inline void
+__stdio_orient_wide(FILE *stream)
+{
+    if ((stream->flags & (__SWIDE | __SBYTE)) == 0)
+        stream->flags |= __SWIDE;
+}
+
 /*
  * Reading a stream not open for reading, or writing one not open for
  * writing, sets the error indicator and fails with EBADF
diff --git a/libc/stdio/perror.c b/libc/stdio/perror.c
index 20f4486533..24d386f3d5 100644
--- a/libc/stdio/perror.c
+++ b/libc/stdio/perror.c
@@ -38,8 +38,13 @@
 void
 perror(const char *msg)
 {
-    int err = errno;
+    int  err = errno;
+
+    /* perror leaves a stream without orientation unoriented */
+    bool unoriented = (stderr->flags & (__SWIDE | __SBYTE)) == 0;
     if (msg && *msg)
         fprintf(stderr, "%s: ", msg);
     fprintf(stderr, "%s\n", strerror(err));
+    if (unoriented)
+        stderr->flags &= (__uint16_t) ~(__SWIDE | __SBYTE);
 }
diff --git a/libc/stdio/puts.c b/libc/stdio/puts.c
index 2c2bed31fa..560d449416 100644
--- a/libc/stdio/puts.c
+++ b/libc/stdio/puts.c
@@ -41,6 +41,7 @@ puts(const char *str)
 
     __flockfile(out);
 
+    __stdio_orient_byte(out);
     if ((out->flags & __SWR) == 0) {
         __stdio_bad_dir(out);
         goto exit;
diff --git a/libc/stdio/ungetc.c b/libc/stdio/ungetc.c
index 40d0d5bce8..d9582fbd15 100644
--- a/libc/stdio/ungetc.c
+++ b/libc/stdio/ungetc.c
@@ -43,6 +43,8 @@ __STDIO_UNLOCKED(ungetc)(int c, FILE *stream)
      *
      * ungetc(EOF, ...) causes an error per definitionem.
      */
+    __stdio_orient_byte(stream);
+
     if ((stream->flags & __SRD) == 0 || c == EOF)
         return EOF;
 
diff --git a/libc/stdio/ungetwc.c b/libc/stdio/ungetwc.c
index f14893e325..fc8a2f4785 100644
--- a/libc/stdio/ungetwc.c
+++ b/libc/stdio/ungetwc.c
@@ -41,6 +41,8 @@ __STDIO_UNLOCKED(ungetwc)(wint_t c, FILE *stream)
      *
      * ungetwc(WEOF, ...) causes an error per definition.
      */
+    __stdio_orient_wide(stream);
+
     if ((stream->flags & __SRD) == 0 || c == WEOF)
         return WEOF;
 
diff --git a/libc/stdio/vfprintf.c b/libc/stdio/vfprintf.c
index 7315a95646..314f108252 100644
--- a/libc/stdio/vfprintf.c
+++ b/libc/stdio/vfprintf.c
@@ -705,6 +705,12 @@ vfprintf(FILE *stream, const CHAR *fmt, va_list ap_orig)
 
     __flockfile(stream);
 
+#ifdef WIDE_CHARS
+    __stdio_orient_wide(stream);
+#else
+    __stdio_orient_byte(stream);
+#endif
+
     if ((stream->flags & __SWR) == 0) {
         __stdio_bad_dir(stream);
         __funlock_return(stream, EOF);
diff --git a/libc/stdio/vfscanf.c b/libc/stdio/vfscanf.c
index c48878b03b..3e90f82456 100644
--- a/libc/stdio/vfscanf.c
+++ b/libc/stdio/vfscanf.c
@@ -616,6 +616,12 @@ vfscanf(FILE *stream, const CHAR *fmt, va_list ap_orig)
 
     __flockfile(stream);
 
+#ifdef WIDE_CHARS
+    __stdio_orient_wide(stream);
+#else
+    __stdio_orient_byte(stream);
+#endif
+
     nconvs = 0;
 
     /* Initialization of stream_flags at each pass simplifies the register
