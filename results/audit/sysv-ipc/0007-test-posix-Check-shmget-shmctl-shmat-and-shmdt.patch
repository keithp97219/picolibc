 test/test-posix/test-sys-shm/meson.build    |   3 +
 test/test-posix/test-sys-shm/test-shmat.c   | 193 ++++++++++++-
 test/test-posix/test-sys-shm/test-shmctl.c  | 285 ++++++++++++++++++++
 test/test-posix/test-sys-shm/test-shmdt.c   | 176 ++++++++++++
 test/test-posix/test-sys-shm/test-shmget.c  | 221 +++++++++++++++
 6 files changed, 872 insertions(+), 9 deletions(-)
 create mode 100644 test/test-posix/test-sys-shm/test-shmctl.c
 create mode 100644 test/test-posix/test-sys-shm/test-shmdt.c
 create mode 100644 test/test-posix/test-sys-shm/test-shmget.c

