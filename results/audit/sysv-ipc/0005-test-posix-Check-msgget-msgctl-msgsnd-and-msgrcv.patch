+/* Every queue made here, removed on every way out */
+static int ids[8];
+static int nids;
+
+static void
+cleanup(void)
+{
+    while (nids > 0)
+        msgctl(ids[--nids], IPC_RMID, NULL);
+}
+
+static void
+watchdog(int sig)
+{
+    (void)sig;
+    cleanup();
+    _exit(1);
+}
+
+static int
+keep(int id)
+{
+    if (id >= 0)
+        ids[nids++] = id;
+    return id;
+}
+
+static void
+drop(int id)
+{
+    int i;
+
+    for (i = 0; i < nids; i++)
+        if (ids[i] == id)
+            ids[i] = ids[--nids];
+}
