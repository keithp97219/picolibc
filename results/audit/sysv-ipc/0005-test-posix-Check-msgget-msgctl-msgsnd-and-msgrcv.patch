 test/test-posix/test-sys-msg/test-msgget.c  | 235 ++++++++++++
 test/test-posix/test-sys-msg/test-msgrcv.c  | 322 +++++++++++++++--
 test/test-posix/test-sys-msg/test-msgsnd.c  | 381 ++++++++++++++++++++
 6 files changed, 1203 insertions(+), 43 deletions(-)
