From c29034a959e7b8219244d0a9b66c6dc3b0721cc9 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 04:05:55 +0000
Subject: [PATCH 05/15] libos/linux: Check the waitid idtype and options

waitid passed idtype straight to Linux, which takes 3 as P_PIDFD, and
took P_PGID 0 as the caller's group, where no process group has ID 0.
It also dropped unknown option bits instead of failing. POSIX: "[EINVAL]
An invalid value was specified for options, or idtype and id specify an
invalid set of processes". Map idtype onto the Linux values and reject
the rest, after entering the cancellation point.
---
 .../linux/machine/aarch64/linux/linux-wait.h  |  3 ++
 libos/linux/machine/arm/linux/linux-wait.h    |  3 ++
 .../linux/machine/hexagon/linux/linux-wait.h  |  3 ++
 libos/linux/machine/i686/linux/linux-wait.h   |  3 ++
 libos/linux/machine/x86_64/linux/linux-wait.h |  3 ++
 libos/linux/utils/make-wait.c                 |  3 ++
 libos/linux/waitid.c                          | 31 ++++++++++++++++++-
 7 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/libos/linux/machine/aarch64/linux/linux-wait.h b/libos/linux/machine/aarch64/linux/linux-wait.h
index 4d5acd0840..0a3bbb4552 100644
--- a/libos/linux/machine/aarch64/linux/linux-wait.h
+++ b/libos/linux/machine/aarch64/linux/linux-wait.h
@@ -34,6 +34,9 @@
  */
 #ifndef _LINUX_WAIT_H_
 #define _LINUX_WAIT_H_
+#define LINUX_P_ALL      0
+#define LINUX_P_PGID     2
+#define LINUX_P_PID      1
 #define LINUX_WCONTINUED 0x8
 #define LINUX_WEXITED    0x4
 #define LINUX_WNOHANG    0x1
diff --git a/libos/linux/machine/arm/linux/linux-wait.h b/libos/linux/machine/arm/linux/linux-wait.h
index 4d5acd0840..0a3bbb4552 100644
--- a/libos/linux/machine/arm/linux/linux-wait.h
+++ b/libos/linux/machine/arm/linux/linux-wait.h
@@ -34,6 +34,9 @@
  */
 #ifndef _LINUX_WAIT_H_
 #define _LINUX_WAIT_H_
+#define LINUX_P_ALL      0
+#define LINUX_P_PGID     2
+#define LINUX_P_PID      1
 #define LINUX_WCONTINUED 0x8
 #define LINUX_WEXITED    0x4
 #define LINUX_WNOHANG    0x1
diff --git a/libos/linux/machine/hexagon/linux/linux-wait.h b/libos/linux/machine/hexagon/linux/linux-wait.h
index 4d5acd0840..0a3bbb4552 100644
--- a/libos/linux/machine/hexagon/linux/linux-wait.h
+++ b/libos/linux/machine/hexagon/linux/linux-wait.h
@@ -34,6 +34,9 @@
  */
 #ifndef _LINUX_WAIT_H_
 #define _LINUX_WAIT_H_
+#define LINUX_P_ALL      0
+#define LINUX_P_PGID     2
+#define LINUX_P_PID      1
 #define LINUX_WCONTINUED 0x8
 #define LINUX_WEXITED    0x4
 #define LINUX_WNOHANG    0x1
diff --git a/libos/linux/machine/i686/linux/linux-wait.h b/libos/linux/machine/i686/linux/linux-wait.h
index 4d5acd0840..0a3bbb4552 100644
--- a/libos/linux/machine/i686/linux/linux-wait.h
+++ b/libos/linux/machine/i686/linux/linux-wait.h
@@ -34,6 +34,9 @@
  */
 #ifndef _LINUX_WAIT_H_
 #define _LINUX_WAIT_H_
+#define LINUX_P_ALL      0
+#define LINUX_P_PGID     2
+#define LINUX_P_PID      1
 #define LINUX_WCONTINUED 0x8
 #define LINUX_WEXITED    0x4
 #define LINUX_WNOHANG    0x1
diff --git a/libos/linux/machine/x86_64/linux/linux-wait.h b/libos/linux/machine/x86_64/linux/linux-wait.h
index 4d5acd0840..0a3bbb4552 100644
--- a/libos/linux/machine/x86_64/linux/linux-wait.h
+++ b/libos/linux/machine/x86_64/linux/linux-wait.h
@@ -34,6 +34,9 @@
  */
 #ifndef _LINUX_WAIT_H_
 #define _LINUX_WAIT_H_
+#define LINUX_P_ALL      0
+#define LINUX_P_PGID     2
+#define LINUX_P_PID      1
 #define LINUX_WCONTINUED 0x8
 #define LINUX_WEXITED    0x4
 #define LINUX_WNOHANG    0x1
diff --git a/libos/linux/utils/make-wait.c b/libos/linux/utils/make-wait.c
index 7ab11b1d95..9bb803b753 100644
--- a/libos/linux/utils/make-wait.c
+++ b/libos/linux/utils/make-wait.c
@@ -45,6 +45,9 @@ main(void)
     printf("#define LINUX_WEXITED 0x%x\n", WEXITED);
     printf("#define LINUX_WSTOPPED 0x%x\n", WSTOPPED);
     printf("#define LINUX_WNOWAIT 0x%x\n", WNOWAIT);
+    printf("#define LINUX_P_ALL %d\n", P_ALL);
+    printf("#define LINUX_P_PID %d\n", P_PID);
+    printf("#define LINUX_P_PGID %d\n", P_PGID);
 
     /* should check status macros somehow */
 
diff --git a/libos/linux/waitid.c b/libos/linux/waitid.c
index 1d6a5f1f7e..95fb95f2a3 100644
--- a/libos/linux/waitid.c
+++ b/libos/linux/waitid.c
@@ -45,6 +45,29 @@ waitid(idtype_t idtype, id_t id, siginfo_t *infop, int options)
     int                     koptions = 0;
     void                   *cancel;
     long                    ret;
+    int                     kidtype;
+
+    switch (idtype) {
+    case P_ALL:
+        kidtype = LINUX_P_ALL;
+        break;
+    case P_PID:
+        kidtype = LINUX_P_PID;
+        break;
+    case P_PGID:
+        /*
+         * No process group has ID 0, but Linux takes 0 to mean the
+         * caller's group
+         */
+        kidtype = id == 0 ? -1 : LINUX_P_PGID;
+        break;
+    default:
+        /* Linux gives other values meanings of its own, such as P_PIDFD */
+        kidtype = -1;
+        break;
+    }
+    if (options & ~(WEXITED | WSTOPPED | WCONTINUED | WNOHANG | WNOWAIT))
+        kidtype = -1;
 
     if (options & WEXITED)
         koptions |= LINUX_WEXITED;
@@ -59,8 +82,14 @@ waitid(idtype_t idtype, id_t id, siginfo_t *infop, int options)
 
     /* With WNOHANG and no child ready, the kernel leaves this zero */
     memset(&kinfo, 0, sizeof(kinfo));
+    /* A pending cancellation acts even when the arguments are bad */
     cancel = _cancel_enter();
-    ret = _syscall(LINUX_SYS_waitid, idtype, id, &kinfo, koptions, NULL);
+    if (kidtype < 0) {
+        _cancel_leave(cancel);
+        errno = EINVAL;
+        return -1;
+    }
+    ret = _syscall(LINUX_SYS_waitid, kidtype, id, &kinfo, koptions, NULL);
     _cancel_leave(cancel);
     if (ret < 0)
         return -1;
