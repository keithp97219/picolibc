+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS
+ * FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE
+ * COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT,
+ * INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES
+ * (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
+ * SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT,
+ * STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED
+ * OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#define _POSIX_C_SOURCE 202405L
+/* getpriority and setpriority are XSI interfaces */
+#define _XOPEN_SOURCE 800
+#include "../posix-groups.h"
+
+/* Without the system support this test needs, it is skipped */
+#if _POSIX_THREADS > 0 && defined(__PICOLIBC_POSIX_MULTI_PROCESS) && defined(__PICOLIBC_POSIX_PIPE)
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
+
+/*
+ * setpriority(PRIO_PROCESS) changes the whole process, so every
+ * thread sees the new value, whether who is 0 or the process ID and
+ * whichever thread calls it. The changes are made in a child.
+ */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+static int go[2], done[2];
+static int base, seen;
+
+static void *
+waiter(void *arg)
+{
+    char c;
+
+    (void)arg;
+    /* First report the value main set, then change it from here by process ID */
+    if (read(go[0], &c, 1) != 1)
+        return NULL;
+    seen = getpriority(PRIO_PROCESS, 0);
+    if (setpriority(PRIO_PROCESS, (id_t)getpid(), base + 2) != 0)
+        seen = -100;
+    (void)write(done[1], "x", 1);
+    return NULL;
+}
+
+static void
+child(void)
+{
+    pthread_t t;
+    char      c;
+
+    check(pipe(go) == 0 && pipe(done) == 0, "pipe");
+    check(pthread_create(&t, NULL, waiter, NULL) == 0, "pthread_create");
+
+    check(setpriority(PRIO_PROCESS, 0, base + 1) == 0, "setpriority");
+    check(getpriority(PRIO_PROCESS, 0) == base + 1, "the caller has the new value");
+    check(write(go[1], "x", 1) == 1 && read(done[0], &c, 1) == 1, "handshake");
+    check(pthread_join(t, NULL) == 0, "pthread_join");
+    check(seen != -100, "setpriority in the thread");
+    /* glibc's setpriority changes only one thread */
+#ifndef __GLIBC__
+    check(seen == base + 1, "the other thread has the new value");
+    check(getpriority(PRIO_PROCESS, 0) == base + 2, "the main thread has the thread's value");
+#endif
+    exit(0);
+}
+
+int
+main(void)
+{
+    pid_t pid;
+    int   status;
+
+    errno = 0;
+    base = getpriority(PRIO_PROCESS, 0);
+    check(base != -1 || errno == 0, "getpriority");
+    if (base > 17) {
+        printf("nice value %d leaves no room, skipping\n", base);
+        return 77;
+    }
+    fflush(stdout);
+    pid = fork();
+    check(pid >= 0, "fork");
+    if (pid == 0)
+        child();
+    check(waitpid(pid, &status, 0) == pid, "waitpid");
+    check(WIFEXITED(status) && WEXITSTATUS(status) == 0, "child checks");
+    check(getpriority(PRIO_PROCESS, 0) == base, "the parent is unchanged");
+
+    printf("success\n");
+    return 0;
+}
+
+#else
+
+#include <stdio.h>
+
+int
+main(void)
+{
+    printf("no system support, skipping\n");
+    return 77;
+}
+
+#endif
diff --git a/test/test-posix/test-sys-resource/test-setpriority.c b/test/test-posix/test-sys-resource/test-setpriority.c
index 852959e09a..86af2458f3 100644
--- a/test/test-posix/test-sys-resource/test-setpriority.c
+++ b/test/test-posix/test-sys-resource/test-setpriority.c
@@ -39,14 +39,24 @@
 #include "../posix-groups.h"
 
 /* Without the system support this test needs, it is skipped */
-#if defined(__PICOLIBC_POSIX_MULTI_PROCESS)
+#if defined(__PICOLIBC_POSIX_MULTI_PROCESS) && defined(__PICOLIBC_POSIX_PIPE)
 
 #include <errno.h>
+#include <limits.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <sys/resource.h>
+#include <sys/wait.h>
 
-/* setpriority changes nice values */
+/*
+ * setpriority changes nice values: of the caller, clamped to the
+ * supported range, and of every process in a group. Unprivileged
+ * callers can't lower them. The changes are made in a child.
+ */
+
+#ifndef NZERO
+#error "NZERO missing from <limits.h>"
+#endif
 
 #define check(condition, message)                      \
     do {                                               \
@@ -56,18 +66,95 @@
         }                                              \
     } while (0)
 
+static void
+child(int prio)
+{
+    int   ret, report[2], go[2], seen;
+    pid_t pid;
+    char  c;
+
+    /* Raising the nice value is always allowed */
+    check(setpriority(PRIO_PROCESS, 0, prio + 1) == 0, "setpriority");
+    check(getpriority(PRIO_PROCESS, 0) == prio + 1, "new value");
+
+    /* Lowering it again takes privilege (or a Linux RLIMIT_NICE allowance) */
+    errno = 0;
+    ret = setpriority(PRIO_PROCESS, 0, prio);
+    if (ret != 0) {
+        check(errno == EACCES || errno == EPERM, "lowering fails with EACCES");
+        check(getpriority(PRIO_PROCESS, 0) == prio + 1, "unchanged after EACCES");
+    } else if (geteuid() != 0) {
+        printf("lowering the nice value was allowed\n");
+    }
+
+    /* PRIO_PGRP 0 changes every process in the caller's group */
+    check(setpgid(0, 0) == 0, "own process group");
+    check(pipe(report) == 0 && pipe(go) == 0, "pipe");
+    pid = fork();
+    check(pid >= 0, "fork");
+    if (pid == 0) {
+        int value;
+
+        if (read(go[0], &c, 1) != 1)
+            _exit(1);
+        value = getpriority(PRIO_PROCESS, 0);
+        (void)write(report[1], &value, sizeof(value));
+        _exit(0);
+    }
+    check(setpriority(PRIO_PGRP, 0, prio + 2) == 0, "setpriority(PRIO_PGRP)");
+    check(write(go[1], "x", 1) == 1, "go");
+    check(read(report[0], &seen, sizeof(seen)) == sizeof(seen), "report");
+    check(seen == prio + 2, "the other member has the group's value");
+    check(waitpid(pid, NULL, 0) == pid, "waitpid");
+
+    /* For a group, getpriority reports the lowest value */
+    pid = fork();
+    check(pid >= 0, "fork");
+    if (pid == 0) {
+        (void)read(go[0], &c, 1);
+        _exit(0);
+    }
+    check(setpriority(PRIO_PROCESS, 0, prio + 3) == 0, "setpriority");
+    errno = 0;
+    check(getpriority(PRIO_PGRP, 0) == prio + 2 && errno == 0, "the group's lowest value");
+    check(write(go[1], "x", 1) == 1, "go");
+    check(waitpid(pid, NULL, 0) == pid, "waitpid");
+
+    /* Values above the range give the highest supported value */
+    check(setpriority(PRIO_PROCESS, 0, INT_MAX) == 0, "setpriority(INT_MAX)");
+    ret = getpriority(PRIO_PROCESS, 0);
+    /* Linux supports the whole range, up to NZERO - 1 */
+    check(ret == NZERO - 1, "clamped to the highest value");
+    exit(0);
+}
+
 int
 main(void)
 {
-    int prio = getpriority(PRIO_PROCESS, 0);
+    int   prio, status;
+    pid_t pid;
 
-    /* Raising the nice value is always allowed */
-    if (prio < 19) {
-        check(setpriority(PRIO_PROCESS, 0, prio + 1) == 0, "setpriority");
-        check(getpriority(PRIO_PROCESS, 0) == prio + 1, "new value");
+    errno = 0;
+    prio = getpriority(PRIO_PROCESS, 0);
+    check(errno == 0 && prio >= -NZERO && prio <= NZERO - 1, "own priority");
+    if (prio > NZERO - 4) {
+        printf("nice value %d leaves no room, skipping\n", prio);
+        return 77;
     }
+
+    fflush(stdout);
+    pid = fork();
+    check(pid >= 0, "fork");
+    if (pid == 0)
+        child(prio);
+    check(waitpid(pid, &status, 0) == pid, "waitpid");
+    check(WIFEXITED(status) && WEXITSTATUS(status) == 0, "child checks");
+    check(getpriority(PRIO_PROCESS, 0) == prio, "the parent is unchanged");
+
     errno = 0;
     check(setpriority(42, 0, 0) == -1 && errno == EINVAL, "EINVAL");
+    errno = 0;
+    check(setpriority(PRIO_PROCESS, INT_MAX, prio + 1) == -1 && errno == ESRCH, "ESRCH");
     printf("success\n");
     return 0;
 }
