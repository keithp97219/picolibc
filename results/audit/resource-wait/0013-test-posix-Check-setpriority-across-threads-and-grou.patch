 test/test-posix/test-sys-resource/meson.build |   4 +
 .../test-sys-resource/test-getpriority.c      |   9 +-
 .../test-sys-resource/test-getrusage.c        |  98 +++++++++++-
 .../test-setpriority-thread.c                 | 143 ++++++++++++++++++
 .../test-sys-resource/test-setpriority.c      | 101 ++++++++++++-
 6 files changed, 346 insertions(+), 10 deletions(-)
 create mode 100644 test/test-posix/test-sys-resource/test-setpriority-thread.c

