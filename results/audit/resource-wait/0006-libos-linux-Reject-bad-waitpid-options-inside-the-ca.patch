From 2ca168b8069e05cb9c7968e7d35903f5acc60651 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 04:05:55 +0000
Subject: [PATCH 06/15] libos/linux: Reject bad waitpid options inside the
 cancellation point

waitpid returned EINVAL for bad options before entering the
cancellation point, so a pending cancellation request was skipped.
---
 libos/linux/waitpid.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/libos/linux/waitpid.c b/libos/linux/waitpid.c
index 185f465a45..ba53b549fb 100644
--- a/libos/linux/waitpid.c
+++ b/libos/linux/waitpid.c
@@ -45,17 +45,19 @@ waitpid(pid_t pid, int *wstatus, int options)
     pid_t ret;
     int   kstatus;
 
-    if (options & ~(WNOHANG | WUNTRACED | WCONTINUED)) {
-        errno = EINVAL;
-        return -1;
-    }
     if (options & WNOHANG)
         koptions |= LINUX_WNOHANG;
     if (options & WUNTRACED)
         koptions |= LINUX_WUNTRACED;
     if (options & WCONTINUED)
         koptions |= LINUX_WCONTINUED;
+    /* A pending cancellation acts even when the options are bad */
     cancel = _cancel_enter();
+    if (options & ~(WNOHANG | WUNTRACED | WCONTINUED)) {
+        _cancel_leave(cancel);
+        errno = EINVAL;
+        return -1;
+    }
     ret = _syscall(LINUX_SYS_wait4, pid, &kstatus, koptions, NULL);
     _cancel_leave(cancel);
     /* With WNOHANG, 0 means no child changed state and there's no status */
-- 
