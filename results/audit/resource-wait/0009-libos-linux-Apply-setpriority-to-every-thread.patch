From 9615e2ff2bca4f7a71bcd2e8332fe839ded706ea Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 04:05:55 +0000
Subject: [PATCH 09/15] libos/linux: Apply setpriority to every thread

Linux keeps a nice value per thread, so setpriority(PRIO_PROCESS) for
the caller's own process changed only one thread. POSIX: "The nice value
set with setpriority() shall be applied to the process. If the process
is multi-threaded, the nice value shall affect all system scope threads
in the process." Move the thread walk from nice into setpriority, which
nice now calls.
---
 libos/linux/nice.c        | 35 ++---------------------------------
 libos/linux/setpriority.c | 28 ++++++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 33 deletions(-)

diff --git a/libos/linux/nice.c b/libos/linux/nice.c
index 687cb136a8..7328675c7c 100644
--- a/libos/linux/nice.c
+++ b/libos/linux/nice.c
@@ -34,41 +34,9 @@
  */
 
 #include "local-linux.h"
-#ifdef __PICOLIBC_PTHREADS
-#include "local-pthread.h"
-#endif
 #include <sys/resource.h>
 #include <unistd.h>
 
-/*
- * Linux keeps a nice value for each thread, but nice changes the
- * process: set the new value in every thread
- */
-static int
-set_nice(int prio)
-{
-#ifdef __PICOLIBC_PTHREADS
-    if (__atomic_load_n(&_pthread_count, __ATOMIC_ACQUIRE) > 1) {
-        struct __pthread *self = _pthread_self(), *t;
-        int               ret, tid;
-
-        /* Threads are created and listed with this lock held */
-        pthread_mutex_lock(&_pthread_all_lock);
-        ret = setpriority(PRIO_PROCESS, 0, prio);
-        if (ret == 0) {
-            for (t = _pthread_all; t; t = t->all_next) {
-                tid = __atomic_load_n(&t->tid, __ATOMIC_ACQUIRE);
-                if (t != self && tid)
-                    (void)_syscall_raw(LINUX_SYS_setpriority, PRIO_PROCESS, tid, prio);
-            }
-        }
-        pthread_mutex_unlock(&_pthread_all_lock);
-        return ret;
-    }
-#endif
-    return setpriority(PRIO_PROCESS, 0, prio);
-}
-
 /* Returns the new nice value; -1 is also a valid nice value, so check errno */
 int
 nice(int incr)
@@ -89,7 +57,8 @@ nice(int incr)
         prio = 19;
     if (prio < -20)
         prio = -20;
-    if (set_nice(prio) < 0) {
+    /* setpriority sets the value in every thread */
+    if (setpriority(PRIO_PROCESS, 0, prio) < 0) {
         if (errno == EACCES)
             errno = EPERM;
         return -1;
diff --git a/libos/linux/setpriority.c b/libos/linux/setpriority.c
index 0e3dd9d9a4..1880873848 100644
--- a/libos/linux/setpriority.c
+++ b/libos/linux/setpriority.c
@@ -34,10 +34,38 @@
  */
 
 #include "local-linux.h"
+#ifdef __PICOLIBC_PTHREADS
+#include "local-pthread.h"
+#endif
 #include <sys/resource.h>
+#include <unistd.h>
 
+/*
+ * Linux keeps a nice value for each thread, but setpriority changes
+ * the process: for this process, set the new value in every thread
+ */
 int
 setpriority(int which, id_t who, int prio)
 {
+#ifdef __PICOLIBC_PTHREADS
+    if (which == PRIO_PROCESS && (who == 0 || who == (id_t)getpid())
+        && __atomic_load_n(&_pthread_count, __ATOMIC_ACQUIRE) > 1) {
+        struct __pthread *self = _pthread_self(), *t;
+        int               ret, tid;
+
+        /* Threads are created and listed with this lock held */
+        pthread_mutex_lock(&_pthread_all_lock);
+        ret = (int)_syscall(LINUX_SYS_setpriority, PRIO_PROCESS, 0, prio);
+        if (ret == 0) {
+            for (t = _pthread_all; t; t = t->all_next) {
+                tid = __atomic_load_n(&t->tid, __ATOMIC_ACQUIRE);
+                if (t != self && tid)
+                    (void)_syscall_raw(LINUX_SYS_setpriority, PRIO_PROCESS, tid, prio);
+            }
+        }
+        pthread_mutex_unlock(&_pthread_all_lock);
+        return ret;
+    }
+#endif
     return (int)_syscall(LINUX_SYS_setpriority, which, who, prio);
 }
