From cb9ffc951b542a88049f4111aa77e821e2c6e83b Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 18:30:04 +0000
Subject: [PATCH 1/8] libos/linux: Count barrier arrivals under a lock

pthread_barrier_wait read __seq, then counted itself in. A thread
arriving as the previous group completed could count itself into the
next group yet leave with the previous one, or have its arrival
overwritten by the reset, so groups left early or never filled.
Count arrivals and read __seq under a small futex lock.
---
 libc/include/sys/_pthreadtypes.h   |  3 ++-
 libos/linux/pthread_barrier_init.c |  1 +
 libos/linux/pthread_barrier_wait.c | 43 +++++++++++++++++++++++++-----
 3 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/libc/include/sys/_pthreadtypes.h b/libc/include/sys/_pthreadtypes.h
index ffb3504732..76b105c776 100644
--- a/libc/include/sys/_pthreadtypes.h
+++ b/libc/include/sys/_pthreadtypes.h
@@ -119,7 +119,8 @@ typedef struct {
 typedef struct {
     unsigned int __count;
     unsigned int __waiting;
-    unsigned int __seq; /* advanced as each group of threads leaves */
+    unsigned int __seq;  /* advanced as each group of threads leaves */
+    unsigned int __lock; /* held while a thread arrives */
     int          __pshared;
 } pthread_barrier_t;
 
diff --git a/libos/linux/pthread_barrier_init.c b/libos/linux/pthread_barrier_init.c
index 662171f040..335f70a0ec 100644
--- a/libos/linux/pthread_barrier_init.c
+++ b/libos/linux/pthread_barrier_init.c
@@ -45,6 +45,7 @@ pthread_barrier_init(pthread_barrier_t * __restrict barrier,
     barrier->__count = count;
     barrier->__waiting = 0;
     barrier->__seq = 0;
+    barrier->__lock = 0;
     barrier->__pshared = attr ? attr->__pshared : PTHREAD_PROCESS_PRIVATE;
     return 0;
 }
diff --git a/libos/linux/pthread_barrier_wait.c b/libos/linux/pthread_barrier_wait.c
index 2e47157638..8afcf0ffd5 100644
--- a/libos/linux/pthread_barrier_wait.c
+++ b/libos/linux/pthread_barrier_wait.c
@@ -37,22 +37,51 @@
 #include "local-pthread.h"
 
 /*
- * The last thread to arrive resets the count and advances __seq,
- * releasing the others. Threads can only start the next round after
- * seeing __seq advance, which happens after the reset.
+ * Arrivals are counted under a lock which also covers reading __seq,
+ * so each thread knows which group it joined. The last thread to
+ * arrive resets the count and advances __seq, releasing the others.
  */
+
+/* __lock is 0 when free, 1 when held and 2 when held with possible waiters */
+static void
+barrier_lock(pthread_barrier_t *barrier, bool pshared)
+{
+    unsigned int state = 0;
+
+    if (__atomic_compare_exchange_n(&barrier->__lock, &state, 1, false, __ATOMIC_ACQUIRE,
+                                    __ATOMIC_RELAXED))
+        return;
+    if (state != 2)
+        state = __atomic_exchange_n(&barrier->__lock, 2, __ATOMIC_ACQUIRE);
+    while (state != 0) {
+        (void)_futex_wait(&barrier->__lock, 2, pshared, CLOCK_REALTIME, NULL);
+        state = __atomic_exchange_n(&barrier->__lock, 2, __ATOMIC_ACQUIRE);
+    }
+}
+
+static void
+barrier_unlock(pthread_barrier_t *barrier, bool pshared)
+{
+    if (__atomic_exchange_n(&barrier->__lock, 0, __ATOMIC_RELEASE) == 2)
+        _futex_wake(&barrier->__lock, 1, pshared);
+}
+
 int
 pthread_barrier_wait(pthread_barrier_t *barrier)
 {
     bool         pshared = barrier->__pshared == PTHREAD_PROCESS_SHARED;
-    unsigned int seq = __atomic_load_n(&barrier->__seq, __ATOMIC_ACQUIRE);
+    unsigned int seq;
 
-    if (__atomic_add_fetch(&barrier->__waiting, 1, __ATOMIC_ACQ_REL) == barrier->__count) {
-        __atomic_store_n(&barrier->__waiting, 0, __ATOMIC_RELAXED);
-        __atomic_fetch_add(&barrier->__seq, 1, __ATOMIC_RELEASE);
+    barrier_lock(barrier, pshared);
+    seq = barrier->__seq;
+    if (++barrier->__waiting == barrier->__count) {
+        barrier->__waiting = 0;
+        __atomic_store_n(&barrier->__seq, seq + 1, __ATOMIC_RELEASE);
+        barrier_unlock(barrier, pshared);
         _futex_wake(&barrier->__seq, INT_MAX, pshared);
         return PTHREAD_BARRIER_SERIAL_THREAD;
     }
+    barrier_unlock(barrier, pshared);
     while (__atomic_load_n(&barrier->__seq, __ATOMIC_ACQUIRE) == seq)
         (void)_futex_wait(&barrier->__seq, seq, pshared, CLOCK_REALTIME, NULL);
     return 0;
-- 
