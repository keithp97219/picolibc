+/* cfsetspeed is a BSD extension */
+#define _DEFAULT_SOURCE
+#include <unistd.h>
+
+/* Without the system support this test needs, it is skipped */
+#if !defined(__PICOLIBC__)                                                                 \
+    || (defined(__PICOLIBC_POSIX_DEVICE_SPECIFIC) && __PICOLIBC_POSIX_DEVICE_SPECIFIC > 0)
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <termios.h>
+
+/* cfsetspeed sets both speeds; cfsetospeed only the output speed */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+int
+main(void)
+{
+    struct termios t;
+
+    memset(&t, 0, sizeof(t));
+    check(cfsetispeed(&t, B1200) == 0 && cfsetospeed(&t, B300) == 0, "set speeds");
+    check(cfgetispeed(&t) == B1200 && cfgetospeed(&t) == B300, "cfsetospeed sets only output");
+    check(cfsetspeed(&t, B4800) == 0, "cfsetspeed");
+    check(cfgetispeed(&t) == B4800 && cfgetospeed(&t) == B4800, "cfsetspeed sets both");
+    printf("success\n");
+    return 0;
+}
+
+#else
+
+#include <stdio.h>
+
+int
+main(void)
+{
+    printf("no system support, skipping\n");
+    return 77;
+}
+
+#endif
