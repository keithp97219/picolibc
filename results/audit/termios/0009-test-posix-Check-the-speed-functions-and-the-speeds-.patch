 test/test-posix/test-termios/meson.build      |   2 +
 .../test-termios/test-cfsetispeed.c           | 161 ++++++++++++++++++
 .../test-posix/test-termios/test-cfsetspeed.c |  84 +++++++++
 4 files changed, 249 insertions(+)
 create mode 100644 test/test-posix/test-termios/test-cfsetispeed.c
 create mode 100644 test/test-posix/test-termios/test-cfsetspeed.c

