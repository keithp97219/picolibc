From 6d651f3d39a6bd19ed9de9ee621ddccbf2f815bb Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:35:25 +0000
Subject: [PATCH 11/18] test-posix: Check MIN and TIME in non-canonical input

The four cases of XBD 11.1.7. Blocking reads are shown by an interval
timer interrupting them, and timeouts are checked against a lower
bound only.
---
 test/test-posix/test-termios/CMakeLists.txt   |   1 +
 test/test-posix/test-termios/meson.build      |   1 +
 .../test-termios/test-tcsetattr-vmin.c        | 292 ++++++++++++++++++
 3 files changed, 294 insertions(+)
 create mode 100644 test/test-posix/test-termios/test-tcsetattr-vmin.c

diff --git a/test/test-posix/test-termios/CMakeLists.txt b/test/test-posix/test-termios/CMakeLists.txt
index bc0f4e734d..ae9929c96e 100644
--- a/test/test-posix/test-termios/CMakeLists.txt
+++ b/test/test-posix/test-termios/CMakeLists.txt
@@ -43,6 +43,7 @@ set(tests
   test-tcsendbreak
   test-tcsetattr
   test-tcsetattr-icanon
+  test-tcsetattr-vmin
   test-tcsetwinsize
   test-termios_h
   test-termios_h-posix
diff --git a/test/test-posix/test-termios/meson.build b/test/test-posix/test-termios/meson.build
index 227343a930..b83b6fc2c7 100644
--- a/test/test-posix/test-termios/meson.build
+++ b/test/test-posix/test-termios/meson.build
@@ -43,6 +43,7 @@ dir_tests = [
   'test-tcsendbreak',
   'test-tcsetattr',
   'test-tcsetattr-icanon',
+  'test-tcsetattr-vmin',
   'test-tcsetwinsize',
   'test-termios_h',
   'test-termios_h-posix',
diff --git a/test/test-posix/test-termios/test-tcsetattr-vmin.c b/test/test-posix/test-termios/test-tcsetattr-vmin.c
new file mode 100644
index 0000000000..42684a1415
--- /dev/null
+++ b/test/test-posix/test-termios/test-tcsetattr-vmin.c
@@ -0,0 +1,292 @@
