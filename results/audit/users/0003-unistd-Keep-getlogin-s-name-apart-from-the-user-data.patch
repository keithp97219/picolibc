From 32d2e8fed97d3085f4e39c03ebcd6adc2e279578 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 03:57:56 +0000
Subject: [PATCH 03/12] unistd: Keep getlogin's name apart from the user
 database's static data

getlogin returned getpwuid's pw_name, so a later getpwuid, getpwnam or
getpwent call overwrote the string. POSIX: only a subsequent getlogin
call may overwrite it. getlogin now copies the name with getlogin_r
into its own buffer, and sets errno when it fails.
---
 libc/posix/unistd/getlogin.c | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/libc/posix/unistd/getlogin.c b/libc/posix/unistd/getlogin.c
index e9fcb951e5..2d6f12bd1c 100644
--- a/libc/posix/unistd/getlogin.c
+++ b/libc/posix/unistd/getlogin.c
@@ -33,16 +33,25 @@
  * OF THE POSSIBILITY OF SUCH DAMAGE.
  */
 
-#define _DEFAULT_SOURCE
+#define _POSIX_C_SOURCE 202405L
+#include <errno.h>
 #include <unistd.h>
-#include <stdlib.h>
-#include <pwd.h>
+
+/*
+ * The name lives here, not in the user database's static data, so only
+ * another getlogin call overwrites it. 256 is Linux's
+ * sysconf(_SC_LOGIN_NAME_MAX).
+ */
+static char login_name[256];
 
 char *
 getlogin(void)
 {
-    struct passwd *pwd = getpwuid(getuid());
-    if (!pwd)
+    int ret = getlogin_r(login_name, sizeof(login_name));
+
+    if (ret) {
+        errno = ret;
         return NULL;
-    return pwd->pw_name;
+    }
+    return login_name;
 }
