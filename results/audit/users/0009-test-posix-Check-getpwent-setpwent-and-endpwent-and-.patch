 test/test-posix/test-pwd/meson.build      |   2 +
 test/test-posix/test-pwd/test-fgetpwent.c | 170 +++++++++++++++++++++
 test/test-posix/test-pwd/test-setpwent.c  | 171 ++++++++++++++++++++++
 4 files changed, 345 insertions(+)
 create mode 100644 test/test-posix/test-pwd/test-fgetpwent.c
 create mode 100644 test/test-posix/test-pwd/test-setpwent.c

