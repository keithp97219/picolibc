index 0000000000..9f9072134f
--- /dev/null
+++ b/test/test-posix/test-grp/test-setgrent.c
@@ -0,0 +1,170 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright © 2026 Keith Packard
+ *
+ * Redistribution and use in source and binary forms, with or without
