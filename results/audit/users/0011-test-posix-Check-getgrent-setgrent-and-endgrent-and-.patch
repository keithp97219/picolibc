 test/test-posix/test-grp/test-setgrent.c  | 170 +++++++++++++++++++
 4 files changed, 368 insertions(+)
 create mode 100644 test/test-posix/test-grp/test-fgetgrent.c
 create mode 100644 test/test-posix/test-grp/test-setgrent.c

