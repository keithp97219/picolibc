 test/test-posix/test-pwd/CMakeLists.txt   |   1 +
 test/test-posix/test-pwd/meson.build      |   1 +
 test/test-posix/test-pwd/test-pwd_h.c     | 116 ++++++++++++++++++++++
 test/test-posix/test-utmpx/CMakeLists.txt |   1 +
 test/test-posix/test-utmpx/meson.build    |   1 +
 test/test-posix/test-utmpx/test-utmpx_h.c | 110 ++++++++++++++++++++
 9 files changed, 347 insertions(+)
 create mode 100644 test/test-posix/test-grp/test-grp_h.c
 create mode 100644 test/test-posix/test-pwd/test-pwd_h.c
 create mode 100644 test/test-posix/test-utmpx/test-utmpx_h.c

