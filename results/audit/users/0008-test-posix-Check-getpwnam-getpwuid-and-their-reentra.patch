diff --git a/test/test-posix/test-pwd/test-getpwnam.c b/test/test-posix/test-pwd/test-getpwnam.c
new file mode 100644
index 0000000000..0f8cdec26f
--- /dev/null
+++ b/test/test-posix/test-pwd/test-getpwnam.c
@@ -0,0 +1,189 @@
+/*
