+#define _DEFAULT_SOURCE
+#include <setjmp.h>
+
+/* Restores the signal mask if sigsetjmp saved it, then jumps */
+void
+siglongjmp(sigjmp_buf jmpb, int val)
+{
+    __sigjmp_setsigs(jmpb);
+    longjmp(jmpb[0].__jmpb, val);
+}
