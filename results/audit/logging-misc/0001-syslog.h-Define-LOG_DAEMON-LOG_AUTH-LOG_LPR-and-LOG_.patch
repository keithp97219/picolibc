From 2331ae8c4854ab11a2af6744724d76ad915396f3 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 05:03:22 +0000
Subject: [PATCH 01/12] syslog.h: Define LOG_DAEMON, LOG_AUTH, LOG_LPR, and
 LOG_UPTO in strict mode

POSIX lists all three facilities, and LOG_UPTO beside LOG_MASK.
---
 libc/include/syslog.h | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/libc/include/syslog.h b/libc/include/syslog.h
index 8f5f7439b9..000fc97a3b 100644
--- a/libc/include/syslog.h
+++ b/libc/include/syslog.h
@@ -55,6 +55,9 @@ _BEGIN_STD_C
 #define LOG_KERN   (0 << 3)
 #define LOG_USER   (1 << 3)
 #define LOG_MAIL   (2 << 3)
+#define LOG_DAEMON (3 << 3)
+#define LOG_AUTH   (4 << 3)
+#define LOG_LPR    (6 << 3)
 #define LOG_NEWS   (7 << 3)
 #define LOG_UUCP   (8 << 3)
 #define LOG_CRON   (9 << 3)
@@ -78,12 +81,12 @@ _BEGIN_STD_C
 #define LOG_DEBUG     7
 
 #define LOG_MASK(pri) (1 << (pri))
-#if __BSD_VISIBLE || __GNU_VISIBLE
 #define LOG_UPTO(pri) ((1 << ((pri) + 1)) - 1)
-#define LOG_PRIMASK   0x07
-#define LOG_FACMASK   0x03f8
-#define LOG_PRI(p)    ((p) & LOG_PRIMASK)
-#define LOG_FAC(p)    (((p) & LOG_FACMASK) >> 3)
+#if __BSD_VISIBLE || __GNU_VISIBLE
+#define LOG_PRIMASK 0x07
+#define LOG_FACMASK 0x03f8
+#define LOG_PRI(p)  ((p) & LOG_PRIMASK)
+#define LOG_FAC(p)  (((p) & LOG_FACMASK) >> 3)
 #endif
 
 void closelog(void) __picolibc_export;
