     check(strstr(buf, strerror(ENOENT)) != NULL, "%m");
 
-    check(setlogmask(LOG_MASK(LOG_ERR)) == 0xff, "setlogmask");
+    /* %m uses errno on entry, and mixes with %n$ conversions */
+    errno = EACCES;
