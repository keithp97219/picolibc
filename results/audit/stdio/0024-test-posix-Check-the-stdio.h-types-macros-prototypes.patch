From 06d393b6882a4cdb4d26beb4fa92c9e44cbc7592 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 05:42:07 +0000
Subject: [PATCH 24/39] test-posix: Check the stdio.h types, macros, prototypes
 and namespace

Strict POSIX.1-2024 mode, plus XSI 800 for TMP_MAX and P_tmpdir.
---
 test/test-posix/test-stdio/CMakeLists.txt     |   3 +
 test/test-posix/test-stdio/meson.build        |   3 +
 .../test-stdio/test-stdio_h-names.c           | 141 ++++++++++++++
 test/test-posix/test-stdio/test-stdio_h-xsi.c |  54 ++++++
 test/test-posix/test-stdio/test-stdio_h.c     | 182 ++++++++++++++++++
 5 files changed, 383 insertions(+)
 create mode 100644 test/test-posix/test-stdio/test-stdio_h-names.c
 create mode 100644 test/test-posix/test-stdio/test-stdio_h-xsi.c
 create mode 100644 test/test-posix/test-stdio/test-stdio_h.c

diff --git a/test/test-posix/test-stdio/CMakeLists.txt b/test/test-posix/test-stdio/CMakeLists.txt
index 691561e97d..57807d0ac4 100644
--- a/test/test-posix/test-stdio/CMakeLists.txt
+++ b/test/test-posix/test-stdio/CMakeLists.txt
@@ -40,6 +40,9 @@ set(tests
   test-pclose
   test-popen
   test-renameat
+  test-stdio_h
+  test-stdio_h-names
+  test-stdio_h-xsi
   )
 
 foreach(test IN LISTS tests)
diff --git a/test/test-posix/test-stdio/meson.build b/test/test-posix/test-stdio/meson.build
index bec864f5a9..de638c734e 100644
--- a/test/test-posix/test-stdio/meson.build
+++ b/test/test-posix/test-stdio/meson.build
@@ -41,4 +41,7 @@ dir_tests = [
   'test-popen',
   'test-rename',
   'test-renameat',
+  'test-stdio_h',
+  'test-stdio_h-names',
+  'test-stdio_h-xsi',
 ]
