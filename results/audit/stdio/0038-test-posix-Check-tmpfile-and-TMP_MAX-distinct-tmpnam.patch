 test/test-posix/test-stdio/meson.build    |   1 +
 test/test-posix/test-stdio/test-tmpnam.c  | 116 ++++++++++++++++++++++
 3 files changed, 118 insertions(+)
 create mode 100644 test/test-posix/test-stdio/test-tmpnam.c

