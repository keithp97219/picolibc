   )
 
 foreach(test IN LISTS tests)
diff --git a/test/test-posix/test-stdio/meson.build b/test/test-posix/test-stdio/meson.build
index d43da35979..84efc675a5 100644
--- a/test/test-posix/test-stdio/meson.build
+++ b/test/test-posix/test-stdio/meson.build
@@ -54,6 +54,7 @@ dir_tests = [
   'test-stdio_h',
   'test-stdio_h-names',
   'test-stdio_h-xsi',
