From 4ee172db7a88cd2571b409f0268dbfd9808f322e Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 05:42:50 +0000
Subject: [PATCH 33/39] test-posix: Check flockfile counting, ftrylockfile and
 stream locking

---
 test/test-posix/test-stdio/CMakeLists.txt   |   1 +
 test/test-posix/test-stdio/meson.build      |   5 +
 test/test-posix/test-stdio/test-flockfile.c | 242 ++++++++++++++++++++
 3 files changed, 248 insertions(+)
 create mode 100644 test/test-posix/test-stdio/test-flockfile.c

diff --git a/test/test-posix/test-stdio/CMakeLists.txt b/test/test-posix/test-stdio/CMakeLists.txt
index 7e5b367071..bb4e68ad25 100644
--- a/test/test-posix/test-stdio/CMakeLists.txt
+++ b/test/test-posix/test-stdio/CMakeLists.txt
@@ -38,6 +38,7 @@ set(tests
   test-fdopen
   test-fgetc
   test-fileno
+  test-flockfile
   test-fmemopen
   test-fopen
   test-fseek
diff --git a/test/test-posix/test-stdio/meson.build b/test/test-posix/test-stdio/meson.build
index 6691e6d237..7d03b933de 100644
--- a/test/test-posix/test-stdio/meson.build
+++ b/test/test-posix/test-stdio/meson.build
@@ -51,3 +51,8 @@ dir_tests = [
   'test-stdio_h-names',
   'test-stdio_h-xsi',
 ]
+
+# These need threads; they use the library's own locks
+dir_thread_tests = [
+  'test-flockfile',
+]
diff --git a/test/test-posix/test-stdio/test-flockfile.c b/test/test-posix/test-stdio/test-flockfile.c
new file mode 100644
index 0000000000..b44253b6f8
--- /dev/null
+++ b/test/test-posix/test-stdio/test-flockfile.c
@@ -0,0 +1,242 @@
