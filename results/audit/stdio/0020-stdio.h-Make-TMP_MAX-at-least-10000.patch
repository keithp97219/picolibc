From dad1f857f5f9ecceb70841fa93341cfaefe1412f Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 05:16:01 +0000
Subject: [PATCH 20/39] stdio.h: Make TMP_MAX at least 10000

POSIX.1-2024 <stdio.h>: on XSI-conformant systems, TMP_MAX is at least
10000. tmpnam picks from 36^6 names.
---
 libc/include/stdio.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/libc/include/stdio.h b/libc/include/stdio.h
index b19d4ee1fb..5b38f31855 100644
--- a/libc/include/stdio.h
+++ b/libc/include/stdio.h
@@ -634,11 +634,11 @@ int vfprintf_s(FILE * __restrict stream, const char * __restrict fmt, va_list ap
 #endif
 
 /*
- * We don't have any way of knowing any underlying POSIX limits,
- * so just use a reasonably small value here
+ * tmpnam picks six random characters from 36, so it can make many more
+ * names than this. XSI requires at least 10000.
  */
 #ifndef TMP_MAX
-#define TMP_MAX 32
+#define TMP_MAX 10000
 #endif
 
 /*@}*/
