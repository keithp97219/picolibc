+#define _POSIX_C_SOURCE 202405L
+#include "../posix-groups.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/* fileno: the standard streams' descriptors, and EBADF for memory streams */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+int
+main(void)
+{
+    char   buf[16];
+    char  *mem = NULL;
+    size_t size = 0;
+    FILE  *f;
+
+#if defined(__PICOLIBC_POSIX_FILE_SYSTEM)
+    check(fileno(stdin) == 0 && fileno(stdout) == 1 && fileno(stderr) == 2, "standard streams");
+#endif
+
+    f = fmemopen(buf, sizeof(buf), "w");
+    check(f != NULL, "fmemopen");
+    errno = 0;
+    check(fileno(f) == -1 && errno == EBADF, "fileno of an fmemopen stream");
+    check(fclose(f) == 0, "fclose");
+
+    f = open_memstream(&mem, &size);
+    check(f != NULL, "open_memstream");
+    errno = 0;
+    check(fileno(f) == -1 && errno == EBADF, "fileno of an open_memstream stream");
+    check(fclose(f) == 0, "fclose");
+    free(mem);
+
+    printf("success\n");
+    return 0;
+}
