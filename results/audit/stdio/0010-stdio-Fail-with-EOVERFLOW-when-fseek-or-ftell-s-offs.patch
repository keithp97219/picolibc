From d3c0aecf02aadab43fede78eb95d5a3d1730f625 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 05:15:32 +0000
Subject: [PATCH 10/39] stdio: Fail with EOVERFLOW when fseek or ftell's offset
 doesn't fit in long

POSIX.1-2024 fseek and ftell shall fail with EOVERFLOW when the file
offset can't be represented in a long. On 32-bit targets ftell
truncated the offset, and fseek succeeded. fgetpos and fsetpos now use
ftello and fseeko, as fpos_t holds an off_t.
---
 libc/stdio/fgetpos.c | 2 +-
 libc/stdio/fseek.c   | 5 +++++
 libc/stdio/fsetpos.c | 2 +-
 libc/stdio/ftell.c   | 9 +++++++--
 4 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/libc/stdio/fgetpos.c b/libc/stdio/fgetpos.c
index 6addf82217..fefb38a3f8 100644
--- a/libc/stdio/fgetpos.c
+++ b/libc/stdio/fgetpos.c
@@ -65,7 +65,7 @@ No supporting OS subroutines are required.
 int
 fgetpos(FILE * __restrict fp, fpos_t * __restrict pos)
 {
-    *pos = ftell(fp);
+    *pos = ftello(fp);
 
     if (*pos != -1) {
         return 0;
diff --git a/libc/stdio/fseek.c b/libc/stdio/fseek.c
index f540e45acf..50011a9934 100644
--- a/libc/stdio/fseek.c
+++ b/libc/stdio/fseek.c
@@ -73,6 +73,11 @@ FSEEK(FILE *stream, FSEEK_TYPE offset, int whence)
         if (ret >= 0) {
             stream->flags &= ~__SEOF;
             __atomic_store_ungetc(&stream->unget, 0);
+            /* fseek's result must fit in a long */
+            if ((__off_t)(FSEEK_TYPE)ret != ret) {
+                errno = EOVERFLOW;
+                __funlock_return(stream, -1);
+            }
             __funlock_return(stream, 0);
         }
         __funlock_return(stream, -1);
diff --git a/libc/stdio/fsetpos.c b/libc/stdio/fsetpos.c
index 37c7dc09d2..c4fa3d47dd 100644
--- a/libc/stdio/fsetpos.c
+++ b/libc/stdio/fsetpos.c
@@ -59,7 +59,7 @@ Supporting OS subroutines required: <<close>>, <<fstat>>, <<isatty>>,
 int
 fsetpos(FILE *iop, const fpos_t *pos)
 {
-    int x = fseek(iop, *pos, SEEK_SET);
+    int x = fseeko(iop, *pos, SEEK_SET);
 
     if (x != 0)
         return 1;
diff --git a/libc/stdio/ftell.c b/libc/stdio/ftell.c
index 2cb811beeb..7184e587a7 100644
--- a/libc/stdio/ftell.c
+++ b/libc/stdio/ftell.c
@@ -46,10 +46,15 @@ FTELL(FILE *stream)
     struct __file_ext *xf = (struct __file_ext *)stream;
     __flockfile(stream);
     if ((stream->flags & __SEXT) && xf->seek) {
-        FTELL_TYPE ret = (FTELL_TYPE)(xf->seek)(stream, 0, SEEK_CUR);
+        __off_t ret = (xf->seek)(stream, 0, SEEK_CUR);
         if (ret > 0 && __atomic_load_ungetc(&stream->unget) != 0)
             ret--;
-        __funlock_return(stream, ret);
+        /* ftell's result must fit in a long */
+        if ((__off_t)(FTELL_TYPE)ret != ret) {
+            errno = EOVERFLOW;
+            ret = -1;
+        }
+        __funlock_return(stream, (FTELL_TYPE)ret);
     }
     errno = ESPIPE;
     __funlock_return(stream, -1);
-- 
