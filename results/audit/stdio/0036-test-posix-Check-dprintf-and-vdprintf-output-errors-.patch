+#define _POSIX_C_SOURCE 202405L
+#include "../posix-groups.h"
+
+/* Without the system support this test needs, it is skipped */
+#if defined(__PICOLIBC_POSIX_PIPE) && defined(__PICOLIBC_POSIX_FILE_SYSTEM)
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#ifdef __PICOLIBC__
+#include <malloc.h>
+#endif
+
+/* dprintf and vdprintf: output on the descriptor, the count, errors, timestamps */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+static int
+call_vdprintf(int fd, const char *fmt, ...)
+{
+    va_list ap;
+    int     ret;
+
+    va_start(ap, fmt);
+    ret = vdprintf(fd, fmt, ap);
+    va_end(ap);
+    return ret;
+}
+
+int
+main(void)
+{
+    char            buf[256];
+    char            expect[256];
+    int             p[2];
+    int             fd;
+    int             i;
+    struct stat     st;
+    struct timespec old[2] = {
+        { 1000, 0 },
+        { 1000, 0 }
+    };
+    char name[] = "dprintf-XXXXXX";
+
+    check(pipe(p) == 0, "pipe");
+    check(dprintf(p[1], "%d-%s", 42, "x") == 4, "dprintf count");
+    check(read(p[0], buf, sizeof(buf)) == 4 && memcmp(buf, "42-x", 4) == 0, "dprintf output");
+    check(call_vdprintf(p[1], "%3$s%1$s%2$s", "b", "c", "a") == 3, "vdprintf count");
+    check(read(p[0], buf, sizeof(buf)) == 3 && memcmp(buf, "abc", 3) == 0, "vdprintf output");
+
+    /* Longer than any internal buffer */
+    for (i = 0; i < 200; i++)
+        expect[i] = 'a' + i % 26;
+    expect[200] = '\0';
+    check(dprintf(p[1], "%s", expect) == 200, "long dprintf");
+    check(read(p[0], buf, sizeof(buf)) == 200 && memcmp(buf, expect, 200) == 0, "long output");
+
+    /* EBADF (may fail) */
+    errno = 0;
+    check(dprintf(-1, "x") < 0 && errno == EBADF, "dprintf EBADF");
+
+    /* dprintf marks st_mtime */
+    fd = mkstemp(name);
+    check(fd >= 0 && futimens(fd, old) == 0, "file");
+    check(dprintf(fd, "data") == 4 && fstat(fd, &st) == 0, "dprintf to a file");
+    check(st.st_size == 4 && st.st_mtime != 1000, "st_mtime marked");
+    check(close(fd) == 0 && unlink(name) == 0, "cleanup");
+
+#ifdef __PICOLIBC__
+    /* Repeated calls don't keep memory */
+    {
+        struct mallinfo before = mallinfo(), after;
+
+        for (i = 0; i < 1000; i++) {
+            check(dprintf(p[1], "x") == 1, "dprintf");
+            check(read(p[0], buf, 1) == 1, "read");
+        }
+        after = mallinfo();
+        if (after.uordblks > before.uordblks)
+            printf("%zu bytes kept\n", (size_t)(after.uordblks - before.uordblks));
+        check(after.uordblks <= before.uordblks, "dprintf doesn't leak");
+    }
+#endif
+
+    check(close(p[0]) == 0 && close(p[1]) == 0, "close");
+    printf("success\n");
+    return 0;
+}
+
+#else
+
+#include <stdio.h>
+
+int
+main(void)
+{
+    printf("no system support, skipping\n");
+    return 77;
+}
+
+#endif
