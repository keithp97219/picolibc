From 809ef70a945e47594cc2dcddc3d337997bcb4b8e Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 05:16:01 +0000
Subject: [PATCH 18/39] stdio: Make freopen flush, close and then open, and
 close the stream on failure

POSIX.1-2024 freopen first flushes the stream, then closes its file
descriptor, then opens the file, and the original stream is closed
whether or not the open succeeds; orientation is cleared. freopen opened
the new file first (so the new descriptor didn't take the old number,
and the old buffered data was written after a truncating open), left
the stream open when the open failed, and kept a wide orientation. A
null pathname now keeps the descriptor's offset.
---
 libc/stdio/freopen.c | 42 +++++++++++++++++++++++++++++++-----------
 1 file changed, 31 insertions(+), 11 deletions(-)

diff --git a/libc/stdio/freopen.c b/libc/stdio/freopen.c
index e546f082e0..03367aef95 100644
--- a/libc/stdio/freopen.c
+++ b/libc/stdio/freopen.c
@@ -54,30 +54,50 @@ freopen(const char *pathname, const char *mode, FILE *stream)
     if (stdio_flags == 0)
         goto exit;
 
-    if (pathname != NULL) {
-        fd = open(pathname, open_flags, 0666);
-        if (fd < 0)
-            goto exit;
-    } else
-        fd = (int)(intptr_t)(pf->ptr);
-
+    /* Flush first, ignoring any failure */
     (void)__fflush_locked(stream);
 
     __bufio_lock(stream);
 
-    if (pathname != NULL)
-        close((int)(intptr_t)(pf->ptr));
+    if (pathname != NULL) {
+        /*
+         * Close the old file before opening the new one, ignoring any
+         * failure, so the new descriptor can take the old number
+         */
+        (void)bufio_close(pf);
+        fd = open(pathname, open_flags, 0666);
+    } else
+        fd = _FDEV_BUFIO_FD(pf);
 
-    stream->flags = (stream->flags & ~(__SRD | __SWR | __SERR | __SEOF)) | stdio_flags;
-    pf->pos = 0;
+    /* Errors and end-of-file are cleared, as is the orientation */
+    stream->flags &= ~(__SRD | __SWR | __SERR | __SEOF | __SWIDE);
+    __atomic_store_ungetc(&stream->unget, 0);
     pf->ptr = (void *)(intptr_t)(fd);
+    pf->dir = 0;
+    pf->len = 0;
+    pf->off = 0;
 
     /* Switch to POSIX backend */
+    pf->bflags &= ~(__BFPTR | __BSYNC);
     pf->read_int = read;
     pf->write_int = write;
     pf->lseek_int = lseek;
     pf->close_int = close;
 
+    if (fd < 0) {
+        /* The old file is closed even though the open failed */
+        __bufio_unlock(stream);
+        goto exit;
+    }
+
+    stream->flags |= stdio_flags;
+    if (pathname != NULL)
+        pf->pos = 0;
+    else {
+        pf->bflags |= __BSYNC;
+        bufio_sync_pos(pf);
+    }
+
     /* Reset buffer mode and size */
     int (*setvbuf)(struct __file *, char *buf, int mode, size_t size) = 0;
 
