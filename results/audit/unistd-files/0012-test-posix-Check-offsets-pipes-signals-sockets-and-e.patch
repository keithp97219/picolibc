diff --git a/test/test-posix/test-unistd/test-read.c b/test/test-posix/test-unistd/test-read.c
new file mode 100644
index 0000000000..6eea8fdb20
--- /dev/null
+++ b/test/test-posix/test-unistd/test-read.c
@@ -0,0 +1,233 @@
