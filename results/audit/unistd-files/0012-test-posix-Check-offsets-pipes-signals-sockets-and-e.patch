 test/test-posix/test-unistd/CMakeLists.txt    |   1 +
 test/test-posix/test-unistd/meson.build       |   1 +
 test/test-posix/test-unistd/test-read.c       | 233 ++++++++++++++++++
 4 files changed, 237 insertions(+), 1 deletion(-)
 create mode 100644 test/test-posix/test-unistd/test-read.c

diff --git a/test/test-posix/test-pthread/test-pthread_testcancel.c b/test/test-posix/test-pthread/test-pthread_testcancel.c
index 5478a5d406..591b38900d 100644
--- a/test/test-posix/test-pthread/test-pthread_testcancel.c
+++ b/test/test-posix/test-pthread/test-pthread_testcancel.c
@@ -240,7 +240,8 @@ do_poll(void)
 static void
 do_pread(void)
 {
-    (void)pread(-1, buf, 1, 0);
+    /* A bad offset as well: argument checks mustn't skip the cancellation point */
+    (void)pread(-1, buf, 1, -1);
 }
 
