From 9f139a2d19f4ac1c4b2cc2d1ae3fbf86015ccf76 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 03:51:59 +0000
Subject: [PATCH 06/28] libos/linux: Report EPERM from unlink and unlinkat for
 a directory

Linux reports EISDIR. POSIX: "[EPERM] The file named by path is a
directory, and either the calling process does not have appropriate
privileges or the implementation prohibits using unlink() on
directories." unlink now calls unlinkat.
---
 libos/linux/unlink.c   |  8 +++-----
 libos/linux/unlinkat.c | 12 ++++++++++--
 2 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/libos/linux/unlink.c b/libos/linux/unlink.c
index 629d336533..1169d25dba 100644
--- a/libos/linux/unlink.c
+++ b/libos/linux/unlink.c
@@ -34,13 +34,11 @@
  */
 
 #include "local-linux.h"
+#include <fcntl.h>
+#include <unistd.h>
 
 int
 unlink(const char *path)
 {
-#ifdef LINUX_SYS_unlink
-    return _syscall(LINUX_SYS_unlink, path);
-#else
-    return _syscall(LINUX_SYS_unlinkat, LINUX_AT_FDCWD, path, 0);
-#endif
+    return unlinkat(AT_FDCWD, path, 0);
 }
diff --git a/libos/linux/unlinkat.c b/libos/linux/unlinkat.c
index 21ae1d0601..aabd064a4e 100644
--- a/libos/linux/unlinkat.c
+++ b/libos/linux/unlinkat.c
@@ -34,16 +34,24 @@
  */
 
 #include "local-linux.h"
+#include <linux/linux-errno.h>
 #include <unistd.h>
 
 int
 unlinkat(int dirfd, const char *path, int flags)
 {
-    int kflags = _at_flags_to_linux(flags, AT_REMOVEDIR);
+    int  kflags = _at_flags_to_linux(flags, AT_REMOVEDIR);
+    long ret;
 
     if (kflags < 0) {
         errno = EINVAL;
         return -1;
     }
-    return _syscall(LINUX_SYS_unlinkat, _at_fd_to_linux(dirfd), path, kflags);
+    ret = _syscall_raw(LINUX_SYS_unlinkat, _at_fd_to_linux(dirfd), path, kflags);
+    if (ret < 0) {
+        /* Linux reports EISDIR for a directory, where POSIX says EPERM */
+        errno = ret == -LINUX_EISDIR ? EPERM : _syscall_errno(ret);
+        return -1;
+    }
+    return 0;
 }
