 test/test-posix/test-unistd/meson.build       |   1 +
 test/test-posix/test-unistd/test-getentropy.c | 116 ++++++++++++++++++
 3 files changed, 118 insertions(+)
 create mode 100644 test/test-posix/test-unistd/test-getentropy.c

