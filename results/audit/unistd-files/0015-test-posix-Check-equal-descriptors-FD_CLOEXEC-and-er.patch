   'test-execle',
diff --git a/test/test-posix/test-unistd/test-dup2.c b/test/test-posix/test-unistd/test-dup2.c
new file mode 100644
index 0000000000..f395db3865
--- /dev/null
+++ b/test/test-posix/test-unistd/test-dup2.c
@@ -0,0 +1,210 @@
