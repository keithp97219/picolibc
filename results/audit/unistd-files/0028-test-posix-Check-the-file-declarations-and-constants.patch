diff --git a/test/test-posix/test-unistd/test-unistd_h-files.c b/test/test-posix/test-unistd/test-unistd_h-files.c
new file mode 100644
index 0000000000..5bc75b1287
--- /dev/null
+++ b/test/test-posix/test-unistd/test-unistd_h-files.c
@@ -0,0 +1,180 @@
+/*
