+static char long_name[NAME_MAX + 2];
 
 int
 main(void)
 {
-    int         fd;
-    struct stat st;
-    int         ret;
+    struct stat     st;
+    struct timespec old[2] = {
+        { 1000, 0 },
+        { 1000, 0 }
