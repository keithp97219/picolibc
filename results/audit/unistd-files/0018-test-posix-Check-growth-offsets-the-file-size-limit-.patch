+/*
+ * ftruncate and truncate: shrinking, zero-filled growth, offsets, times,
+ * the file size limit, and the errors leaving the file alone
+ */
+
+static char dir[] = "tmp-XXXXXX";
+
+static void
+cleanup(void)
+{
+    (void)unlink("file");
+    (void)unlink("link");
+    (void)unlink("loop");
+    (void)unlink("fifo");
+    (void)chmod("sub", 0700);
+    (void)unlink("sub/file");
+    (void)rmdir("sub");
+    if (chdir("..") == 0)
+        (void)rmdir(dir);
+}
 
-#define check(condition, message)                    \
-    do {                                             \
-        if (!(condition)) {                          \
-            printf("%s: %s\n", message, #condition); \
-            (void)remove(TEST_FILE_NAME);            \
-            exit(1);                                 \
-        }                                            \
+#define check(condition, message)                                                      \
+    do {                                                                               \
+        if (!(condition)) {                                                            \
+            printf("%d: %s: %s (errno %d)\n", __LINE__, (message), #condition, errno); \
+            cleanup();                                                                 \
+            exit(1);                                                                   \
+        }                                                                              \
     } while (0)
 
-#define MESSAGE "hello, world\n"
+#define check_err(expr, err, message) check((errno = 0, (expr) == -1) && errno == (err), message)
 
-#ifdef __PICOLIBC__
-__typeof(ftruncate) __fake_ftruncate __weak;
-#define not_fake(sym) ((sym) != __fake_##sym)
-#else
-#define not_fake(sym) 1
-#endif
+static off_t
+size_of(const char *path)
+{
+    struct stat st;
+
+    check(stat(path, &st) == 0, "stat");
+    return st.st_size;
+}
+
+static volatile sig_atomic_t signals;
+
+static void
+on_signal(int sig)
+{
+    (void)sig;
+    signals++;
+}
