+ * COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT,
+ * INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES
+ * (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
+ * SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT,
+ * STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED
+ * OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#define _POSIX_C_SOURCE 202405L
+/* hcreate, hdestroy and hsearch are XSI interfaces */
+#define _XOPEN_SOURCE 800
+#include "../posix-groups.h"
+
+#include <errno.h>
+#include <search.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(__PICOLIBC_POSIX_MULTI_PROCESS)
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include "../is-qemu.h"
+#endif
+
+/*
+ * hsearch manages one hash table: ENTER adds an item that isn't there
+ * and returns the entry, keeping the first data for a key; FIND only
+ * looks, with strcmp; a null pointer means not found, or full. hdestroy
+ * disposes of the table (including its entries, checked with a data
+ * limit), after which hcreate makes a new, empty one. ENOMEM is checked
+ * in children with no room left for data.
+ */
+
+static int errors;
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            errors++;                                  \
+        }                                              \
+    } while (0)
+
+#define NKEYS 100
+
+static char keys[NKEYS][8];
+
+static ENTRY *
+lookup(const char *key, ACTION action, void *data)
+{
+    char  buf[sizeof(keys[0])];
+    ENTRY item;
+
+    /* A copy of the key: the comparison is strcmp, not the pointer */
+    strcpy(buf, key);
+    item.key = action == FIND ? buf : (char *)key;
+    item.data = data;
+    return hsearch(item, action);
+}
+
+#if defined(__PICOLIBC_POSIX_MULTI_PROCESS)
+
+/* Children have no room to print, so a failed check exits with its number */
+static int step;
+
+#define child_check(condition) \
+    do {                       \
+        step++;                \
+        if (!(condition))      \
+            _exit(step);       \
+    } while (0)
+
+static int
+limit_data(rlim_t cur)
+{
+    struct rlimit rl;
+
+    if (getrlimit(RLIMIT_DATA, &rl) != 0)
+        return -1;
+    rl.rlim_cur = cur;
+    return setrlimit(RLIMIT_DATA, &rl);
+}
+
+#define CYCLES     2000
+#define CYCLE_KEYS 1000
+
+static char cycle_keys[CYCLE_KEYS][8];
+
+/*
+ * hdestroy disposes of the whole table: 2000 tables of 1000 entries
+ * fit in 16MiB only if each is freed
+ */
+static void
+destroy_child(void)
+{
+    int   c, i;
+    ENTRY item;
+
+    for (i = 0; i < CYCLE_KEYS; i++)
+        snprintf(cycle_keys[i], sizeof(cycle_keys[i]), "c%d", i);
+    child_check(limit_data((rlim_t)16 << 20) == 0);
+    for (c = 0; c < CYCLES; c++) {
+        child_check(hcreate(CYCLE_KEYS * 2) != 0);
+        for (i = 0; i < CYCLE_KEYS; i++) {
+            item.key = cycle_keys[i];
+            item.data = NULL;
+            if (hsearch(item, ENTER) == NULL)
+                _exit(100);
+        }
+        hdestroy();
+    }
+    _exit(0);
+}
+
+#define MANY_KEYS 100000
+
+static char many_keys[MANY_KEYS][8];
+
+/* With no room for data, ENTER fails with ENOMEM and FIND still works */
+static void
+enter_child(void)
+{
+    int    i;
+    ENTRY  item;
+    ENTRY *e = NULL;
+
+    for (i = 0; i < MANY_KEYS; i++)
+        snprintf(many_keys[i], sizeof(many_keys[i]), "m%d", i);
+    child_check(hcreate(16) != 0);
+    item.key = many_keys[0];
+    item.data = NULL;
+    child_check(hsearch(item, ENTER) != NULL);
+    child_check(limit_data(1) == 0);
+    for (i = 1; i < MANY_KEYS; i++) {
+        item.key = many_keys[i];
+        errno = 0;
+        e = hsearch(item, ENTER);
+        if (e == NULL)
+            break;
+    }
+    child_check(e == NULL);
+    child_check(errno == ENOMEM);
+    item.key = many_keys[0];
+    child_check(hsearch(item, FIND) != NULL);
+    item.key = many_keys[i - 1];
+    child_check(hsearch(item, FIND) != NULL);
+    item.key = many_keys[i];
+    child_check(hsearch(item, FIND) == NULL);
+    _exit(0);
+}
+
+/* Without room for the table, hcreate returns 0 and sets ENOMEM */
+static void
+create_child(void)
+{
+    int ret;
+
+    child_check(limit_data(1) == 0);
+    errno = 0;
+    ret = hcreate(1000000);
+    child_check(ret == 0);
+    child_check(errno == ENOMEM);
+    _exit(0);
+}
+
+static void
+run_child(void (*f)(void), const char *name)
+{
+    pid_t pid;
+    int   status;
+
+    fflush(stdout);
+    pid = fork();
+    if (pid < 0) {
+        printf("fork failed for %s\n", name);
+        errors++;
+        return;
+    }
+    if (pid == 0)
+        f();
+    if (waitpid(pid, &status, 0) != pid || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        printf("%s: child failed (status 0x%x)\n", name, (unsigned)status);
+        errors++;
+    }
+}
+
+#endif /* __PICOLIBC_POSIX_MULTI_PROCESS */
+
+int
+main(void)
+{
+    int    i, total;
+    ENTRY *e, *e2;
+    char   other[] = "k1";
+
+    for (i = 0; i < NKEYS; i++)
+        snprintf(keys[i], sizeof(keys[i]), "k%d", i);
+
+    check(hcreate(NKEYS * 2) != 0, "hcreate");
+
+    /* ENTER returns the new entry, holding the item's key and data */
+    for (i = 0; i < NKEYS; i++) {
+        e = lookup(keys[i], ENTER, &keys[i]);
+        check(e != NULL && strcmp(e->key, keys[i]) == 0 && e->data == &keys[i], "ENTER new");
+    }
+
+    /* FIND compares with strcmp, so a copy of the key finds the entry */
+    for (i = 0; i < NKEYS; i++) {
+        e = lookup(keys[i], FIND, NULL);
+        check(e != NULL && strcmp(e->key, keys[i]) == 0 && e->data == &keys[i], "FIND");
+    }
+
+    /* The entry stays where it is: the same pointer each time */
+    e = lookup("k7", FIND, NULL);
+    e2 = lookup("k7", FIND, NULL);
+    check(e != NULL && e == e2, "same entry");
+
+    /* ENTER of a key that's there finds it and doesn't replace its data */
+    e = lookup(other, ENTER, other);
+    check(e != NULL && e->data == &keys[1] && e->key == keys[1], "ENTER existing");
+
+    /* Keys that aren't there, including prefixes and extensions */
+    check(lookup("k", FIND, NULL) == NULL, "missing prefix");
+    check(lookup("k10x", FIND, NULL) == NULL, "missing extension");
+    check(lookup("K1", FIND, NULL) == NULL, "case");
+    check(lookup("", FIND, NULL) == NULL, "empty key");
+
+    /* FIND doesn't add anything */
+    check(lookup("zz", FIND, NULL) == NULL && lookup("zz", FIND, NULL) == NULL,
+          "FIND adds nothing");
+
+    /* The empty string is a key like any other */
+    e = lookup("", ENTER, &total);
+    check(e != NULL && e->data == &total, "ENTER empty key");
+    check(lookup("", FIND, NULL) == e, "FIND empty key");
+
+    /* hdestroy disposes of the table; hcreate makes a new, empty one */
+    hdestroy();
+    check(hcreate(4) != 0, "hcreate after hdestroy");
+    for (i = 0; i < NKEYS; i++)
+        check(lookup(keys[i], FIND, NULL) == NULL, "empty after hdestroy");
+
+    /*
+     * nel is only an estimate: entering more items either works or,
+     * when the table is full, returns a null pointer (setting ENOMEM),
+     * and every item that went in can be found
+     */
+    total = 0;
+    for (i = 0; i < NKEYS; i++) {
+        errno = 0;
+        e = lookup(keys[i], ENTER, &keys[i]);
+        if (e == NULL) {
+            check(errno == ENOMEM, "full table");
+            break;
+        }
+        total++;
+    }
+    for (i = 0; i < total; i++) {
+        e = lookup(keys[i], FIND, NULL);
+        check(e != NULL && e->data == &keys[i], "FIND past the estimate");
+    }
+    if (total < NKEYS)
+        printf("table full after %d entries\n", total);
+    hdestroy();
+
+#if defined(__PICOLIBC_POSIX_MULTI_PROCESS)
+    /* qemu-user doesn't apply RLIMIT_DATA */
+    if (is_qemu()) {
+        printf("qemu: skipping the RLIMIT_DATA checks\n");
+    } else {
+        run_child(destroy_child, "hdestroy frees the entries");
+        run_child(enter_child, "ENTER without memory");
+        run_child(create_child, "hcreate without memory");
+    }
+#endif
+
+    if (errors) {
+        printf("%d errors\n", errors);
+        return 1;
+    }
+    printf("success\n");
+    return 0;
+}
diff --git a/test/test-posix/test-search/test-insque.c b/test/test-posix/test-search/test-insque.c
index dc2ef5dd18..34f93ba6af 100644
--- a/test/test-posix/test-search/test-insque.c
+++ b/test/test-posix/test-search/test-insque.c
@@ -39,8 +39,14 @@
 #include <search.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 
-/* insque links elements into doubly-linked lists */
+/*
+ * insque links elements into doubly-linked lists, linear (ended by null
+ * pointers, started with insque(&e, NULL)) or circular (started by
+ * pointing the first element at itself), after the given predecessor,
+ * whatever the structure's names and further members are
+ */
 
 #define check(condition, message)                      \
     do {                                               \
@@ -55,17 +61,53 @@ struct elem {
     int          value;
 };
 
+/* Any names, and more members after the two pointers */
+struct other {
+    struct other *fwd;
+    struct other *back;
+    char          payload[13];
+};
+
 int
 main(void)
 {
-    struct elem a = { .value = 1 }, b = { .value = 2 }, c = { .value = 3 };
+    struct elem  a = { .value = 1 }, b = { .value = 2 }, c = { .value = 3 }, d = { .value = 4 };
+    struct other x, y;
 
+    /* A linear list: insque(&a, NULL) clears both pointers */
+    a.next = a.prev = &d;
     insque(&a, NULL);
     check(a.next == NULL && a.prev == NULL, "new list");
     insque(&c, &a);
     insque(&b, &a);
     check(a.next == &b && b.next == &c && c.next == NULL, "forward links");
     check(c.prev == &b && b.prev == &a && a.prev == NULL, "backward links");
+
+    /* Inserting after the last element */
+    insque(&d, &c);
+    check(c.next == &d && d.prev == &c && d.next == NULL, "insert at the end");
+    check(a.value == 1 && b.value == 2 && c.value == 3 && d.value == 4, "values untouched");
+
+    /* A circular list of one element pointing at itself */
+    a.next = a.prev = &a;
+    insque(&b, &a);
+    check(a.next == &b && b.next == &a && a.prev == &b && b.prev == &a, "circular two");
+    insque(&c, &b);
+    check(a.next == &b && b.next == &c && c.next == &a, "circular forward");
+    check(a.prev == &c && c.prev == &b && b.prev == &a, "circular backward");
+    insque(&d, &a);
+    check(a.next == &d && d.next == &b && b.prev == &d && d.prev == &a, "circular middle");
+
+    /* Other member names, and data after the pointers */
+    memset(x.payload, 'x', sizeof(x.payload));
+    memset(y.payload, 'y', sizeof(y.payload));
+    insque(&x, NULL);
+    insque(&y, &x);
+    check(x.fwd == &y && y.back == &x && y.fwd == NULL && x.back == NULL, "other names");
+    check(x.payload[0] == 'x' && x.payload[12] == 'x' && y.payload[0] == 'y'
+              && y.payload[12] == 'y',
+          "payload untouched");
+
     printf("success\n");
     return 0;
 }
diff --git a/test/test-posix/test-search/test-lfind.c b/test/test-posix/test-search/test-lfind.c
index 5a543309cf..e5687d57ad 100644
--- a/test/test-posix/test-search/test-lfind.c
+++ b/test/test-posix/test-search/test-lfind.c
@@ -56,6 +56,14 @@ cmp(const void *a, const void *b)
     return *(const int *)a - *(const int *)b;
 }
 
+static int
+ne(const void *a, const void *b)
+{
+    return *(const int *)a != *(const int *)b;
+}
+
+static const int ca[] = { 1, 3, 3, 7 };
+
 int
 main(void)
 {
@@ -70,6 +78,16 @@ main(void)
     n = 0;
     key = 5;
     check(lfind(&key, a, &n, sizeof(int), cmp) == NULL, "empty");
+    check(n == 0, "empty count unchanged");
+
+    /* Only equality matters: a comparison returning 1 for any difference */
+    n = 4;
+    key = 9;
+    check(lfind(&key, a, &n, sizeof(int), ne) == &a[2] && n == 4, "non-zero means different");
+
+    /* Searching a table of a const type */
+    key = 3;
+    check(lfind(&key, ca, &n, sizeof(int), cmp) == &ca[1], "const table");
     printf("success\n");
     return 0;
 }
diff --git a/test/test-posix/test-search/test-lsearch.c b/test/test-posix/test-search/test-lsearch.c
index d4a696a608..0b24848311 100644
--- a/test/test-posix/test-search/test-lsearch.c
+++ b/test/test-posix/test-search/test-lsearch.c
@@ -39,6 +39,7 @@
 #include <search.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 
 /* lsearch finds an element, appending it when missing */
 
@@ -56,16 +57,66 @@ cmp(const void *a, const void *b)
     return *(const int *)a - *(const int *)b;
 }
 
+/* Elements of an odd width; equality only, so any non-zero means different */
+struct rec {
+    char name[3];
+    char extra[4];
+};
+
+static const void *rec_key;
+static int         rec_bad;
+
+static int
+rec_cmp(const void *a, const void *b)
+{
+    if (a != rec_key && b != rec_key)
+        rec_bad++;
+    return memcmp(a, b, 3) != 0;
+}
+
+static void
+set_rec(struct rec *r, const char *name, const char *extra)
+{
+    memcpy(r->name, name, sizeof(r->name));
+    memcpy(r->extra, extra, sizeof(r->extra));
+}
+
 int
 main(void)
 {
     int    a[4] = { 5, 3 }, key;
     size_t n = 2;
+    struct rec  recs[4] = { { "ab", "123" }, { "cd", "456" } }, rk;
+    struct rec *r;
 
     key = 3;
     check(lsearch(&key, a, &n, sizeof(int), cmp) == &a[1] && n == 2, "found");
     key = 8;
     check(lsearch(&key, a, &n, sizeof(int), cmp) == &a[2] && n == 3 && a[2] == 8, "appended");
+    key = 8;
+    check(lsearch(&key, a, &n, sizeof(int), cmp) == &a[2] && n == 3, "found after appending");
+
+    /* The whole element is copied to the end, and found from then on */
+    _Static_assert(sizeof(struct rec) == 7, "odd width");
+    n = 2;
+    set_rec(&rk, "ef", "789");
+    rec_key = &rk;
+    r = lsearch(&rk, recs, &n, sizeof(struct rec), rec_cmp);
+    check(r == &recs[2] && n == 3, "odd width appended");
+    check(memcmp(&recs[2], &rk, sizeof(rk)) == 0, "whole element copied");
+    check(memcmp(recs[0].extra, "123", 4) == 0 && memcmp(recs[1].extra, "456", 4) == 0,
+          "others untouched");
+    set_rec(&rk, "cd", "xyz");
+    r = lsearch(&rk, recs, &n, sizeof(struct rec), rec_cmp);
+    check(r == &recs[1] && n == 3 && memcmp(recs[1].extra, "456", 4) == 0, "found, not replaced");
+    check(rec_bad == 0, "compar sees the key");
+
+    /* An empty table gets the key as its first element */
+    n = 0;
+    set_rec(&rk, "gh", "000");
+    r = lsearch(&rk, recs, &n, sizeof(struct rec), rec_cmp);
+    check(r == &recs[0] && n == 1 && memcmp(&recs[0], &rk, sizeof(rk)) == 0, "empty table");
+
     printf("success\n");
     return 0;
 }
diff --git a/test/test-posix/test-search/test-remque.c b/test/test-posix/test-search/test-remque.c
index c66079a5e5..f5f2148e90 100644
--- a/test/test-posix/test-search/test-remque.c
+++ b/test/test-posix/test-search/test-remque.c
@@ -40,7 +40,10 @@
 #include <stdio.h>
 #include <stdlib.h>
 
-/* remque unlinks elements from doubly-linked lists */
+/*
+ * remque unlinks elements from doubly-linked lists, linear or circular,
+ * at the head, the tail or in the middle, leaving the rest linked
+ */
 
 #define check(condition, message)                      \
     do {                                               \
@@ -57,16 +60,33 @@ struct elem {
 int
 main(void)
 {
-    struct elem a, b, c;
+    struct elem a, b, c, d;
 
+    /* Linear: middle, head, tail, and the last one */
     insque(&a, NULL);
     insque(&b, &a);
     insque(&c, &b);
+    insque(&d, &c);
     remque(&b);
     check(a.next == &c && c.prev == &a, "middle removed");
     remque(&a);
-    check(c.prev == NULL, "head removed");
+    check(c.prev == NULL && c.next == &d && d.prev == &c, "head removed");
+    remque(&d);
+    check(c.next == NULL && c.prev == NULL, "tail removed");
+    remque(&c);
+
+    /* Circular */
+    a.next = a.prev = &a;
+    insque(&b, &a);
+    insque(&c, &b);
+    insque(&d, &c);
     remque(&c);
+    check(b.next == &d && d.prev == &b, "circular middle removed");
+    remque(&a);
+    check(d.next == &b && b.prev == &d && b.next == &d && d.prev == &b, "circular head removed");
+    remque(&d);
+    check(b.next == &b && b.prev == &b, "circular down to one");
+
     printf("success\n");
     return 0;
 }
