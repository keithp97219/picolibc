From 46c0d799d73780d065f41d1ccc8b15a1dd429b6c Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 08:03:19 +0000
Subject: [PATCH 08/10] search: Keep dbm_nextkey at the end of the database

Once the scan reached the end, the next R_NEXT started it again from
the first key, so dbm_nextkey after the end returned keys already
returned. Stay at the end until R_FIRST restarts the scan.
---
 libc/search/hash.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/libc/search/hash.c b/libc/search/hash.c
index b74dad2386..e212540a03 100644
--- a/libc/search/hash.c
+++ b/libc/search/hash.c
@@ -704,10 +704,13 @@ hash_seq(const DB *dbp, DBT *key, DBT *data, u_int flag)
 #ifdef HASH_STATISTICS
     hash_accesses++;
 #endif
-    if ((hashp->cbucket < 0) || (flag == R_FIRST)) {
+    if (flag == R_FIRST) {
         hashp->cbucket = 0;
         hashp->cndx = 1;
         hashp->cpage = NULL;
+    } else if (hashp->cbucket < 0) {
+        /* Past the end, the scan stays there until it is restarted */
+        return (ABNORMAL);
     }
 
     for (bp = NULL; !bp || !bp[0];) {
-- 
