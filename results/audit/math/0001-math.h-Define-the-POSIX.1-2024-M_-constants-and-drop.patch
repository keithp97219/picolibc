From 2a4169aab72f0930e2ac569464d3ebfa6360053d Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 08:12:40 +0000
Subject: [PATCH 01/15] math.h: Define the POSIX.1-2024 M_ constants and drop
 MAXFLOAT

Issue 8 adds M_EGAMMA, M_PHI, M_1_SQRTPI, M_SQRT3 and M_SQRT1_3, and a
long double form ending in 'l' of every M_ constant, all XSI. picolibc
had M_SQRT3 only for BSD, with a value wrong in the 17th digit, and
the four long double ones it had only for _GNU_SOURCE. Issue 8 also
removes MAXFLOAT, so hide it for _XOPEN_SOURCE 800.

Signed-off-by: Keith Packard <keithp@keithp.com>
---
 libc/include/math.h | 75 ++++++++++++++++++++++++++++-----------------
 1 file changed, 47 insertions(+), 28 deletions(-)

diff --git a/libc/include/math.h b/libc/include/math.h
index 3eec0081e8..60b709fff0 100644
--- a/libc/include/math.h
+++ b/libc/include/math.h
@@ -884,35 +884,55 @@ int(isnan)(double __x) __picolibc_export;
 
 /* Useful constants.  */
 
-#if __BSD_VISIBLE || __XSI_VISIBLE
+/* MAXFLOAT is obsolescent in Issue 7 and removed in Issue 8 */
+#if __BSD_VISIBLE || (__XSI_VISIBLE && __XSI_VISIBLE < 800)
+#define MAXFLOAT 3.40282347e+38F
+#endif
 
-#define MAXFLOAT   3.40282347e+38F
-
-#define M_E        2.7182818284590452354
-#define _M_E_L     2.718281828459045235360287471352662498L
-#define M_LOG2E    1.4426950408889634074
-#define M_LOG10E   0.43429448190325182765
-#define M_LN2      _M_LN2
-#define M_LN10     2.30258509299404568402
-#define M_PI       3.14159265358979323846
-#define _M_PI_L    3.141592653589793238462643383279502884L
-#define M_PI_2     1.57079632679489661923
-#define _M_PI_2    1.57079632679489661923
-#define _M_PI_2L   1.570796326794896619231321691639751442L
-#define M_PI_4     0.78539816339744830962
-#define _M_PI_4L   0.785398163397448309615660845819875721L
-#define M_1_PI     0.31830988618379067154
-#define M_2_PI     0.63661977236758134308
-#define M_2_SQRTPI 1.12837916709551257390
-#define M_SQRT2    1.41421356237309504880
-#define M_SQRT1_2  0.70710678118654752440
+#if __BSD_VISIBLE || __XSI_VISIBLE
 
-#if __GNU_VISIBLE
-#define M_PIl   _M_PI_L
-#define M_PI_2l _M_PI_2L
-#define M_PI_4l _M_PI_4L
-#define M_El    _M_E_L
-#endif
+#define M_E         2.7182818284590452354
+#define _M_E_L      2.718281828459045235360287471352662498L
+#define M_EGAMMA    0.57721566490153286061
+#define M_LOG2E     1.4426950408889634074
+#define M_LOG10E    0.43429448190325182765
+#define M_LN2       _M_LN2
+#define M_LN10      2.30258509299404568402
+#define M_PHI       1.61803398874989484820
+#define M_PI        3.14159265358979323846
+#define _M_PI_L     3.141592653589793238462643383279502884L
+#define M_PI_2      1.57079632679489661923
+#define _M_PI_2     1.57079632679489661923
+#define _M_PI_2L    1.570796326794896619231321691639751442L
+#define M_PI_4      0.78539816339744830962
+#define _M_PI_4L    0.785398163397448309615660845819875721L
+#define M_1_PI      0.31830988618379067154
+#define M_1_SQRTPI  0.56418958354775628695
+#define M_2_PI      0.63661977236758134308
+#define M_2_SQRTPI  1.12837916709551257390
+#define M_SQRT2     1.41421356237309504880
+#define M_SQRT3     1.73205080756887729353
+#define M_SQRT1_2   0.70710678118654752440
+#define M_SQRT1_3   0.57735026918962576451
+
+#define M_El        _M_E_L
+#define M_EGAMMAl   0.577215664901532860606512090082402431L
+#define M_LOG2El    1.442695040888963407359924681001892137L
+#define M_LOG10El   0.434294481903251827651128918916605082L
+#define M_LN2l      _M_LN2_LD
+#define M_LN10l     2.302585092994045684017991454684364208L
+#define M_PHIl      1.618033988749894848204586834365638118L
+#define M_PIl       _M_PI_L
+#define M_PI_2l     _M_PI_2L
+#define M_PI_4l     _M_PI_4L
+#define M_1_PIl     0.318309886183790671537767526745028724L
+#define M_1_SQRTPIl 0.564189583547756286948079451560772586L
+#define M_2_PIl     0.636619772367581343075535053490057448L
+#define M_2_SQRTPIl 1.128379167095512573896158903121545172L
+#define M_SQRT2l    1.414213562373095048801688724209698079L
+#define M_SQRT3l    1.732050807568877293527446341505872367L
+#define M_SQRT1_2l  0.707106781186547524400844362104849039L
+#define M_SQRT1_3l  0.577350269189625764509148780501957456L
 
 #endif
 
@@ -923,7 +943,6 @@ int(isnan)(double __x) __picolibc_export;
 #define M_SQRTPI   1.77245385090551602792981
 #define M_LN2LO    1.9082149292705877000E-10
 #define M_LN2HI    6.9314718036912381649E-1
-#define M_SQRT3    1.73205080756887719000
 #define M_IVLN10   0.43429448190325182765 /* 1 / log(10) */
 #define _M_IVLN10L 0.43429448190325182765112891891660508229439700580366656611445378316586464920887L
 #define M_LOG2_E   _M_LN2
-- 
2.47.3

