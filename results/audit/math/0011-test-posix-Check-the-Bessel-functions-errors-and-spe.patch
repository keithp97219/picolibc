 test/test-posix/test-math/meson.build      |   8 +
 test/test-posix/test-math/test-j0-errors.c | 216 ++++++++++++++++++++
 test/test-posix/test-math/test-y0-errors.c | 226 +++++++++++++++++++++
 4 files changed, 452 insertions(+)
 create mode 100644 test/test-posix/test-math/test-j0-errors.c
 create mode 100644 test/test-posix/test-math/test-y0-errors.c

