From b4cfad3c1da6ca9c6931ddacb395d66865bb59b9 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 08:13:26 +0000
Subject: [PATCH 12/15] test-posix: Check signgam and lgamma's special values
 and errors

The sign of Gamma(x) in signgam from lgamma, lgammaf and lgammal, +0
from 1 and 2, +Inf from +-Inf, the poles at zero and the negative
integers and the overflow.

Signed-off-by: Keith Packard <keithp@keithp.com>
---
 test/test-posix/test-math/CMakeLists.txt |   1 +
 test/test-posix/test-math/meson.build    |   2 +
 test/test-posix/test-math/test-signgam.c | 248 +++++++++++++++++++++++
 3 files changed, 251 insertions(+)
 create mode 100644 test/test-posix/test-math/test-signgam.c

diff --git a/test/test-posix/test-math/CMakeLists.txt b/test/test-posix/test-math/CMakeLists.txt
index 25f1f4cc26..b2abc80828 100644
--- a/test/test-posix/test-math/CMakeLists.txt
+++ b/test/test-posix/test-math/CMakeLists.txt
@@ -37,6 +37,7 @@ set(tests
   test-j0-errors
   test-math_h
   test-math_h-names
+  test-signgam
   test-y0-errors
   )
 
diff --git a/test/test-posix/test-math/meson.build b/test/test-posix/test-math/meson.build
index 0bb5f3ef80..bd37fd7c1d 100644
--- a/test/test-posix/test-math/meson.build
+++ b/test/test-posix/test-math/meson.build
@@ -37,11 +37,13 @@ dir_tests = [
   'test-j0-errors',
   'test-math_h',
   'test-math_h-names',
+  'test-signgam',
   'test-y0-errors',
 ]
 
 # Keep the compiler from evaluating the functions itself
 test_extra_c_args += {
   'test-j0-errors': ['-fno-builtin'],
+  'test-signgam': ['-fno-builtin'],
   'test-y0-errors': ['-fno-builtin'],
 }
diff --git a/test/test-posix/test-math/test-signgam.c b/test/test-posix/test-math/test-signgam.c
new file mode 100644
index 0000000000..c18177e875
--- /dev/null
+++ b/test/test-posix/test-math/test-signgam.c
@@ -0,0 +1,248 @@
