+
+#define _POSIX_C_SOURCE 202405L
+/* signgam is XSI */
+#define _XOPEN_SOURCE 800
+#include <math.h>
+
+#include <errno.h>
+#include <fenv.h>
+#include <float.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/* Without an exception, the checks of it pass trivially */
+#ifndef FE_DIVBYZERO
+#define FE_DIVBYZERO 0
+#endif
+#ifndef FE_INEXACT
+#define FE_INEXACT 0
+#endif
+#ifndef FE_INVALID
+#define FE_INVALID 0
+#endif
+#ifndef FE_OVERFLOW
+#define FE_OVERFLOW 0
+#endif
+#ifndef FE_UNDERFLOW
+#define FE_UNDERFLOW 0
+#endif
+
+/* lgamma, lgammaf and lgammal: signgam, the special values and the errors */
+
+#define check(condition, message)                      \
+    do {                                               \
+        if (!(condition)) {                            \
+            printf("%s: %s\n", (message), #condition); \
+            exit(1);                                   \
+        }                                              \
+    } while (0)
+
+#define ERROR_EXCEPTS (FE_INVALID | FE_DIVBYZERO | FE_OVERFLOW | FE_UNDERFLOW)
+
+static int    got_errno, got_except;
+static double got;
+
+/* Call expr with errno and the exception flags cleared, and note what it left */
+#define CALL(expr)                                \
+    do {                                          \
+        errno = 0;                                \
+        feclearexcept(FE_ALL_EXCEPT);             \
+        got = (double)(expr);                     \
+        got_except = fetestexcept(FE_ALL_EXCEPT); \
+        got_errno = errno;                        \
+    } while (0)
+
+/*
+ * A "may fail" error: when the implementation reports it, errno is
+ * err and the exception is except; no other error is reported.
+ */
+static int
+may_error(const char *what, int err, int except)
+{
+    int ok = 1;
+
+    if ((math_errhandling & MATH_ERRNO) && got_errno != 0 && got_errno != err) {
+        printf("%s: errno %d, expected 0 or %d\n", what, got_errno, err);
+        ok = 0;
+    }
+    if ((math_errhandling & MATH_ERREXCEPT) && (got_except & ERROR_EXCEPTS & ~except) != 0) {
+        printf("%s: exceptions 0x%x, expected only 0x%x\n", what, got_except, except);
+        ok = 0;
+    }
+    return ok;
+}
+
+/* No error: errno untouched and no error exception */
+static int
+no_error(const char *what)
+{
+    return may_error(what, 0, 0);
+}
+
+/* A "shall fail" error: reported as errno err and exception except */
+static int
+must_error(const char *what, int err, int except)
+{
+    int ok = 1;
+
+    if ((math_errhandling & MATH_ERRNO) && got_errno != err) {
+        printf("%s: errno %d, expected %d\n", what, got_errno, err);
+        ok = 0;
+    }
+    if ((math_errhandling & MATH_ERREXCEPT) && (got_except & ERROR_EXCEPTS) != except) {
+        printf("%s: exceptions 0x%x, expected 0x%x\n", what, got_except, except);
+        ok = 0;
+    }
+    return ok;
+}
+
+static volatile double      vzero = 0.0;
+static volatile float       vzerof = 0.0f;
+static volatile long double vzerol = 0.0L;
+
+static const struct {
+    double x;
+    int    sign;
+} signs[] = {
+    { 0.5,      1  },
+    { 3.0,      1  },
+    { 1e10,     1  },
+    { 0x1p-60,  1  },
+    { -0.5,     -1 },
+    { -1.5,     1  },
+    { -2.5,     -1 },
+    { -3.25,    1  },
+    { -6.5,     -1 },
+    { -7.5,     1  },
+    { -0x1p-60, -1 },
+};
+
+#define NSIGNS (sizeof(signs) / sizeof(signs[0]))
+
+int
+main(void)
+{
+    unsigned i;
+    char     what[48];
+
+    /* The sign of Gamma(x) goes in signgam, for each type */
+    for (i = 0; i < NSIGNS; i++) {
+        volatile double      x = signs[i].x;
+        volatile float       xf = (float)signs[i].x;
+        volatile long double xl = (long double)signs[i].x;
+
+        signgam = 0;
+        (void)lgamma(x);
+        if (signgam != signs[i].sign) {
+            printf("lgamma(%g): signgam %d, expected %d\n", signs[i].x, signgam, signs[i].sign);
+            exit(1);
+        }
+        signgam = 0;
+        (void)lgammaf(xf);
+        if (signgam != signs[i].sign) {
+            printf("lgammaf(%g): signgam %d, expected %d\n", signs[i].x, signgam, signs[i].sign);
+            exit(1);
+        }
+        signgam = 0;
+        (void)lgammal(xl);
+        if (signgam != signs[i].sign) {
+            printf("lgammal(%g): signgam %d, expected %d\n", signs[i].x, signgam, signs[i].sign);
+            exit(1);
+        }
+    }
+
+    /* The value doesn't depend on the sign: lgamma(-0.5) is log(2 sqrt(pi)) */
+    CALL(lgamma(-0.5 + vzero));
+    check(fabs(got - 1.2655121234846454) < 1e-15 && no_error("lgamma(-0.5)"), "lgamma(-0.5)");
+
+    /* 1 and 2 give +0 */
+    CALL(lgamma(1.0 + vzero));
+    check(got == 0 && !signbit(got) && no_error("lgamma(1)"), "lgamma(1)");
+    CALL(lgamma(2.0 + vzero));
+    check(got == 0 && !signbit(got) && no_error("lgamma(2)"), "lgamma(2)");
+    CALL(lgammaf(1.0f + vzerof));
+    check(got == 0 && !signbit(got) && no_error("lgammaf(1)"), "lgammaf(1)");
+    CALL(lgammaf(2.0f + vzerof));
+    check(got == 0 && !signbit(got) && no_error("lgammaf(2)"), "lgammaf(2)");
+    CALL((double)lgammal(1.0L + vzerol));
+    check(got == 0 && !signbit(got) && no_error("lgammal(1)"), "lgammal(1)");
+    CALL((double)lgammal(2.0L + vzerol));
+    check(got == 0 && !signbit(got) && no_error("lgammal(2)"), "lgammal(2)");
+
+    /* +-Inf give +Inf, NaN gives NaN */
+    CALL(lgamma(HUGE_VAL + vzero));
+    check(got == HUGE_VAL && no_error("lgamma(Inf)"), "lgamma(Inf)");
+    CALL(lgamma(-HUGE_VAL + vzero));
+    check(got == HUGE_VAL && no_error("lgamma(-Inf)"), "lgamma(-Inf)");
+    CALL(lgamma((double)NAN + vzero));
+    check(isnan(got) && no_error("lgamma(NaN)"), "lgamma(NaN)");
+
+    /* Zero and negative integers are poles, giving +HUGE_VAL */
+    {
+        static const double poles[] = { 0.0, -0.0, -1.0, -2.0, -3.0, -100.0, -0x1p60 };
+
+        for (i = 0; i < sizeof(poles) / sizeof(poles[0]); i++) {
+            volatile double      x = poles[i];
+            volatile float       xf = (float)poles[i];
+            volatile long double xl = (long double)poles[i];
+
+            snprintf(what, sizeof(what), "lgamma(%g)", poles[i]);
+            CALL(lgamma(x));
+            check(got == HUGE_VAL && must_error(what, ERANGE, FE_DIVBYZERO), "lgamma pole");
+            snprintf(what, sizeof(what), "lgammaf(%g)", poles[i]);
+            CALL(lgammaf(xf));
+            check(got == (double)HUGE_VALF && must_error(what, ERANGE, FE_DIVBYZERO),
+                  "lgammaf pole");
+            snprintf(what, sizeof(what), "lgammal(%g)", poles[i]);
+            CALL((double)lgammal(xl));
+            check(got == HUGE_VAL && must_error(what, ERANGE, FE_DIVBYZERO), "lgammal pole");
+        }
+    }
+
+    /* Overflow is a range error giving +HUGE_VAL */
+    CALL(lgamma(DBL_MAX + vzero));
+    check(got == HUGE_VAL && must_error("lgamma(DBL_MAX)", ERANGE, FE_OVERFLOW), "lgamma(DBL_MAX)");
+    CALL(lgammaf(FLT_MAX + vzerof));
+    check(got == (double)HUGE_VALF && must_error("lgammaf(FLT_MAX)", ERANGE, FE_OVERFLOW),
+          "lgammaf(FLT_MAX)");
+    CALL((double)lgammal(LDBL_MAX + vzerol));
+    check(got == HUGE_VAL && must_error("lgammal(LDBL_MAX)", ERANGE, FE_OVERFLOW),
+          "lgammal(LDBL_MAX)");
+
+    printf("success\n");
+    return 0;
+}
-- 
