 test/test-posix/test-math/meson.build        |   2 +
 test/test-posix/test-math/test-remquo-type.h | 287 +++++++++++++++++++
 test/test-posix/test-math/test-remquo.c      | 230 +++++++++++++++
 4 files changed, 520 insertions(+)
 create mode 100644 test/test-posix/test-math/test-remquo-type.h
 create mode 100644 test/test-posix/test-math/test-remquo.c

