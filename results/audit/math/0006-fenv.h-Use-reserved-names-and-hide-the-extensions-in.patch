From 0674048667efeb4ee3df2aaec79446a6d47ba360 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 08:12:50 +0000
Subject: [PATCH 06/15] fenv.h: Use reserved names, and hide the extensions in
 strict mode

<fenv.h>'s prototypes and arm's and the soft-float inline functions
named their parameters excepts, flagp, envp and round, and femode_t
its members round and except, so an application macro of one of those
names broke the header. Use names starting with __.

The inline feenableexcept, fedisableexcept and fegetexcept were
defined for every compilation on aarch64 and arm (and for BSD in the
soft-float header), and fesetexcept, new in C23, for every C version.
Define them for _GNU_SOURCE and C23 respectively, as the prototypes
are, and in libm/fenv/fenv.c, which defines
the out-of-line copies.

Signed-off-by: Keith Packard <keithp@keithp.com>
---
 libc/include/fenv.h                    | 34 +++++++--------
 libc/include/machine/fenv-softfloat.h  | 58 ++++++++++++++------------
 libc/machine/aarch64/machine/fenv-fp.h | 10 ++++-
 libc/machine/arm/machine/fenv-fp.h     | 58 +++++++++++++++-----------
 libm/fenv/fegetmode.c                  |  4 +-
 libm/fenv/fenv.c                       |  2 +
 libm/fenv/fesetmode.c                  |  4 +-
 7 files changed, 95 insertions(+), 75 deletions(-)

diff --git a/libc/include/fenv.h b/libc/include/fenv.h
index a0a905b34f..8fea294189 100644
--- a/libc/include/fenv.h
+++ b/libc/include/fenv.h
@@ -27,9 +27,9 @@ _BEGIN_STD_C
 #ifdef __declare_fenv_inline
 
 #if __ISO_C_VISIBLE >= 2023
-__declare_fenv_inline(int) fetestexceptflag(const fexcept_t *flagp, int excepts)
+__declare_fenv_inline(int) fetestexceptflag(const fexcept_t *__flagp, int __excepts)
 {
-    return *flagp & excepts & FE_ALL_EXCEPT;
+    return *__flagp & __excepts & FE_ALL_EXCEPT;
 }
 #endif
 
@@ -39,25 +39,25 @@ __declare_fenv_inline(int) fetestexceptflag(const fexcept_t *flagp, int excepts)
  * already provided inline definitions via __declare_fenv_inline. */
 
 /* Exception */
-int feclearexcept(int excepts) __picolibc_export;
-int fegetexceptflag(fexcept_t *flagp, int excepts) __picolibc_export;
-int feraiseexcept(int excepts) __picolibc_export;
-int fesetexcept(int excepts) __picolibc_export;
-int fesetexceptflag(const fexcept_t *flagp, int excepts) __picolibc_export;
-int fetestexcept(int excepts) __picolibc_export;
+int feclearexcept(int __excepts) __picolibc_export;
+int fegetexceptflag(fexcept_t *__flagp, int __excepts) __picolibc_export;
+int feraiseexcept(int __excepts) __picolibc_export;
+int fesetexceptflag(const fexcept_t *__flagp, int __excepts) __picolibc_export;
+int fetestexcept(int __excepts) __picolibc_export;
 #if __ISO_C_VISIBLE >= 2023
-int fetestexceptflag(const fexcept_t *flagp, int excepts) __picolibc_export;
+int fesetexcept(int __excepts) __picolibc_export;
+int fetestexceptflag(const fexcept_t *__flagp, int __excepts) __picolibc_export;
 #endif
 
 /* Rounding mode */
 int fegetround(void) __picolibc_export;
-int fesetround(int rounding_mode) __picolibc_export;
+int fesetround(int __round) __picolibc_export;
 
 /* Float environment */
-int fegetenv(fenv_t *envp) __picolibc_export;
-int feholdexcept(fenv_t *envp) __picolibc_export;
-int fesetenv(const fenv_t *envp) __picolibc_export;
-int feupdateenv(const fenv_t *envp) __picolibc_export;
+int fegetenv(fenv_t *__envp) __picolibc_export;
+int feholdexcept(fenv_t *__envp) __picolibc_export;
+int fesetenv(const fenv_t *__envp) __picolibc_export;
+int feupdateenv(const fenv_t *__envp) __picolibc_export;
 
 #if __GNU_VISIBLE
 int feenableexcept(int) __picolibc_export;
@@ -84,13 +84,13 @@ extern __picolibc_export fenv_t _fe_dfl_env;
 
 #ifndef FE_DFL_MODE
 typedef struct {
-    int round, except;
+    int __round, __except;
 } femode_t;
 #define FE_DFL_MODE ((femode_t *)0)
 #endif
 
-int fegetmode(femode_t *modep) __picolibc_export;
-int fesetmode(femode_t *modep) __picolibc_export;
+int fegetmode(femode_t *__modep) __picolibc_export;
+int fesetmode(femode_t *__modep) __picolibc_export;
 
 #endif
 
diff --git a/libc/include/machine/fenv-softfloat.h b/libc/include/machine/fenv-softfloat.h
index cd7e141581..9b6dd8fea6 100644
--- a/libc/include/machine/fenv-softfloat.h
+++ b/libc/include/machine/fenv-softfloat.h
@@ -51,39 +51,42 @@
  */
 #include <errno.h>
 
-__declare_fenv_inline(int) feclearexcept(int excepts)
+__declare_fenv_inline(int) feclearexcept(int __excepts)
 {
-    (void)excepts;
+    (void)__excepts;
     return (0);
 }
 
-__declare_fenv_inline(int) fegetexceptflag(fexcept_t *flagp, int excepts)
+__declare_fenv_inline(int) fegetexceptflag(fexcept_t *__flagp, int __excepts)
 {
-    (void)excepts;
-    (void)flagp;
+    (void)__excepts;
+    (void)__flagp;
     return (0);
 }
 
-__declare_fenv_inline(int) fesetexceptflag(const fexcept_t *flagp, int excepts)
+__declare_fenv_inline(int) fesetexceptflag(const fexcept_t *__flagp, int __excepts)
 {
-    (void)excepts;
-    (void)flagp;
+    (void)__excepts;
+    (void)__flagp;
     return (0);
 }
 
-__declare_fenv_inline(int) feraiseexcept(int excepts)
+__declare_fenv_inline(int) feraiseexcept(int __excepts)
 {
-    return (excepts != 0);
+    return (__excepts != 0);
 }
 
-__declare_fenv_inline(int) fesetexcept(int excepts)
+/* C23; libm/fenv/fenv.c defines it for every version */
+#if __ISO_C_VISIBLE >= 2023 || defined(__PICOLIBC_FENV_ALL)
+__declare_fenv_inline(int) fesetexcept(int __excepts)
 {
-    return (excepts != 0);
+    return (__excepts != 0);
 }
+#endif
 
-__declare_fenv_inline(int) fetestexcept(int excepts)
+__declare_fenv_inline(int) fetestexcept(int __excepts)
 {
-    (void)excepts;
+    (void)__excepts;
     return (0);
 }
 
@@ -92,44 +95,45 @@ __declare_fenv_inline(int) fegetround(void)
     return FE_TONEAREST;
 }
 
-__declare_fenv_inline(int) fesetround(int rounding_mode)
+__declare_fenv_inline(int) fesetround(int __round)
 {
-    if (rounding_mode == FE_TONEAREST)
+    if (__round == FE_TONEAREST)
         return 0;
     return 1;
 }
 
-__declare_fenv_inline(int) fegetenv(fenv_t *envp)
+__declare_fenv_inline(int) fegetenv(fenv_t *__envp)
 {
-    (void)envp;
+    (void)__envp;
     return (0);
 }
 
-__declare_fenv_inline(int) feholdexcept(fenv_t *envp)
+__declare_fenv_inline(int) feholdexcept(fenv_t *__envp)
 {
-    (void)envp;
+    (void)__envp;
     return (0);
 }
 
-__declare_fenv_inline(int) fesetenv(const fenv_t *envp)
+__declare_fenv_inline(int) fesetenv(const fenv_t *__envp)
 {
-    (void)envp;
+    (void)__envp;
     return (0);
 }
 
-__declare_fenv_inline(int) feupdateenv(const fenv_t *envp)
+__declare_fenv_inline(int) feupdateenv(const fenv_t *__envp)
 {
-    (void)envp;
+    (void)__envp;
 
 #if defined FE_NOMASK_ENV && FE_ALL_EXCEPT != 0
-    if (envp == FE_NOMASK_ENV)
+    if (__envp == FE_NOMASK_ENV)
         return 1;
 #endif
 
     return (0);
 }
 
-#if __BSD_VISIBLE
+/* GNU extensions; libm/fenv/fenv.c defines them for every version */
+#if __GNU_VISIBLE || defined(__PICOLIBC_FENV_ALL)
 
 __declare_fenv_inline(int) feenableexcept(int __mask)
 {
@@ -149,4 +153,4 @@ __declare_fenv_inline(int) fegetexcept(void)
     return (0);
 }
 
-#endif /* __BSD_VISIBLE */
+#endif /* __GNU_VISIBLE */
diff --git a/libc/machine/aarch64/machine/fenv-fp.h b/libc/machine/aarch64/machine/fenv-fp.h
index 3260bcf17d..eab5ae53f6 100644
--- a/libc/machine/aarch64/machine/fenv-fp.h
+++ b/libc/machine/aarch64/machine/fenv-fp.h
@@ -66,10 +66,13 @@ __declare_fenv_inline(int) feraiseexcept(int __excepts)
     return (0);
 }
 
-__declare_fenv_inline(int) fesetexcept(int excepts)
+/* C23; libm/fenv/fenv.c defines it for every version */
+#if __ISO_C_VISIBLE >= 2023 || defined(__PICOLIBC_FENV_ALL)
+__declare_fenv_inline(int) fesetexcept(int __excepts)
 {
-    return feraiseexcept(excepts);
+    return feraiseexcept(__excepts);
 }
+#endif
 
 __declare_fenv_inline(int) fetestexcept(int __excepts)
 {
@@ -138,6 +141,8 @@ __declare_fenv_inline(int) feupdateenv(const fenv_t *__envp)
     return (0);
 }
 
+/* GNU extensions; libm/fenv/fenv.c defines them for every version */
+#if __GNU_VISIBLE || defined(__PICOLIBC_FENV_ALL)
 __declare_fenv_inline(int) feenableexcept(int __mask)
 {
     fenv_t __old_r, __new_r, __test_r;
@@ -168,3 +173,4 @@ __declare_fenv_inline(int) fegetexcept(void)
     __mrs_fpcr(__r);
     return ((__r & _ENABLE_MASK) >> _FPUSW_SHIFT);
 }
+#endif /* __GNU_VISIBLE */
diff --git a/libc/machine/arm/machine/fenv-fp.h b/libc/machine/arm/machine/fenv-fp.h
index 356c6ec852..48d42b0e4f 100644
--- a/libc/machine/arm/machine/fenv-fp.h
+++ b/libc/machine/arm/machine/fenv-fp.h
@@ -56,16 +56,18 @@
 #define _FPU_MASK_SHIFT 8
 #define _ROUND_MASK     (FE_TONEAREST | FE_DOWNWARD | FE_UPWARD | FE_TOWARDZERO)
 
-__declare_fenv_inline(int) feclearexcept(int excepts)
+__declare_fenv_inline(int) feclearexcept(int __excepts)
 {
     fexcept_t __fpsr;
 
     _vmrs_fpscr(__fpsr);
-    __fpsr &= ~excepts;
+    __fpsr &= ~__excepts;
     _vmsr_fpscr(__fpsr);
     return (0);
 }
 
+/* GNU extensions; libm/fenv/fenv.c defines them for every version */
+#if __GNU_VISIBLE || defined(__PICOLIBC_FENV_ALL)
 __declare_fenv_inline(int) fedisableexcept(int __mask)
 {
     fenv_t __old_fpsr, __new_fpsr;
@@ -87,13 +89,15 @@ __declare_fenv_inline(int) feenableexcept(int __mask)
         return -1;
     return ((__old_fpsr >> _FPU_MASK_SHIFT) & FE_ALL_EXCEPT);
 }
+#endif
 
-__declare_fenv_inline(int) fegetenv(fenv_t *envp)
+__declare_fenv_inline(int) fegetenv(fenv_t *__envp)
 {
-    _vmrs_fpscr(*envp);
+    _vmrs_fpscr(*__envp);
     return (0);
 }
 
+#if __GNU_VISIBLE || defined(__PICOLIBC_FENV_ALL)
 __declare_fenv_inline(int) fegetexcept(void)
 {
     fenv_t __fpsr;
@@ -101,13 +105,14 @@ __declare_fenv_inline(int) fegetexcept(void)
     _vmrs_fpscr(__fpsr);
     return (__fpsr & FE_ALL_EXCEPT);
 }
+#endif
 
-__declare_fenv_inline(int) fegetexceptflag(fexcept_t *flagp, int excepts)
+__declare_fenv_inline(int) fegetexceptflag(fexcept_t *__flagp, int __excepts)
 {
     fexcept_t __fpsr;
 
     _vmrs_fpscr(__fpsr);
-    *flagp = __fpsr & excepts;
+    *__flagp = __fpsr & __excepts;
     return (0);
 }
 
@@ -118,74 +123,77 @@ __declare_fenv_inline(int) fegetround(void)
     _vmrs_fpscr(__fpsr);
     return (__fpsr & _ROUND_MASK);
 }
-__declare_fenv_inline(int) feholdexcept(fenv_t *envp)
+__declare_fenv_inline(int) feholdexcept(fenv_t *__envp)
 {
     fenv_t __env;
 
     _vmrs_fpscr(__env);
-    *envp = __env;
+    *__envp = __env;
     __env &= ~(FE_ALL_EXCEPT);
     _vmsr_fpscr(__env);
     return (0);
 }
 
-__declare_fenv_inline(int) fesetenv(const fenv_t *envp)
+__declare_fenv_inline(int) fesetenv(const fenv_t *__envp)
 {
-    _vmsr_fpscr(*envp);
+    _vmsr_fpscr(*__envp);
     return (0);
 }
 
-__declare_fenv_inline(int) fesetexceptflag(const fexcept_t *flagp, int excepts)
+__declare_fenv_inline(int) fesetexceptflag(const fexcept_t *__flagp, int __excepts)
 {
     fexcept_t __fpsr;
 
     _vmrs_fpscr(__fpsr);
-    __fpsr &= ~excepts;
-    __fpsr |= *flagp & excepts;
+    __fpsr &= ~__excepts;
+    __fpsr |= *__flagp & __excepts;
     _vmsr_fpscr(__fpsr);
     return (0);
 }
 
-__declare_fenv_inline(int) feraiseexcept(int excepts)
+__declare_fenv_inline(int) feraiseexcept(int __excepts)
 {
-    fexcept_t __ex = excepts;
+    fexcept_t __ex = __excepts;
 
-    return fesetexceptflag(&__ex, excepts);
+    return fesetexceptflag(&__ex, __excepts);
 }
 
-__declare_fenv_inline(int) fesetexcept(int excepts)
+/* C23; libm/fenv/fenv.c defines it for every version */
+#if __ISO_C_VISIBLE >= 2023 || defined(__PICOLIBC_FENV_ALL)
+__declare_fenv_inline(int) fesetexcept(int __excepts)
 {
-    return feraiseexcept(excepts);
+    return feraiseexcept(__excepts);
 }
+#endif
 
-__declare_fenv_inline(int) fesetround(int round)
+__declare_fenv_inline(int) fesetround(int __round)
 {
     fenv_t __fpsr;
 
     /* Check for invalid rounding modes */
-    if (round & ~(_ROUND_MASK))
+    if (__round & ~(_ROUND_MASK))
         return 1;
     _vmrs_fpscr(__fpsr);
     __fpsr &= ~(_ROUND_MASK);
-    __fpsr |= round;
+    __fpsr |= __round;
     _vmsr_fpscr(__fpsr);
     return (0);
 }
 
-__declare_fenv_inline(int) fetestexcept(int excepts)
+__declare_fenv_inline(int) fetestexcept(int __excepts)
 {
     fexcept_t __fpsr;
 
     _vmrs_fpscr(__fpsr);
-    return (__fpsr & excepts);
+    return (__fpsr & __excepts);
 }
 
-__declare_fenv_inline(int) feupdateenv(const fenv_t *envp)
+__declare_fenv_inline(int) feupdateenv(const fenv_t *__envp)
 {
     fexcept_t __fpsr;
 
     _vmrs_fpscr(__fpsr);
-    _vmsr_fpscr(*envp);
+    _vmsr_fpscr(*__envp);
     feraiseexcept(__fpsr & FE_ALL_EXCEPT);
     return (0);
 }
diff --git a/libm/fenv/fegetmode.c b/libm/fenv/fegetmode.c
index 029dacdabf..f6d69a6d9c 100644
--- a/libm/fenv/fegetmode.c
+++ b/libm/fenv/fegetmode.c
@@ -42,7 +42,7 @@
 int
 fegetmode(femode_t *modep)
 {
-    modep->round = fegetround();
-    modep->except = fegetexcept();
+    modep->__round = fegetround();
+    modep->__except = fegetexcept();
     return 0;
 }
diff --git a/libm/fenv/fenv.c b/libm/fenv/fenv.c
index a12470a156..1388cd0086 100644
--- a/libm/fenv/fenv.c
+++ b/libm/fenv/fenv.c
@@ -37,6 +37,8 @@
 
 #define _GNU_SOURCE
 #define __declare_fenv_inline(type) type
+/* Define the extensions and the C23 functions too */
+#define __PICOLIBC_FENV_ALL
 #ifdef __GNUCLIKE_PRAGMA_DIAGNOSTIC
 #pragma GCC diagnostic ignored "-Wpragmas"
 #pragma GCC diagnostic ignored "-Wunknown-warning-option"
diff --git a/libm/fenv/fesetmode.c b/libm/fenv/fesetmode.c
index d38a785f1e..3116f18ca1 100644
--- a/libm/fenv/fesetmode.c
+++ b/libm/fenv/fesetmode.c
@@ -44,8 +44,8 @@ fesetmode(femode_t *modep)
 {
     int round = FE_TONEAREST, except = 0;
     if (modep) {
-        round = modep->round;
-        except = modep->except;
+        round = modep->__round;
+        except = modep->__except;
     }
     /* assume any failure indicates that there isn't hw support,
      * so we wouldn't be affecting anything
-- 
