 test/test-posix/test-time/meson.build      |   1 +
 test/test-posix/test-time/test-localtime.c | 263 +++++++++++++++++++++
 3 files changed, 265 insertions(+)
 create mode 100644 test/test-posix/test-time/test-localtime.c

