+
+#define _DEFAULT_SOURCE
+#include <time.h>
+
+/*
+ * The CPU time of this process alone, in CLOCKS_PER_SEC units. The
+ * generic version sums the times() fields, which count in the
+ * kernel's USER_HZ ticks and include waited-for children.
+ */
+clock_t
+clock(void)
+{
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &ts) < 0)
+        return (clock_t)-1;
+    return (clock_t)ts.tv_sec * CLOCKS_PER_SEC
+        + (clock_t)ts.tv_nsec / (1000000000 / CLOCKS_PER_SEC);
+}
diff --git a/libos/linux/meson.build b/libos/linux/meson.build
index caabd12342..a28643be53 100644
--- a/libos/linux/meson.build
+++ b/libos/linux/meson.build
@@ -64,6 +64,7 @@ if fs.is_dir(machine_dir)
     'chdir.c',
     'chmod.c',
     'chown.c',
+    'clock.c',
     'clock_gettime.c',
     'clock_getcpuclockid.c',
     'clock_getres.c',
