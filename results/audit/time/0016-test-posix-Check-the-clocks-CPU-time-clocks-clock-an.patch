From 8f5010868a6ef394b8f7a201d0d76b95952655b1 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 20:14:21 +0000
Subject: [PATCH 16/25] test-posix: Check the clocks, CPU-time clocks, clock
 and nanosleep

---
 test/test-posix/test-time/CMakeLists.txt      |   1 +
 test/test-posix/test-time/meson.build         |   5 +
 .../test-posix/test-time/test-clock_gettime.c | 296 ++++++++++++++++++
 3 files changed, 302 insertions(+)
 create mode 100644 test/test-posix/test-time/test-clock_gettime.c

diff --git a/test/test-posix/test-time/CMakeLists.txt b/test/test-posix/test-time/CMakeLists.txt
index 4c9d63d7ef..d5ea328eaf 100644
--- a/test/test-posix/test-time/CMakeLists.txt
+++ b/test/test-posix/test-time/CMakeLists.txt
@@ -35,6 +35,7 @@
 
 set(tests
   test-clock_getcpuclockid
+  test-clock_gettime
   test-clock_nanosleep
   test-time
   test-time_h
diff --git a/test/test-posix/test-time/meson.build b/test/test-posix/test-time/meson.build
index 9a737e1a64..a463025d91 100644
--- a/test/test-posix/test-time/meson.build
+++ b/test/test-posix/test-time/meson.build
@@ -40,3 +40,8 @@ dir_tests = [
   'test-time_h',
   'test-timer_create',
 ]
+
+# These use threads, so lock-valid.c doesn't apply
+dir_thread_tests = [
+  'test-clock_gettime',
+]
diff --git a/test/test-posix/test-time/test-clock_gettime.c b/test/test-posix/test-time/test-clock_gettime.c
new file mode 100644
index 0000000000..a3e7414ef4
--- /dev/null
+++ b/test/test-posix/test-time/test-clock_gettime.c
@@ -0,0 +1,296 @@
