From d0802f2d0dab539580a94ce3da18e18e900a73ba Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 19:52:01 +0000
Subject: [PATCH 07/25] time: Follow POSIX.1-2024 for the strftime + flag, %C
 and %F widths

The + flag adds a sign when the field is wider than four bytes for %Y
and %G, or two for %C, not only when the year needs them: %+5Y gives
+0270 for year 270. %C gives two digits for years 0 to 9999. %F
formats the year with the flag and a width of x-6. Update the year 7
case in test-strftime, which expected one digit from %C.
---
 libc/time/strftime.c | 29 +++++++++++++++++++++--------
 test/test-strftime.c |  6 +++++-
 2 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/libc/time/strftime.c b/libc/time/strftime.c
index 557455c65f..6f68e468f0 100644
--- a/libc/time/strftime.c
+++ b/libc/time/strftime.c
@@ -851,13 +851,15 @@ __strftime(CHAR *s, size_t maxsize, const CHAR *format, const struct tm *tim_p,
                 char *pos = "";
                 int   year = tim_p->tm_year + YEAR_BASE;
                 int   century = year / 100 - (year % 100 < 0);
-                if (pad) /* '0' or '+' */
-                {
-                    if (century >= 100 && pad == CQ('+'))
-                        pos = "+";
+                /* '+' adds a sign when the field is wider than two bytes */
+                if (pad == CQ('+') && century >= 0 && (century >= 100 || width > 2)) {
+                    pos = "+";
+                    if (width)
+                        --width;
                 }
+                /* Years from 0 to 9999 give two digits by default */
                 if (width < 1)
-                    width = 1;
+                    width = century >= 0 ? 2 : 1;
                 len = t_snprintf(&s[count], maxsize - count, CQ("%s%.*d"), pos, (int)width,
                                  century);
             }
@@ -900,7 +902,18 @@ __strftime(CHAR *s, size_t maxsize, const CHAR *format, const struct tm *tim_p,
             break;
         case CQ('F'): { /* %F is equivalent to "%Y-%m-%d", flags and width can change
                            that.  Recurse to avoid need to replicate %Y formation. */
-            len = __strftime(&s[count], maxsize - count, CQ("%Y-%m-%d"), tim_p, locale, era_info,
+            /* A width of x formats the year with the flag and a width of x-6 */
+            CHAR fmtbuf[32], *fmt = fmtbuf;
+            *fmt++ = CQ('%');
+            if (pad)
+                *fmt++ = pad;
+            if (width > 6) {
+                len = t_snprintf(fmt, fmtbuf + 32 - fmt, CQ("%lu"), width - 6);
+                if (len > 0)
+                    fmt += len;
+            }
+            STRCPY(fmt, CQ("Y-%m-%d"));
+            len = __strftime(&s[count], maxsize - count, fmtbuf, tim_p, locale, era_info,
                              alt_digits);
             if (len > 0)
                 count += len;
@@ -950,7 +963,7 @@ __strftime(CHAR *s, size_t maxsize, const CHAR *format, const struct tm *tim_p,
             unsigned p_year = century * 100 + year;
             if (sign)
                 *fmt++ = CQ('-');
-            else if (pad == CQ('+') && p_year >= 10000) {
+            else if (pad == CQ('+') && (p_year >= 10000 || width > 4)) {
                 *fmt++ = CQ('+');
                 sign = 1;
             }
@@ -1255,7 +1268,7 @@ __strftime(CHAR *s, size_t maxsize, const CHAR *format, const struct tm *tim_p,
                 if (sign) {
                     *fmt++ = CQ('-');
                     year = UINT_MAX - year + 1;
-                } else if (pad == CQ('+') && year >= 10000) {
+                } else if (pad == CQ('+') && (year >= 10000 || width > 4)) {
                     *fmt++ = CQ('+');
                     sign = 1;
                 }
diff --git a/test/test-strftime.c b/test/test-strftime.c
index 546a7273a1..3dda931119 100644
--- a/test/test-strftime.c
+++ b/test/test-strftime.c
@@ -302,7 +302,11 @@ const struct tm tmyrzp = {
     .tm_wday = 3, .tm_yday = 183, .tm_isdst = 1
 };
 #define YEAR CQ("7") /* Design intent:  %Y=%C%y */
-#define CENT CQ("0")
+#ifdef __PICOLIBC__
+#define CENT CQ("00") /* POSIX.1-2024: two digits for years 0 to 9999 */
+#else
+#define CENT CQ("0") /* glibc gives one digit */
+#endif
 #define Year CQ("07")
 const struct test Vecyrzp[] = {
 /* Testing fields one at a time, expecting to pass, using a larger
-- 
