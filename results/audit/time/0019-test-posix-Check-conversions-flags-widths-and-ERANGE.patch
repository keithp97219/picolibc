   test-time
   test-time_h
   test-timer_create
diff --git a/test/test-posix/test-time/meson.build b/test/test-posix/test-time/meson.build
index db32c79d3b..405ee323bc 100644
--- a/test/test-posix/test-time/meson.build
+++ b/test/test-posix/test-time/meson.build
@@ -38,6 +38,7 @@ dir_tests = [
   'test-clock_nanosleep',
   'test-localtime',
   'test-mktime',
+  'test-strftime_l',
   'test-time',
   'test-time_h',
   'test-timer_create',
diff --git a/test/test-posix/test-time/test-strftime_l.c b/test/test-posix/test-time/test-strftime_l.c
new file mode 100644
index 0000000000..47a4f4e9ab
--- /dev/null
+++ b/test/test-posix/test-time/test-strftime_l.c
@@ -0,0 +1,212 @@
