From c2d0f0cd16c5e8127e43a231ebdd4c539347918f Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 20:14:21 +0000
Subject: [PATCH 19/25] test-posix: Check conversions, flags, widths and ERANGE
 in strftime

---
 test/test-posix/test-time/CMakeLists.txt    |   1 +
 test/test-posix/test-time/meson.build       |   1 +
 test/test-posix/test-time/test-strftime_l.c | 212 ++++++++++++++++++++
 3 files changed, 214 insertions(+)
 create mode 100644 test/test-posix/test-time/test-strftime_l.c

diff --git a/test/test-posix/test-time/CMakeLists.txt b/test/test-posix/test-time/CMakeLists.txt
index 4a9bf00e59..aa61e57a35 100644
--- a/test/test-posix/test-time/CMakeLists.txt
+++ b/test/test-posix/test-time/CMakeLists.txt
@@ -39,6 +39,7 @@ set(tests
   test-clock_nanosleep
   test-localtime
   test-mktime
