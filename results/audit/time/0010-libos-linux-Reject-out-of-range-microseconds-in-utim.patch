From d3fbab1b9cf2a09f938c85040250850ef527688e Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 19:57:24 +0000
Subject: [PATCH 10/25] libos/linux: Reject out-of-range microseconds in utimes

utimes multiplied tv_usec by 1000 into a long. On 32-bit targets a
value like 4294968 wrapped to a valid nanosecond count, so utimes set
the time instead of failing with EINVAL.
---
 libos/linux/utimes.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/libos/linux/utimes.c b/libos/linux/utimes.c
index 5c268d52d0..11e3031afd 100644
--- a/libos/linux/utimes.c
+++ b/libos/linux/utimes.c
@@ -34,6 +34,7 @@
  */
 
 #include "local-linux.h"
+#include <errno.h>
 #include <sys/stat.h>
 #include <sys/time.h>
 
@@ -44,6 +45,15 @@ utimes(const char *path, const struct timeval tv[2])
 
     if (!tv)
         return utimensat(AT_FDCWD, path, NULL, 0);
+    /*
+     * Check the microseconds here: multiplied by 1000 in a 32-bit
+     * long, a value out of range can wrap into a valid one.
+     */
+    if (tv[0].tv_usec < 0 || tv[0].tv_usec >= 1000000 || tv[1].tv_usec < 0
+        || tv[1].tv_usec >= 1000000) {
+        errno = EINVAL;
+        return -1;
+    }
     ts[0].tv_sec = tv[0].tv_sec;
     ts[0].tv_nsec = tv[0].tv_usec * 1000;
     ts[1].tv_sec = tv[1].tv_sec;
