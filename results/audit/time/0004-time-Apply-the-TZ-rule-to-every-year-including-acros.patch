From 5c120810f23ce3e2abcb656fb8b4344f89d684b2 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 19:48:26 +0000
Subject: [PATCH 04/25] time: Apply the TZ rule to every year, including across
 year ends

__tzcalc_limits gave up before 1970, so localtime set tm_isdst to -1,
which POSIX doesn't allow. And localtime used only the current UTC
year's transitions, so a rule whose transition falls in the next year,
like XBD 8.3's example EST5EDT,0/0,J365/25, reported standard time at
the start of each year. __tz_isdst checks the neighbouring year's
rule near the ends of the year.
---
 libc/time/lcltime_r.c     | 12 ++-----
 libc/time/local.h         |  1 +
 libc/time/tzcalc_limits.c | 70 +++++++++++++++++++++++++++++++--------
 3 files changed, 61 insertions(+), 22 deletions(-)

diff --git a/libc/time/lcltime_r.c b/libc/time/lcltime_r.c
index da4c200cc4..a6d6c62dc0 100644
--- a/libc/time/lcltime_r.c
+++ b/libc/time/lcltime_r.c
@@ -50,15 +50,9 @@ localtime_r(const time_t * __restrict tim_p, struct tm * __restrict res)
 
     __LIBC_LOCK();
 
-    if (daylight) {
-        if (year == __tzinfo.year || __tzcalc_limits(year))
-            res->tm_isdst
-                = (__tzinfo.north
-                       ? (*tim_p >= __tzinfo.rule[0].change && *tim_p < __tzinfo.rule[1].change)
-                       : (*tim_p >= __tzinfo.rule[0].change || *tim_p < __tzinfo.rule[1].change));
-        else
-            res->tm_isdst = -1;
-    } else
+    if (daylight)
+        res->tm_isdst = __tz_isdst(*tim_p, year, res->tm_yday);
+    else
         res->tm_isdst = 0;
 
     offset = (res->tm_isdst == 1 ? __tzinfo.rule[1].offset : __tzinfo.rule[0].offset);
diff --git a/libc/time/local.h b/libc/time/local.h
index 0d5c9f34ce..b150204e8f 100644
--- a/libc/time/local.h
+++ b/libc/time/local.h
@@ -72,6 +72,7 @@ timebase_to_clockid(int base)
 }
 
 int                  __tzcalc_limits(int __year);
+int                  __tz_isdst(time_t __t, int __year, int __yday);
 
 extern const uint8_t __month_lengths[2][MONSPERYEAR];
 extern char          __tzname_std[TZNAME_MAX + 2];
diff --git a/libc/time/tzcalc_limits.c b/libc/time/tzcalc_limits.c
index 7347cdbe8b..944a8030a4 100644
--- a/libc/time/tzcalc_limits.c
+++ b/libc/time/tzcalc_limits.c
@@ -10,23 +10,30 @@
  */
 
 #include "local.h"
+#include <limits.h>
+
+/* Days from 1970-01-01 to January 1 of year, for any year */
+static time_t
+days_to_year(int year)
+{
+    time_t y = (time_t)year - 1;
+    time_t d4 = (y >= 0 ? y : y - 3) / 4;
+    time_t d100 = (y >= 0 ? y : y - 99) / 100;
+    time_t d400 = (y >= 0 ? y : y - 399) / 400;
+
+    /* 719162 is the number of days from 0001-01-01 to 1970-01-01 */
+    return y * 365 + d4 - d100 + d400 - 719162;
+}
 
 int
 __tzcalc_limits(int year)
 {
-    int days, year_days, years;
-    int i, j;
-
-    if (year < EPOCH_YEAR)
-        return 0;
+    time_t days, year_days;
+    int    i, j;
 
     __tzinfo.year = year;
 
-    years = (year - EPOCH_YEAR);
-
-    year_days = years * 365 + (years - 1 + EPOCH_YEARS_SINCE_LEAP) / 4
-        - (years - 1 + EPOCH_YEARS_SINCE_CENTURY) / 100
-        + (years - 1 + EPOCH_YEARS_SINCE_LEAP_CENTURY) / 400;
+    year_days = days_to_year(year);
 
     for (i = 0; i < 2; ++i) {
         if (__tzinfo.rule[i].ch == 'J') {
@@ -46,7 +53,9 @@ __tzcalc_limits(int year)
             for (j = 1; j < __tzinfo.rule[i].m; ++j)
                 days += ip[j - 1];
 
-            m_wday = (EPOCH_WDAY + days) % DAYSPERWEEK;
+            m_wday = (int)((EPOCH_WDAY + days) % DAYSPERWEEK);
+            if (m_wday < 0)
+                m_wday += DAYSPERWEEK;
 
             wday_diff = __tzinfo.rule[i].d - m_wday;
             if (wday_diff < 0)
@@ -60,11 +69,46 @@ __tzcalc_limits(int year)
         }
 
         /* store the change-over time in GMT form by adding offset */
-        __tzinfo.rule[i].change
-            = (time_t)days * SECSPERDAY + __tzinfo.rule[i].s + __tzinfo.rule[i].offset;
+        __tzinfo.rule[i].change = days * SECSPERDAY + __tzinfo.rule[i].s + __tzinfo.rule[i].offset;
     }
 
     __tzinfo.north = (__tzinfo.rule[0].change < __tzinfo.rule[1].change);
 
     return 1;
 }
+
+/*
+ * Whether daylight saving time is in effect at t, whose UTC date is
+ * day yday of year. A rule's transitions can fall in the next or the
+ * previous year (EST5EDT,0/0,J365/25 ends DST on January 1), so near
+ * the ends of the year the neighbouring years' rules are checked too.
+ * Call with the lock held.
+ */
+int
+__tz_isdst(time_t t, int year, int yday)
+{
+    int north, k;
+
+    if (year != __tzinfo.year)
+        __tzcalc_limits(year);
+    north = __tzinfo.north;
+    for (k = 0; k < 3; k++) {
+        if (k == 1) {
+            if (yday > 7 || year == INT_MIN)
+                continue;
+            __tzcalc_limits(year - 1);
+        } else if (k == 2) {
+            if (yday < 357 || year == INT_MAX)
+                continue;
+            __tzcalc_limits(year + 1);
+        }
+        if (__tzinfo.north) {
+            if (t >= __tzinfo.rule[0].change && t < __tzinfo.rule[1].change)
+                return 1;
+        } else {
+            if (t >= __tzinfo.rule[1].change && t < __tzinfo.rule[0].change)
+                return 0;
+        }
+    }
+    return !north;
+}
