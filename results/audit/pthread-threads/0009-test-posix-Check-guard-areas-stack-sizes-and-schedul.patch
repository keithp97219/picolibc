From a2236db5ad22a9363d05cd2b72a53bdbf471ea7a Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 20:07:58 +0000
Subject: [PATCH 09/12] test-posix: Check guard areas, stack sizes and
 scheduling attributes

The guard area stops a stack overflow, sizes that can't be provided
make pthread_create fail, EAGAIN without memory, inherited and explicit
scheduling, EPERM without privilege, and attribute objects changed
or shared after pthread_create.
---
 test/test-posix/test-pthread/CMakeLists.txt   |   1 +
 test/test-posix/test-pthread/meson.build      |   1 +
 .../test-pthread_attr_setguardsize.c          | 439 ++++++++++++++++++
 3 files changed, 441 insertions(+)
 create mode 100644 test/test-posix/test-pthread/test-pthread_attr_setguardsize.c

diff --git a/test/test-posix/test-pthread/CMakeLists.txt b/test/test-posix/test-pthread/CMakeLists.txt
index f58d8dff4c..6b7886c21c 100644
--- a/test/test-posix/test-pthread/CMakeLists.txt
+++ b/test/test-posix/test-pthread/CMakeLists.txt
@@ -35,6 +35,7 @@
 
 set(tests
   test-pthread_atfork
+  test-pthread_attr_setguardsize
   test-pthread_attr_setstackaddr
   test-pthread_barrier_wait
   test-pthread_cancel
diff --git a/test/test-posix/test-pthread/meson.build b/test/test-posix/test-pthread/meson.build
index 82ff601157..91bef24b9b 100644
--- a/test/test-posix/test-pthread/meson.build
+++ b/test/test-posix/test-pthread/meson.build
@@ -41,6 +41,7 @@ dir_tests = [
 # These use threads, so lock-valid.c doesn't apply
 dir_thread_tests = [
   'test-pthread_atfork',
+  'test-pthread_attr_setguardsize',
   'test-pthread_attr_setstackaddr',
   'test-pthread_barrier_wait',
   'test-pthread_cancel',
diff --git a/test/test-posix/test-pthread/test-pthread_attr_setguardsize.c b/test/test-posix/test-pthread/test-pthread_attr_setguardsize.c
new file mode 100644
index 0000000000..75fb5b18af
--- /dev/null
+++ b/test/test-posix/test-pthread/test-pthread_attr_setguardsize.c
@@ -0,0 +1,439 @@
