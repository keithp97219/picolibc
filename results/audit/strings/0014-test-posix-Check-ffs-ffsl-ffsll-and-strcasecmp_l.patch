diff --git a/test/test-posix/test-strings/test-ffsll.c b/test/test-posix/test-strings/test-ffsll.c
new file mode 100644
index 0000000000..87928339ab
--- /dev/null
+++ b/test/test-posix/test-strings/test-ffsll.c
@@ -0,0 +1,116 @@
