 test/test-posix/test-strings/meson.build      |   2 +
 test/test-posix/test-strings/test-ffsll.c     | 116 ++++++++++
 .../test-strings/test-strcasecmp_l.c          | 209 ++++++++++++++++++
 4 files changed, 329 insertions(+)
 create mode 100644 test/test-posix/test-strings/test-ffsll.c
 create mode 100644 test/test-posix/test-strings/test-strcasecmp_l.c

