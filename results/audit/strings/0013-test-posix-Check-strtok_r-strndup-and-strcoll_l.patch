 test/test-posix/test-string/test-strcoll_l.c | 180 +++++++++++++++
 test/test-posix/test-string/test-strndup.c   | 171 ++++++++++++++
 test/test-posix/test-string/test-strtok_r.c  | 226 +++++++++++++++++++
 5 files changed, 583 insertions(+)
 create mode 100644 test/test-posix/test-string/test-strcoll_l.c
 create mode 100644 test/test-posix/test-string/test-strndup.c
 create mode 100644 test/test-posix/test-string/test-strtok_r.c

