 .../test-string/test-memchr-pages.c           | 592 +++++++++++++
 .../test-string/test-strnlen-pages.c          | 816 ++++++++++++++++++
 5 files changed, 1677 insertions(+)
 create mode 100644 test/test-posix/test-string/string-pages.h
