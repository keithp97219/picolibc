+int
+main(void)
+{
+    setup_arenas();
+    errno = ERRNO_MARK;
+    test_length();
+    test_strchr();
+    test_strcmp();
+    test_strcpy();
+    test_strncpy();
+    test_strcat();
+    test_strlcpy();
+    test_strspn();
+    test_strstr();
+    test_strdup();
+    test_strcoll();
+    if (failures)
+        return 1;
+    printf("success\n");
+    return 0;
+}
