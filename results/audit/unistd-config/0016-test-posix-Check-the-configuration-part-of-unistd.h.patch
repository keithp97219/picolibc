+#error "_POSIX_MESSAGE_PASSING"
+#endif
+#if defined(_POSIX_PRIORITIZED_IO) && _POSIX_PRIORITIZED_IO != -1 && _POSIX_PRIORITIZED_IO != 0 \
+    && _POSIX_PRIORITIZED_IO != 202405L
+#error "_POSIX_PRIORITIZED_IO"
+#endif
+#if defined(_POSIX_PRIORITY_SCHEDULING) && _POSIX_PRIORITY_SCHEDULING != -1     \
+    && _POSIX_PRIORITY_SCHEDULING != 0 && _POSIX_PRIORITY_SCHEDULING != 202405L
+#error "_POSIX_PRIORITY_SCHEDULING"
+#endif
