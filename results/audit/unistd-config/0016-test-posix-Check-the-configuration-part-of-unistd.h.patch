+#error "_POSIX_TYPED_MEMORY_OBJECTS"
+#endif
+#if defined(_POSIX2_C_DEV) && _POSIX2_C_DEV != -1 && _POSIX2_C_DEV != 0 && _POSIX2_C_DEV != 202405L
+#error "_POSIX2_C_DEV"
+#endif
+#if defined(_POSIX2_FORT_RUN) && _POSIX2_FORT_RUN != -1 && _POSIX2_FORT_RUN != 0 \
