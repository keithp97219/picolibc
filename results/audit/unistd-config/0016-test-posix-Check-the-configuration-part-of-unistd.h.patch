+#error "_POSIX2_FORT_RUN"
+#endif
+#if defined(_POSIX2_LOCALEDEF) && _POSIX2_LOCALEDEF != -1 && _POSIX2_LOCALEDEF != 0 \
+    && _POSIX2_LOCALEDEF != 202405L
+#error "_POSIX2_LOCALEDEF"
+#endif
+#if defined(_POSIX2_SW_DEV) && _POSIX2_SW_DEV != -1 && _POSIX2_SW_DEV != 0 \
