+/* The getopt variables and the functions this part of <unistd.h> declares */
+#define check_type(f, type)                                                    \
+    _Static_assert(_Generic(&(f), type: 1, default: 0), #f " has type " #type)
+
+check_type(optarg, char **);
+check_type(opterr, int *);
+check_type(optind, int *);
+check_type(optopt, int *);
+check_type(getopt, int (*)(int, char * const[], const char *));
+check_type(sysconf, long (*)(int));
+check_type(pathconf, long (*)(const char *, int));
+check_type(fpathconf, long (*)(int, int));
+check_type(confstr, size_t (*)(int, char *, size_t));
+check_type(gethostname, int (*)(char *, size_t));
+check_type(gethostid, long (*)(void));
+/* glibc declares crypt in <crypt.h> and has dropped encrypt */
+#ifndef __GLIBC__
+check_type(crypt, char *(*)(const char *, const char *));
+check_type(encrypt, void (*)(char[64], int));
+#endif
+check_type(swab, void (*)(const void * restrict, void * restrict, ssize_t));
+
+#include <errno.h>
+
+int
+main(void)
+{
+    size_t i;
+    int    fails = 0;
+
+    /* sysconf and confstr know every name, and leave errno alone for them */
+    for (i = 0; i < sizeof(sc_names) / sizeof(sc_names[0]); i++) {
+        if (sc_names[i].value <= -1000)
+            continue;
+        /* glibc fails these with EINVAL */
+#ifdef __GLIBC__
+        if (sc_names[i].value == _SC_SS_REPL_MAX
+            || sc_names[i].value == _SC_THREAD_ROBUST_PRIO_INHERIT
+            || sc_names[i].value == _SC_THREAD_ROBUST_PRIO_PROTECT)
+            continue;
+#endif
+        errno = 0;
+        (void)sysconf(sc_names[i].value);
+        if (errno != 0) {
+            printf("sysconf(%s): errno %d\n", sc_names[i].name, errno);
+            fails++;
+        }
+    }
+    for (i = 0; i < sizeof(cs_names) / sizeof(cs_names[0]); i++) {
+        if (cs_names[i].value <= -1000)
+            continue;
+        errno = 0;
+        if (confstr(cs_names[i].value, NULL, 0) == 0 && errno != 0) {
+            printf("confstr(%s): errno %d\n", cs_names[i].name, errno);
+            fails++;
+        }
+    }
+    if (fails)
+        return 1;
+    printf("success\n");
+    return 0;
+}
