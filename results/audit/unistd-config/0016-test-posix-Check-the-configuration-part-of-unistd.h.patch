+/* Every name is defined, and a duplicate value is a duplicate case */
+static int __attribute__((unused))
+sc_distinct(int name)
+{
+    switch (name) {
+    case _SC_2_CHAR_TERM:
+    case _SC_2_C_BIND:
+    case _SC_2_C_DEV:
+    case _SC_2_FORT_RUN:
+    case _SC_2_LOCALEDEF:
+    case _SC_2_SW_DEV:
+    case _SC_2_UPE:
+    case _SC_2_VERSION:
+    case _SC_ADVISORY_INFO:
+    case _SC_AIO_LISTIO_MAX:
+    case _SC_AIO_MAX:
+    case _SC_AIO_PRIO_DELTA_MAX:
+    case _SC_ARG_MAX:
+    case _SC_ASYNCHRONOUS_IO:
+    case _SC_ATEXIT_MAX:
+    case _SC_BARRIERS:
+    case _SC_BC_BASE_MAX:
+    case _SC_BC_DIM_MAX:
+    case _SC_BC_SCALE_MAX:
+    case _SC_BC_STRING_MAX:
+    case _SC_CHILD_MAX:
+    case _SC_CLK_TCK:
+    case _SC_CLOCK_SELECTION:
+    case _SC_COLL_WEIGHTS_MAX:
+    case _SC_CPUTIME:
+    case _SC_DELAYTIMER_MAX:
+    case _SC_DEVICE_CONTROL:
