+#endif
+#ifndef _SC_NSIG
+#define _SC_NSIG (-1000 - 1)
+#endif
+#ifndef _SC_V8_ILP32_OFF32
+#define _SC_V8_ILP32_OFF32 (-1000 - 2)
+#endif
+#ifndef _SC_V8_ILP32_OFFBIG
+#define _SC_V8_ILP32_OFFBIG (-1000 - 3)
+#endif
