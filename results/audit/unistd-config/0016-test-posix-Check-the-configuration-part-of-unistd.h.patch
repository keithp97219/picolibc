+#if defined(_POSIX_THREAD_PRIO_INHERIT) && _POSIX_THREAD_PRIO_INHERIT != -1     \
+    && _POSIX_THREAD_PRIO_INHERIT != 0 && _POSIX_THREAD_PRIO_INHERIT != 202405L
+#error "_POSIX_THREAD_PRIO_INHERIT"
+#endif
+#if defined(_POSIX_THREAD_PRIO_PROTECT) && _POSIX_THREAD_PRIO_PROTECT != -1     \
+    && _POSIX_THREAD_PRIO_PROTECT != 0 && _POSIX_THREAD_PRIO_PROTECT != 202405L
+#error "_POSIX_THREAD_PRIO_PROTECT"
+#endif
+#if defined(_POSIX_THREAD_PRIORITY_SCHEDULING) && _POSIX_THREAD_PRIORITY_SCHEDULING != -1     \
+    && _POSIX_THREAD_PRIORITY_SCHEDULING != 0 && _POSIX_THREAD_PRIORITY_SCHEDULING != 202405L
+#error "_POSIX_THREAD_PRIORITY_SCHEDULING"
+#endif
+#if defined(_POSIX_THREAD_PROCESS_SHARED) && _POSIX_THREAD_PROCESS_SHARED != -1     \
+    && _POSIX_THREAD_PROCESS_SHARED != 0 && _POSIX_THREAD_PROCESS_SHARED != 202405L
+#error "_POSIX_THREAD_PROCESS_SHARED"
+#endif
+#if defined(_POSIX_THREAD_ROBUST_PRIO_INHERIT) && _POSIX_THREAD_ROBUST_PRIO_INHERIT != -1     \
