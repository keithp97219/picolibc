+#error "_POSIX2_SW_DEV"
+#endif
+#if defined(_POSIX2_UPE) && _POSIX2_UPE != -1 && _POSIX2_UPE != 0 && _POSIX2_UPE != 202405L
+#error "_POSIX2_UPE"
+#endif
+#if defined(_XOPEN_UUCP) && _XOPEN_UUCP != -1 && _XOPEN_UUCP != 0 && _XOPEN_UUCP != 202405L
+#error "_XOPEN_UUCP"
+#endif
+
+/* Options that, when defined, are always 202405L */
+#if defined(_POSIX_ASYNCHRONOUS_IO) && _POSIX_ASYNCHRONOUS_IO != 202405L
+#error "_POSIX_ASYNCHRONOUS_IO"
+#endif
+#if defined(_POSIX_BARRIERS) && _POSIX_BARRIERS != 202405L
+#error "_POSIX_BARRIERS"
+#endif
+#if defined(_POSIX_CLOCK_SELECTION) && _POSIX_CLOCK_SELECTION != 202405L
+#error "_POSIX_CLOCK_SELECTION"
+#endif
+#if defined(_POSIX_MAPPED_FILES) && _POSIX_MAPPED_FILES != 202405L
+#error "_POSIX_MAPPED_FILES"
+#endif
+#if defined(_POSIX_MEMORY_PROTECTION) && _POSIX_MEMORY_PROTECTION != 202405L
+#error "_POSIX_MEMORY_PROTECTION"
+#endif
+#if defined(_POSIX_MONOTONIC_CLOCK) && _POSIX_MONOTONIC_CLOCK != 202405L
+#error "_POSIX_MONOTONIC_CLOCK"
+#endif
+#if defined(_POSIX_READER_WRITER_LOCKS) && _POSIX_READER_WRITER_LOCKS != 202405L
+#error "_POSIX_READER_WRITER_LOCKS"
+#endif
+#if defined(_POSIX_REALTIME_SIGNALS) && _POSIX_REALTIME_SIGNALS != 202405L
+#error "_POSIX_REALTIME_SIGNALS"
+#endif
+#if defined(_POSIX_SEMAPHORES) && _POSIX_SEMAPHORES != 202405L
+#error "_POSIX_SEMAPHORES"
+#endif
+#if defined(_POSIX_SPIN_LOCKS) && _POSIX_SPIN_LOCKS != 202405L
+#error "_POSIX_SPIN_LOCKS"
+#endif
+#if defined(_POSIX_THREAD_SAFE_FUNCTIONS) && _POSIX_THREAD_SAFE_FUNCTIONS != 202405L
+#error "_POSIX_THREAD_SAFE_FUNCTIONS"
+#endif
+#if defined(_POSIX_THREADS) && _POSIX_THREADS != 202405L
+#error "_POSIX_THREADS"
+#endif
+#if defined(_POSIX_TIMEOUTS) && _POSIX_TIMEOUTS != 202405L
+#error "_POSIX_TIMEOUTS"
+#endif
+#if defined(_POSIX_TIMERS) && _POSIX_TIMERS != 202405L
+#error "_POSIX_TIMERS"
+#endif
+#if defined(_POSIX2_C_BIND) && _POSIX2_C_BIND != 202405L
+#error "_POSIX2_C_BIND"
+#endif
+#endif /* __GLIBC__ */
+
+/* Options that are always greater than zero */
+#if defined(_POSIX_JOB_CONTROL) && _POSIX_JOB_CONTROL <= 0
+#error "_POSIX_JOB_CONTROL"
+#endif
+#if defined(_POSIX_REGEXP) && _POSIX_REGEXP <= 0
+#error "_POSIX_REGEXP"
+#endif
+#if defined(_POSIX_SAVED_IDS) && _POSIX_SAVED_IDS <= 0
+#error "_POSIX_SAVED_IDS"
+#endif
+#if defined(_POSIX_SHELL) && _POSIX_SHELL <= 0
+#error "_POSIX_SHELL"
+#endif
+
+/*
+ * Constants that are always defined, as other than -1, where the
+ * system has file systems and terminals at all
+ */
+#if defined(_POSIX_CHOWN_RESTRICTED) && _POSIX_CHOWN_RESTRICTED == -1
+#error "_POSIX_CHOWN_RESTRICTED"
+#endif
+#if defined(_POSIX_NO_TRUNC) && _POSIX_NO_TRUNC == -1
+#error "_POSIX_NO_TRUNC"
+#endif
+#if defined(_POSIX_VDISABLE) && _POSIX_VDISABLE == -1
+#error "_POSIX_VDISABLE"
+#endif
+#ifdef __PICOLIBC__
+#include "../posix-groups.h"
+#if defined(__PICOLIBC_POSIX_FILE_SYSTEM)                               \
+    && (!defined(_POSIX_CHOWN_RESTRICTED) || !defined(_POSIX_NO_TRUNC))
+#error "_POSIX_CHOWN_RESTRICTED and _POSIX_NO_TRUNC"
+#endif
+#if defined(__PICOLIBC_POSIX_DEVICE_SPECIFIC) && !defined(_POSIX_VDISABLE)
+#error "_POSIX_VDISABLE"
+#endif
+#endif
+#if defined(_XOPEN_ENH_I18N) && _XOPEN_ENH_I18N == -1
+#error "_XOPEN_ENH_I18N"
+#endif
+#if defined(_XOPEN_SHM) && _XOPEN_SHM == -1
+#error "_XOPEN_SHM"
+#endif
+
+/* A programming environment the system supports matches the type sizes */
+#if defined(_POSIX_V8_ILP32_OFF32) && _POSIX_V8_ILP32_OFF32 > 0
+_Static_assert(sizeof(int) == 4 && sizeof(long) == 4 && sizeof(void *) == 4 && sizeof(off_t) == 4,
+               "ILP32_OFF32");
+#endif
+#if defined(_POSIX_V8_ILP32_OFFBIG) && _POSIX_V8_ILP32_OFFBIG > 0
+_Static_assert(sizeof(int) == 4 && sizeof(long) == 4 && sizeof(void *) == 4 && sizeof(off_t) >= 8,
+               "ILP32_OFFBIG");
+#endif
+#if defined(_POSIX_V8_LP64_OFF64) && _POSIX_V8_LP64_OFF64 > 0
+_Static_assert(sizeof(int) == 4 && sizeof(long) == 8 && sizeof(void *) == 8 && sizeof(off_t) == 8,
+               "LP64_OFF64");
+#endif
+#if defined(_POSIX_V8_LPBIG_OFFBIG) && _POSIX_V8_LPBIG_OFFBIG > 0
+_Static_assert(sizeof(int) >= 4 && sizeof(long) >= 8 && sizeof(void *) >= 8 && sizeof(off_t) >= 8,
+               "LPBIG_OFFBIG");
+#endif
+
+/*
+ * glibc 2.43 lacks some of the names; give those distinct stand-ins
+ * so the rest are still checked
+ */
