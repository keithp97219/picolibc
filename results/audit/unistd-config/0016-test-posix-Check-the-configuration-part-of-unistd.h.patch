+#error "_POSIX_THREAD_ROBUST_PRIO_INHERIT"
+#endif
+#if defined(_POSIX_THREAD_ROBUST_PRIO_PROTECT) && _POSIX_THREAD_ROBUST_PRIO_PROTECT != -1     \
