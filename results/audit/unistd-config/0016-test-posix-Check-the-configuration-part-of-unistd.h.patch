+#define _POSIX_C_SOURCE 202405L
+/* gethostid, crypt, encrypt and swab are XSI, as is _XOPEN_VERSION */
+#define _XOPEN_SOURCE 800
+#include <unistd.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+
+/*
+ * <unistd.h>'s configuration part: the version and option macros take
+ * the values POSIX allows, every _SC_, _PC_ and _CS_ name POSIX lists
+ * is defined and distinct (only _SC_PAGESIZE and _SC_PAGE_SIZE may
+ * match, so _SC_PAGE_SIZE is left out), and sysconf and confstr accept them all. The getopt
+ * variables and the remaining functions have the types POSIX gives.
+ */
+
+/* Version test macros */
+#if defined(_POSIX_VERSION) && _POSIX_VERSION != 202405L && _POSIX_VERSION != 200809L \
+    && _POSIX_VERSION != 200112L
+#error "_POSIX_VERSION"
+#endif
+#if defined(_POSIX2_VERSION) && _POSIX2_VERSION != 202405L && _POSIX2_VERSION != 200809L \
+    && _POSIX2_VERSION != 200112L && _POSIX2_VERSION != -1
+#error "_POSIX2_VERSION"
+#endif
+/* An XSI implementation conforming to POSIX.1-2024 is version 800; glibc is 700 */
+#if defined(_XOPEN_VERSION) && _XOPEN_VERSION != 800 && !defined(__GLIBC__)
+#error "_XOPEN_VERSION"
+#endif
+
+/* Options that, when defined, are -1, 0 or 202405L */
+/* glibc defines these to its POSIX.1-2008 values */
+#ifndef __GLIBC__
+#if defined(_POSIX_ADVISORY_INFO) && _POSIX_ADVISORY_INFO != -1 && _POSIX_ADVISORY_INFO != 0 \
+    && _POSIX_ADVISORY_INFO != 202405L
+#error "_POSIX_ADVISORY_INFO"
+#endif
+#if defined(_POSIX_CPUTIME) && _POSIX_CPUTIME != -1 && _POSIX_CPUTIME != 0 \
+    && _POSIX_CPUTIME != 202405L
+#error "_POSIX_CPUTIME"
+#endif
+#if defined(_POSIX_DEVICE_CONTROL) && _POSIX_DEVICE_CONTROL != -1 && _POSIX_DEVICE_CONTROL != 0 \
+    && _POSIX_DEVICE_CONTROL != 202405L
+#error "_POSIX_DEVICE_CONTROL"
+#endif
+#if defined(_POSIX_FSYNC) && _POSIX_FSYNC != -1 && _POSIX_FSYNC != 0 && _POSIX_FSYNC != 202405L
+#error "_POSIX_FSYNC"
+#endif
+#if defined(_POSIX_IPV6) && _POSIX_IPV6 != -1 && _POSIX_IPV6 != 0 && _POSIX_IPV6 != 202405L
+#error "_POSIX_IPV6"
+#endif
+#if defined(_POSIX_MEMLOCK) && _POSIX_MEMLOCK != -1 && _POSIX_MEMLOCK != 0 \
+    && _POSIX_MEMLOCK != 202405L
+#error "_POSIX_MEMLOCK"
+#endif
+#if defined(_POSIX_MEMLOCK_RANGE) && _POSIX_MEMLOCK_RANGE != -1 && _POSIX_MEMLOCK_RANGE != 0 \
+    && _POSIX_MEMLOCK_RANGE != 202405L
+#error "_POSIX_MEMLOCK_RANGE"
+#endif
+#if defined(_POSIX_MESSAGE_PASSING) && _POSIX_MESSAGE_PASSING != -1 && _POSIX_MESSAGE_PASSING != 0 \
