+#define _CS_POSIX_V7_THREADS_LDFLAGS (-1000 - 11)
+#endif
+#ifndef _CS_POSIX_V8_ILP32_OFF32_CFLAGS
+#define _CS_POSIX_V8_ILP32_OFF32_CFLAGS (-1000 - 12)
