+#define _POSIX_C_SOURCE 202405L
+#define _XOPEN_SOURCE   800
+#include <errno.h>
+#include <unistd.h>
+
+/*
+ * picolibc provides no password hashing algorithm, so crypt fails
+ * with ENOSYS, as POSIX allows; _XOPEN_CRYPT is left undefined.
+ */
+char *
+crypt(const char *key, const char *salt)
+{
+    (void)key;
+    (void)salt;
+    errno = ENOSYS;
+    return NULL;
+}
