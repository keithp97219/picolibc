+#define _POSIX_C_SOURCE 202405L
+#define _XOPEN_SOURCE   800
+#include <errno.h>
+#include <stdlib.h>
+
+/* No encoding algorithm is provided, so there is no key to set */
+void
+setkey(const char *key)
+{
+    (void)key;
+    errno = ENOSYS;
+}
