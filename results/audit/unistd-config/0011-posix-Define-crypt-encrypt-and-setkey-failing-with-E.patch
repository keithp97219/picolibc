From a89d78f127e9c02df595948dfbea80f67c8dc26c Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 05:12:39 +0000
Subject: [PATCH 11/20] posix: Define crypt, encrypt and setkey, failing with
 ENOSYS

<unistd.h> and <stdlib.h> declared them for XSI but nothing defined
them, so programs using them failed to link. POSIX lets each fail with
ENOSYS when the encryption functionality isn't supported, which
_XOPEN_CRYPT being undefined already says. encrypt's prototype now has
the char [64] parameter POSIX gives it.
---
 libc/include/sys/unistd.h        |  2 +-
 libc/posix/stdlib/CMakeLists.txt |  1 +
 libc/posix/stdlib/meson.build    |  1 +
 libc/posix/stdlib/setkey.c       | 47 +++++++++++++++++++++++++++++
 libc/posix/unistd/CMakeLists.txt |  2 ++
 libc/posix/unistd/crypt.c        | 52 ++++++++++++++++++++++++++++++++
 libc/posix/unistd/encrypt.c      | 48 +++++++++++++++++++++++++++++
 libc/posix/unistd/meson.build    |  2 ++
 8 files changed, 154 insertions(+), 1 deletion(-)
 create mode 100644 libc/posix/stdlib/setkey.c
 create mode 100644 libc/posix/unistd/crypt.c
 create mode 100644 libc/posix/unistd/encrypt.c

diff --git a/libc/include/sys/unistd.h b/libc/include/sys/unistd.h
index 5487607765..a301569c8a 100644
--- a/libc/include/sys/unistd.h
+++ b/libc/include/sys/unistd.h
@@ -113,7 +113,7 @@ int dup3(int __fildes, int __fildes2, int __flag) __picolibc_export;
 int eaccess(const char *__path, int __mode) __picolibc_export;
 #endif
 #if __XSI_VISIBLE
-void encrypt(char *, int) __picolibc_export;
+void encrypt(char __block[64], int __edflag) __picolibc_export;
 #endif
 #if __BSD_VISIBLE || (__XSI_VISIBLE && __XSI_VISIBLE < 500)
 void endusershell(void) __picolibc_export;
diff --git a/libc/posix/stdlib/CMakeLists.txt b/libc/posix/stdlib/CMakeLists.txt
