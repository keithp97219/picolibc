+#define _XOPEN_SOURCE   800
+#include <errno.h>
+#include <unistd.h>
+
+/* No encoding algorithm is provided; the block is left alone */
+void
+encrypt(char block[64], int edflag)
+{
+    (void)block;
+    (void)edflag;
+    errno = ENOSYS;
