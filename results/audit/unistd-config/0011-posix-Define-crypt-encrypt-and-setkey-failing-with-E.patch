index 2519b2a404..f644f72f1a 100644
--- a/libc/posix/stdlib/meson.build
+++ b/libc/posix/stdlib/meson.build
@@ -36,4 +36,5 @@
 
 dir_srcs = [
   'realpath.c',
+  'setkey.c',
 ]
diff --git a/libc/posix/stdlib/setkey.c b/libc/posix/stdlib/setkey.c
