diff --git a/libc/posix/unistd/crypt.c b/libc/posix/unistd/crypt.c
new file mode 100644
index 0000000000..c15362b226
--- /dev/null
+++ b/libc/posix/unistd/crypt.c
@@ -0,0 +1,52 @@
