 #endif
-    ;
+
+static const char envs_v7[] = "" ENVS("V7");
+static const char envs_v8[] = "" ENVS("V8");
 
 /*
  * _CS_PATH and the width-restricted environments have values. The
@@ -86,13 +96,17 @@ confstr(int name, char *buf, size_t len)
