diff --git a/test/test-posix/test-unistd/test-crypt.c b/test/test-posix/test-unistd/test-crypt.c
new file mode 100644
index 0000000000..f312e4a026
--- /dev/null
+++ b/test/test-posix/test-unistd/test-crypt.c
@@ -0,0 +1,107 @@
