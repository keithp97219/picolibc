From ff36345f56ce69bde80e46c4801a40e4ea845760 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 05:04:07 +0000
Subject: [PATCH 04/20] unistd.h: Don't declare optreset

optreset is a BSD getopt extension that POSIX doesn't reserve for
<unistd.h>, and nothing in picolibc defines it, so the declaration only
took the name from applications and failed to link when used.
---
 libc/include/sys/unistd.h | 1 -
 1 file changed, 1 deletion(-)

diff --git a/libc/include/sys/unistd.h b/libc/include/sys/unistd.h
index 65a94bd7d4..5487607765 100644
--- a/libc/include/sys/unistd.h
+++ b/libc/include/sys/unistd.h
@@ -319,7 +319,6 @@ extern __picolibc_export int   optind;
 extern __picolibc_export int   opterr;
 extern __picolibc_export int   optopt;
 int                            getopt(int, char                            *const[], const char *) __picolibc_export;
-extern __picolibc_export int   optreset; /* getopt(3) external variable */
 
 #if __BSD_VISIBLE || (__XSI_VISIBLE >= 4 && __POSIX_VISIBLE < 200809)
 pid_t vfork(void) __picolibc_export;
-- 
2.47.3

