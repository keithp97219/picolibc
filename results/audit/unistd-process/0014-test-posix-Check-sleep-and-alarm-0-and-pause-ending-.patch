From 464ed65a52151a15d1f12c54687ad5e9f66b6ec1 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:51:23 +0000
Subject: [PATCH 14/15] test-posix: Check sleep, and alarm(0) and pause ending
 the process

---
 test/test-posix/test-unistd/CMakeLists.txt |   1 +
 test/test-posix/test-unistd/meson.build    |   1 +
 test/test-posix/test-unistd/test-alarm.c   |  28 ++++
 test/test-posix/test-unistd/test-pause.c   |  23 +++-
 test/test-posix/test-unistd/test-sleep.c   | 150 +++++++++++++++++++++
 5 files changed, 202 insertions(+), 1 deletion(-)
 create mode 100644 test/test-posix/test-unistd/test-sleep.c

diff --git a/test/test-posix/test-unistd/CMakeLists.txt b/test/test-posix/test-unistd/CMakeLists.txt
index 83881d3dde..3b08516113 100644
--- a/test/test-posix/test-unistd/CMakeLists.txt
+++ b/test/test-posix/test-unistd/CMakeLists.txt
@@ -90,6 +90,7 @@ set(tests
   test-setreuid
   test-setsid
   test-setuid
+  test-sleep
   test-setuid-thread
   test-symlinkat
   test-sync
diff --git a/test/test-posix/test-unistd/meson.build b/test/test-posix/test-unistd/meson.build
index eb6494c4b3..da739e589d 100644
--- a/test/test-posix/test-unistd/meson.build
+++ b/test/test-posix/test-unistd/meson.build
@@ -88,6 +88,7 @@ dir_tests = [
   'test-setreuid',
   'test-setsid',
   'test-setuid',
+  'test-sleep',
   'test-symlinkat',
   'test-sync',
   'test-sysconf',
diff --git a/test/test-posix/test-unistd/test-alarm.c b/test/test-posix/test-unistd/test-alarm.c
index a5115a8976..288bcf5226 100644
--- a/test/test-posix/test-unistd/test-alarm.c
+++ b/test/test-posix/test-unistd/test-alarm.c
@@ -39,6 +39,7 @@
 /* Without the system support this test needs, it is skipped */
 #if defined(__PICOLIBC_POSIX_MULTI_PROCESS) && defined(__PICOLIBC_POSIX_SIGNALS)
 
+#include <limits.h>
 #include <unistd.h>
 #include <stdio.h>
 #include <signal.h>
@@ -100,6 +101,33 @@ main(void)
         break;
     }
 
+    /* alarm(0) cancels the request and reports the time that was left */
+    alarm(5);
+    prev = alarm(0);
+    if (prev < 4 || prev > 5) {
+        printf("alarm(0) returned %u instead of 4 or 5\n", prev);
+        ret = 1;
+    }
+    prev = alarm(0);
+    if (prev != 0) {
+        printf("alarm(0) after cancelling returned %u\n", prev);
+        ret = 1;
+    }
+
+    /*
+     * The longest request still reports time left. On 32-bit targets
+     * glibc's setitimer fails with EOVERFLOW for UINT_MAX seconds, so
+     * its alarm sets nothing
+     */
+#if !defined(__GLIBC__) || __SIZEOF_LONG__ > 4
+    alarm(UINT_MAX);
+    prev = alarm(0);
+    if (prev == 0) {
+        printf("alarm(0) after alarm(UINT_MAX) returned 0\n");
+        ret = 1;
+    }
+#endif
+
     return ret;
 }
 
diff --git a/test/test-posix/test-unistd/test-pause.c b/test/test-posix/test-unistd/test-pause.c
index ddcec75df3..9953f3274e 100644
--- a/test/test-posix/test-unistd/test-pause.c
+++ b/test/test-posix/test-unistd/test-pause.c
@@ -46,8 +46,11 @@
 #include <string.h>
 #include <time.h>
 #include <unistd.h>
+#if defined(__PICOLIBC_POSIX_MULTI_PROCESS)
+#include <sys/wait.h>
+#endif
 
-/* pause returns once a handler has run */
+/* pause returns once a handler has run, and never when the signal ends the process */
 
 #define check(condition, message)                      \
     do {                                               \
@@ -82,6 +85,24 @@ main(void)
     check(pause() == -1 && errno == EINTR, "pause");
     check(caught == SIGALRM, "pause woken by SIGALRM");
 
+#if defined(__PICOLIBC_POSIX_MULTI_PROCESS)
+    {
+        pid_t pid;
+        int   status;
+
+        fflush(stdout);
+        pid = fork();
+        check(pid >= 0, "fork");
+        if (pid == 0) {
+            pause();
+            _exit(1);
+        }
+        check(kill(pid, SIGTERM) == 0, "kill");
+        check(waitpid(pid, &status, 0) == pid, "waitpid");
+        check(WIFSIGNALED(status) && WTERMSIG(status) == SIGTERM, "pause didn't return");
+    }
+#endif
+
     printf("success\n");
     return 0;
 }
diff --git a/test/test-posix/test-unistd/test-sleep.c b/test/test-posix/test-unistd/test-sleep.c
new file mode 100644
index 0000000000..aa8f4517b2
--- /dev/null
+++ b/test/test-posix/test-unistd/test-sleep.c
@@ -0,0 +1,150 @@
