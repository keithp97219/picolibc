+        errno = 0;
+        check(setegid(other_id(r, e, r)) == -1 && errno == EPERM, "another ID gives EPERM");
+        check(getgid() == r && getegid() == r, "IDs kept after EPERM");
+    }
 
     printf("success\n");
     return 0;
