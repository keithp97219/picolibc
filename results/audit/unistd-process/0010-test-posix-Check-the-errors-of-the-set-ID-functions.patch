From 867d2f2a85dc406c434a708b54322dc6e33f8e48 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:51:23 +0000
Subject: [PATCH 10/15] test-posix: Check the errors of the set-ID functions

EINVAL for an invalid ID, EPERM for IDs the process doesn't hold,
nothing changed after a failure, the supplementary groups kept by
setuid and setgid, getgroups' size checks and, when privileged, that
seteuid and setegid keep the saved ID.
---
 test/test-posix/test-unistd/test-getgroups.c | 17 +++++-
 test/test-posix/test-unistd/test-getresgid.c | 56 ++++++++++++++++++--
 test/test-posix/test-unistd/test-getresuid.c | 56 ++++++++++++++++++--
 test/test-posix/test-unistd/test-setegid.c   | 30 ++++++++++-
 test/test-posix/test-unistd/test-seteuid.c   | 30 ++++++++++-
 test/test-posix/test-unistd/test-setgid.c    | 38 ++++++++++++-
 test/test-posix/test-unistd/test-setregid.c  | 31 +++++++++--
 test/test-posix/test-unistd/test-setreuid.c  | 31 +++++++++--
 test/test-posix/test-unistd/test-setuid.c    | 38 ++++++++++++-
 9 files changed, 302 insertions(+), 25 deletions(-)

diff --git a/test/test-posix/test-unistd/test-getgroups.c b/test/test-posix/test-unistd/test-getgroups.c
index 0da1d30df3..b0872e12c9 100644
--- a/test/test-posix/test-unistd/test-getgroups.c
+++ b/test/test-posix/test-unistd/test-getgroups.c
@@ -39,12 +39,13 @@
 /* Without the system support this test needs, it is skipped */
 #if defined(__PICOLIBC_POSIX_USER_GROUPS)
 
+#include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <unistd.h>
 
-/* getgroups reports the count and fills in every entry completely */
+/* getgroups reports the count, fills in every entry completely and checks the size */
 
 #define check(condition, message)                      \
     do {                                               \
@@ -71,6 +72,20 @@ main(void)
     for (int i = 0; i < ngroups; i++)
         check((groups[i] >> 16) != 0xffff, "getgroups entry filled in");
 
+    /* A size of zero only counts, leaving the array alone */
+    memset(groups, 0xab, sizeof(groups));
+    check(getgroups(0, groups) == ngroups, "count");
+    for (size_t i = 0; i < sizeof(groups); i++)
+        check(((unsigned char *)groups)[i] == 0xab, "array untouched");
+
+    /* An array too small for the list */
+    if (ngroups >= 2) {
+        errno = 0;
+        check(getgroups(ngroups - 1, groups) == -1 && errno == EINVAL, "EINVAL");
+    } else {
+        printf("%d groups, skipping the EINVAL check\n", ngroups);
+    }
+
     printf("success\n");
     return 0;
 }
diff --git a/test/test-posix/test-unistd/test-getresgid.c b/test/test-posix/test-unistd/test-getresgid.c
index 56267c7ad4..fcae848e25 100644
--- a/test/test-posix/test-unistd/test-getresgid.c
+++ b/test/test-posix/test-unistd/test-getresgid.c
@@ -43,11 +43,12 @@
 #include "../posix-groups.h"
 
 /* Without the system support this test needs, it is skipped */
-#if defined(__PICOLIBC_POSIX_USER_GROUPS)
+#if defined(__PICOLIBC_POSIX_USER_GROUPS) && defined(__PICOLIBC_POSIX_MULTI_PROCESS)
 
 #include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <sys/wait.h>
 
 /* getresgid reports and setresgid sets the real, effective and saved ids */
 
@@ -59,16 +60,63 @@
         }                                              \
     } while (0)
 
+/* Returns an ID the process holds in none of its real, effective or saved IDs */
+static gid_t
+other_id(gid_t a, gid_t b, gid_t c)
+{
+    gid_t id = a + 1;
+
+    while (id == a || id == b || id == c || id == (gid_t)-1 || id == 0)
+        id++;
+    return id;
+}
+
 int
 main(void)
 {
-    gid_t r, e, s;
+    gid_t r, e, s, r2, e2, s2, other;
 
     check(getresgid(&r, &e, &s) == 0, "getresgid");
     check(r == getgid() && e == getegid(), "real and effective");
-    check(setresgid(r, e, s) == 0, "setresgid same ids");
+    check(setresgid(r, e, s) == 0, "setresgid same IDs");
     check(setresgid((gid_t)-1, (gid_t)-1, (gid_t)-1) == 0, "setresgid unchanged");
-    check(getresgid(&r, &e, &s) == 0 && r == getgid() && e == getegid(), "kept");
+    /* Each ID may be set to any of the three */
+    check(setresgid(s, r, e) == 0 && setresgid(r, e, s) == 0, "setresgid permuted");
+    check(getresgid(&r2, &e2, &s2) == 0 && r2 == r && e2 == e && s2 == s, "kept");
+    if (geteuid() == 0) {
+        pid_t pid;
+        int   status;
+
+        /* setegid leaves the saved ID alone, so the old effective ID can come back */
+        fflush(stdout);
+        pid = fork();
+        check(pid >= 0, "fork");
+        if (pid == 0) {
+            if (setresgid(1000, 0, 0) != 0 || setegid(3000) != 0)
+                _exit(1);
+            if (getresgid(&r2, &e2, &s2) != 0 || r2 != 1000 || e2 != 3000 || s2 != 0)
+                _exit(2);
+            if (setegid(0) != 0 || setegid(1000) != 0 || getresgid(&r2, &e2, &s2) != 0 || s2 != 0)
+                _exit(3);
+            _exit(0);
+        }
+        check(waitpid(pid, &status, 0) == pid && WIFEXITED(status), "waitpid");
+        check(WEXITSTATUS(status) == 0, "setegid kept the saved ID");
+        printf("privileged, skipping the EPERM checks\n");
+    } else {
+        other = other_id(r, e, s);
+        /* A failing call changes none of the IDs */
+        errno = 0;
+        check(setresgid(r, e, other) == -1 && errno == EPERM, "another saved ID");
+        errno = 0;
+        check(setresgid(other, e, s) == -1 && errno == EPERM, "another real ID");
+        errno = 0;
+        check(setresgid((gid_t)-1, other, (gid_t)-1) == -1 && errno == EPERM,
+              "another effective ID");
+        check(getresgid(&r2, &e2, &s2) == 0 && r2 == r && e2 == e && s2 == s,
+              "IDs kept after EPERM");
+    }
+
     printf("success\n");
     return 0;
 }
