From 248b0b0dbfdf0e640d06e68cb1c05d76ff328f38 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:51:23 +0000
Subject: [PATCH 11/15] test-posix: Check nice's limits and that it changes
 every thread

---
 test/test-posix/test-unistd/CMakeLists.txt    |   1 +
 test/test-posix/test-unistd/meson.build       |   1 +
 .../test-posix/test-unistd/test-nice-thread.c | 124 ++++++++++++++++++
 test/test-posix/test-unistd/test-nice.c       |  32 +++++
 4 files changed, 158 insertions(+)
 create mode 100644 test/test-posix/test-unistd/test-nice-thread.c

diff --git a/test/test-posix/test-unistd/CMakeLists.txt b/test/test-posix/test-unistd/CMakeLists.txt
index 2c8f4729cf..a446e4434d 100644
--- a/test/test-posix/test-unistd/CMakeLists.txt
+++ b/test/test-posix/test-unistd/CMakeLists.txt
@@ -70,6 +70,7 @@ set(tests
   test-linkat
   test-lockf
   test-nice
+  test-nice-thread
   test-pathconf
   test-pause
   test-pipe2
diff --git a/test/test-posix/test-unistd/meson.build b/test/test-posix/test-unistd/meson.build
index e5ccf1170a..e1a4686a2c 100644
--- a/test/test-posix/test-unistd/meson.build
+++ b/test/test-posix/test-unistd/meson.build
@@ -97,6 +97,7 @@ dir_tests = [
 # These check credentials across threads
 dir_thread_tests = [
   'test-execl-thread',
+  'test-nice-thread',
   'test-setuid-thread',
 ]
 
diff --git a/test/test-posix/test-unistd/test-nice-thread.c b/test/test-posix/test-unistd/test-nice-thread.c
new file mode 100644
index 0000000000..5803e9cce7
--- /dev/null
+++ b/test/test-posix/test-unistd/test-nice-thread.c
@@ -0,0 +1,124 @@
