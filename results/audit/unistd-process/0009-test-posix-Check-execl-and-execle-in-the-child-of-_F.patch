From c3105ba246a59db517224c377bda5a483610c5f1 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:51:23 +0000
Subject: [PATCH 09/15] test-posix: Check execl and execle in the child of
 _Fork with threads

They are async-signal-safe, so they must work in the child of _Fork
while another thread was allocating memory. Also check that exec and
_exit end every thread without cleanup handlers or destructors.
---
 test/test-posix/test-unistd/CMakeLists.txt    |   1 +
 test/test-posix/test-unistd/meson.build       |   1 +
 .../test-unistd/test-execl-thread.c           | 234 ++++++++++++++++++
 3 files changed, 236 insertions(+)
 create mode 100644 test/test-posix/test-unistd/test-execl-thread.c

diff --git a/test/test-posix/test-unistd/CMakeLists.txt b/test/test-posix/test-unistd/CMakeLists.txt
index be9bcf7b16..2c8f4729cf 100644
--- a/test/test-posix/test-unistd/CMakeLists.txt
+++ b/test/test-posix/test-unistd/CMakeLists.txt
@@ -41,6 +41,7 @@ set(tests
   test-confstr
   test-dup3
   test-execl
+  test-execl-thread
   test-execle
   test-execvp
   test-faccessat
diff --git a/test/test-posix/test-unistd/meson.build b/test/test-posix/test-unistd/meson.build
index 4377fac5a3..e5ccf1170a 100644
--- a/test/test-posix/test-unistd/meson.build
+++ b/test/test-posix/test-unistd/meson.build
@@ -96,6 +96,7 @@ dir_tests = [
 
 # These check credentials across threads
 dir_thread_tests = [
+  'test-execl-thread',
   'test-setuid-thread',
 ]
 
diff --git a/test/test-posix/test-unistd/test-execl-thread.c b/test/test-posix/test-unistd/test-execl-thread.c
new file mode 100644
index 0000000000..50e7f3d1a7
--- /dev/null
+++ b/test/test-posix/test-unistd/test-execl-thread.c
@@ -0,0 +1,234 @@
