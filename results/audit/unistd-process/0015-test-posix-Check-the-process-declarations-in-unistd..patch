+#define _POSIX_C_SOURCE 202405L
+/* The application's own macros, defined before the header */
+#define name     +
+#define namesize +
+#include <unistd.h>
+
+#include <stdio.h>
+
+/*
+ * In strict POSIX mode, without XSI, <unistd.h> declares none of the
+ * XSI process functions, nothing Issue 7 or 8 removed and no
+ * extensions, and its prototypes don't use the application's names
+ */
+
+/* XSI interfaces */
+static int nice;
+static int setregid;
+static int setreuid;
+static int getresgid;
+static int getresuid;
+static int setresgid;
+static int setresuid;
+
+/* Removed interfaces */
+static int setpgrp;
+static int ualarm;
+static int usleep;
+static int vfork;
+
+/* Extensions */
+static int execvpe;
+static int execlpe;
+static int setgroups;
+static int issetugid;
+static int daemon;
+
+int
+main(void)
+{
+    (void)nice;
+    (void)setregid;
+    (void)setreuid;
+    (void)getresgid;
+    (void)getresuid;
+    (void)setresgid;
+    (void)setresuid;
+    (void)setpgrp;
+    (void)ualarm;
+    (void)usleep;
+    (void)vfork;
+    (void)execvpe;
+    (void)execlpe;
+    (void)setgroups;
+    (void)issetugid;
+    (void)daemon;
+    printf("success\n");
+    return 0;
+}
diff --git a/test/test-posix/test-unistd/test-unistd_h-process.c b/test/test-posix/test-unistd/test-unistd_h-process.c
new file mode 100644
index 0000000000..22e796c11b
--- /dev/null
+++ b/test/test-posix/test-unistd/test-unistd_h-process.c
@@ -0,0 +1,120 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright © 2026 Keith Packard
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ *
