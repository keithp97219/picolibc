From 69e0e524f7cb27ba8da63d994ead667089a41e00 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:51:23 +0000
Subject: [PATCH 15/15] test-posix: Check the process declarations in
 <unistd.h>

The types of every process function, and in strict mode no XSI
process functions, removed interfaces, extensions or application
names in the prototypes.
---
 test/test-posix/test-unistd/CMakeLists.txt    |   2 +
 test/test-posix/test-unistd/meson.build       |   2 +
 .../test-unistd/test-unistd_h-names.c         |  93 ++++++++++++++
 .../test-unistd/test-unistd_h-process.c       | 120 ++++++++++++++++++
 4 files changed, 217 insertions(+)
 create mode 100644 test/test-posix/test-unistd/test-unistd_h-names.c
 create mode 100644 test/test-posix/test-unistd/test-unistd_h-process.c

diff --git a/test/test-posix/test-unistd/CMakeLists.txt b/test/test-posix/test-unistd/CMakeLists.txt
index 3b08516113..6fda93cf05 100644
--- a/test/test-posix/test-unistd/CMakeLists.txt
+++ b/test/test-posix/test-unistd/CMakeLists.txt
@@ -98,6 +98,8 @@ set(tests
   test-tcsetpgrp
   test-truncate
   test-ttyname_r
+  test-unistd_h-names
+  test-unistd_h-process
   test-unlinkat
   )
 
diff --git a/test/test-posix/test-unistd/meson.build b/test/test-posix/test-unistd/meson.build
index da739e589d..270d70b426 100644
--- a/test/test-posix/test-unistd/meson.build
+++ b/test/test-posix/test-unistd/meson.build
@@ -95,6 +95,8 @@ dir_tests = [
   'test-tcsetpgrp',
   'test-truncate',
   'test-ttyname_r',
+  'test-unistd_h-names',
+  'test-unistd_h-process',
   'test-unlinkat',
 ]
 
diff --git a/test/test-posix/test-unistd/test-unistd_h-names.c b/test/test-posix/test-unistd/test-unistd_h-names.c
new file mode 100644
index 0000000000..eb27b7634b
--- /dev/null
+++ b/test/test-posix/test-unistd/test-unistd_h-names.c
@@ -0,0 +1,93 @@
