From d08946af5bc6c3b48146415eb31ab10322b75fd6 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:30:08 +0000
Subject: [PATCH 13/21] test-posix: Check the types, constants, prototypes and
 namespace of <dirent.h>

Includes checking that application macros named like DIR's old members
don't break the header, and that the XSI functions and extensions stay
hidden in strict POSIX mode.
---
 test/test-posix/test-dirent/CMakeLists.txt  |   1 +
 test/test-posix/test-dirent/meson.build     |   1 +
 test/test-posix/test-dirent/test-dirent_h.c | 210 ++++++++++++++++++++
 3 files changed, 212 insertions(+)
 create mode 100644 test/test-posix/test-dirent/test-dirent_h.c

diff --git a/test/test-posix/test-dirent/CMakeLists.txt b/test/test-posix/test-dirent/CMakeLists.txt
index e8eb928995..010899c246 100644
--- a/test/test-posix/test-dirent/CMakeLists.txt
+++ b/test/test-posix/test-dirent/CMakeLists.txt
@@ -35,6 +35,7 @@
 
 set(tests
   test-alphasort
+  test-dirent_h
   test-dirfd
   test-fdopendir
   test-posix_getdents
diff --git a/test/test-posix/test-dirent/meson.build b/test/test-posix/test-dirent/meson.build
index 0c9c8b32b8..fa7e2c1e25 100644
--- a/test/test-posix/test-dirent/meson.build
+++ b/test/test-posix/test-dirent/meson.build
@@ -35,6 +35,7 @@
 
 dir_tests = [
   'test-alphasort',
+  'test-dirent_h',
   'test-dirfd',
   'test-fdopendir',
   'test-posix_getdents',
diff --git a/test/test-posix/test-dirent/test-dirent_h.c b/test/test-posix/test-dirent/test-dirent_h.c
new file mode 100644
index 0000000000..ea402be0e4
--- /dev/null
+++ b/test/test-posix/test-dirent/test-dirent_h.c
@@ -0,0 +1,210 @@
