From 2b8da02965af20f542a17675e0e39f40f7bff4ef Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 22:30:08 +0000
Subject: [PATCH 14/21] test-posix: Check close-on-exec, entries, rewinding and
 errors in opendir

---
 test/test-posix/test-dirent/CMakeLists.txt |   1 +
 test/test-posix/test-dirent/meson.build    |   1 +
 test/test-posix/test-dirent/test-opendir.c | 230 +++++++++++++++++++++
 3 files changed, 232 insertions(+)
 create mode 100644 test/test-posix/test-dirent/test-opendir.c

diff --git a/test/test-posix/test-dirent/CMakeLists.txt b/test/test-posix/test-dirent/CMakeLists.txt
index 010899c246..7839f87127 100644
--- a/test/test-posix/test-dirent/CMakeLists.txt
+++ b/test/test-posix/test-dirent/CMakeLists.txt
@@ -38,6 +38,7 @@ set(tests
   test-dirent_h
   test-dirfd
   test-fdopendir
+  test-opendir
   test-posix_getdents
   test-readdir
   test-readdir_r
diff --git a/test/test-posix/test-dirent/meson.build b/test/test-posix/test-dirent/meson.build
index fa7e2c1e25..6ddee8629c 100644
--- a/test/test-posix/test-dirent/meson.build
+++ b/test/test-posix/test-dirent/meson.build
@@ -38,6 +38,7 @@ dir_tests = [
   'test-dirent_h',
   'test-dirfd',
   'test-fdopendir',
+  'test-opendir',
   'test-posix_getdents',
   'test-readdir',
   'test-readdir_r',
diff --git a/test/test-posix/test-dirent/test-opendir.c b/test/test-posix/test-dirent/test-opendir.c
new file mode 100644
index 0000000000..d34b31c6af
--- /dev/null
+++ b/test/test-posix/test-dirent/test-opendir.c
@@ -0,0 +1,230 @@
