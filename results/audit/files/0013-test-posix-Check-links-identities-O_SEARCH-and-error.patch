From 70cf40a873ad1cd9453014a2ca1c3fbfd6ef7cf0 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 20:04:28 +0000
Subject: [PATCH 13/23] test-posix: Check links, identities, O_SEARCH and
 errors in stat, lstat and fstatat

---
 test/test-posix/test-sys-stat/CMakeLists.txt |   1 +
 test/test-posix/test-sys-stat/meson.build    |   1 +
 test/test-posix/test-sys-stat/test-lstat.c   | 220 +++++++++++++++++++
 3 files changed, 222 insertions(+)
 create mode 100644 test/test-posix/test-sys-stat/test-lstat.c

diff --git a/test/test-posix/test-sys-stat/CMakeLists.txt b/test/test-posix/test-sys-stat/CMakeLists.txt
index 2c1f7c5548..5cadb269ca 100644
--- a/test/test-posix/test-sys-stat/CMakeLists.txt
+++ b/test/test-posix/test-sys-stat/CMakeLists.txt
@@ -39,6 +39,7 @@ set(tests
   test-fchmodat
   test-fstatat
   test-futimens
+  test-lstat
   test-mkdirat
   test-mkfifo
   test-mkfifoat
diff --git a/test/test-posix/test-sys-stat/meson.build b/test/test-posix/test-sys-stat/meson.build
index 14c46c5b65..915c39d855 100644
--- a/test/test-posix/test-sys-stat/meson.build
+++ b/test/test-posix/test-sys-stat/meson.build
@@ -39,6 +39,7 @@ dir_tests = [
   'test-fchmodat',
   'test-fstatat',
   'test-futimens',
+  'test-lstat',
   'test-mkdirat',
   'test-mkfifo',
   'test-mkfifoat',
diff --git a/test/test-posix/test-sys-stat/test-lstat.c b/test/test-posix/test-sys-stat/test-lstat.c
new file mode 100644
index 0000000000..ce20d5da64
--- /dev/null
+++ b/test/test-posix/test-sys-stat/test-lstat.c
@@ -0,0 +1,220 @@
