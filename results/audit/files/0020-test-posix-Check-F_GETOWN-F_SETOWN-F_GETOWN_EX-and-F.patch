 test/test-posix/test-fcntl/meson.build        |   1 +
 .../test-posix/test-fcntl/test-fcntl-setown.c | 163 ++++++++++++++++++
 3 files changed, 165 insertions(+)
 create mode 100644 test/test-posix/test-fcntl/test-fcntl-setown.c

