From f93de59d7d5e7e0c8376fd594ef4e142fb72b148 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 06:54:47 +0000
Subject: [PATCH 17/19] test-posix: Check the gettext _l functions and the
 POSIX locale's messages

Check <libintl.h>'s prototypes; that every gettext function, with and
without _l, returns msgid or msgid_plural by n without touching errno,
also with LANGUAGE, NLSPATH and a binding pointing at a file; that
the text domain and bindings survive setlocale and uselocale; and that
bindtextdomain returns a copy that a query leaves valid.
---
 test/test-posix/test-libintl/CMakeLists.txt   |   1 +
 test/test-posix/test-libintl/meson.build      |   1 +
 test/test-posix/test-libintl/test-gettext_l.c | 225 ++++++++++++++++++
 3 files changed, 227 insertions(+)
 create mode 100644 test/test-posix/test-libintl/test-gettext_l.c

diff --git a/test/test-posix/test-libintl/CMakeLists.txt b/test/test-posix/test-libintl/CMakeLists.txt
index 762d745577..45ca556eb3 100644
--- a/test/test-posix/test-libintl/CMakeLists.txt
+++ b/test/test-posix/test-libintl/CMakeLists.txt
@@ -37,6 +37,7 @@ set(tests
   test-bind_textdomain_codeset
   test-bindtextdomain
   test-gettext
+  test-gettext_l
   test-textdomain
   )
 
diff --git a/test/test-posix/test-libintl/meson.build b/test/test-posix/test-libintl/meson.build
index 8023dc73c3..78ab3c36f1 100644
--- a/test/test-posix/test-libintl/meson.build
+++ b/test/test-posix/test-libintl/meson.build
@@ -37,5 +37,6 @@ dir_tests = [
   'test-bind_textdomain_codeset',
   'test-bindtextdomain',
   'test-gettext',
+  'test-gettext_l',
   'test-textdomain',
 ]
diff --git a/test/test-posix/test-libintl/test-gettext_l.c b/test/test-posix/test-libintl/test-gettext_l.c
new file mode 100644
index 0000000000..d88c960613
--- /dev/null
+++ b/test/test-posix/test-libintl/test-gettext_l.c
@@ -0,0 +1,225 @@
