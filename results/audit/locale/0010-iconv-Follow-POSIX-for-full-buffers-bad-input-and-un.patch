 iconv_open(const char *tocode, const char *fromcode)
 {
-    if (!tocode || !fromcode)
-        goto fail;
-
-    enum locale_id toid = __find_charset(tocode);
-    enum locale_id fromid = __find_charset(fromcode);
-
-    if (toid == locale_INVALID || fromid == locale_INVALID)
