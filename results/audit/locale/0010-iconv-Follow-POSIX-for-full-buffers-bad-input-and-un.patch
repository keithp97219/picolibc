-
-#ifdef __MB_CAPABLE
     iconv_t     ic;
     const char *mode_name;
     static const struct {
@@ -62,6 +52,16 @@ iconv_open(const char *tocode, const char *fromcode)
 #define NMODE (sizeof(modes) / sizeof(modes[0]))
     size_t            m;
     enum __iconv_mode mode = iconv_default;
+    enum locale_id    toid, fromid;
+
+    if (!tocode || !fromcode)
+        goto fail;
+
+    toid = __find_charset(tocode);
+    fromid = __find_charset(fromcode);
+
+    if (toid == locale_INVALID || fromid == locale_INVALID)
+        goto fail;
 
     mode_name = strchr(tocode, '/');
     if (mode_name) {
@@ -80,15 +80,12 @@ iconv_open(const char *tocode, const char *fromcode)
 
     ic = calloc(1, sizeof(*ic));
     if (!ic)
-        goto fail;
+        return (iconv_t)-1;
 
-    ic->in_mbtowc = __get_mbtowc(fromid);
-    ic->out_wctomb = __get_wctomb(toid);
+    ic->in_mbtowc = __iconv_mbtowc(fromid);
+    ic->out_wctomb = __iconv_wctomb(toid);
     ic->mode = mode;
     return ic;
-#else
-    return NULL;
-#endif
 
 fail:
     errno = EINVAL;
diff --git a/libc/iconv/iconv_private.h b/libc/iconv/iconv_private.h
index 924b294d21..78f2286cd2 100644
--- a/libc/iconv/iconv_private.h
+++ b/libc/iconv/iconv_private.h
@@ -47,10 +47,15 @@ struct __iconv_t {
     wctomb_p          out_wctomb;
     mbstate_t         in_state;
     mbstate_t         out_state;
-    size_t            buf_len;
-    size_t            buf_off;
     enum __iconv_mode mode;
-    char              buf[MB_LEN_MAX];
 };
 
+#ifdef __MB_CAPABLE
+#define __iconv_mbtowc(id) __get_mbtowc(id)
+#define __iconv_wctomb(id) __get_wctomb(id)
+#else
+#define __iconv_mbtowc(id) ((void)(id), __ascii_mbtowc)
+#define __iconv_wctomb(id) ((void)(id), __ascii_wctomb)
+#endif
+
 #endif /* _ICONV_PRIVATE_H_ */
