From b8f73967459cb6bb594de698c5d055b4f648e165 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 06:29:39 +0000
Subject: [PATCH 04/19] langinfo.h: Add ALTMON_1..ALTMON_12 and
 ABALTMON_1..ABALTMON_12

POSIX.1-2024 added these items for the month names used without a day
(%OB and %Ob). The POSIX locale doesn't define them, so nl_langinfo
returns the usual month names. They follow CRNCYSTR so the existing
values don't change.
---
 libc/include/langinfo.h   | 51 +++++++++++++++++++++++++++++++++++++++
 libc/locale/nl_langinfo.c | 27 +++++++++++++++++++++
 2 files changed, 78 insertions(+)

diff --git a/libc/include/langinfo.h b/libc/include/langinfo.h
index f8fcb54e3b..5ce8408322 100644
--- a/libc/include/langinfo.h
+++ b/libc/include/langinfo.h
@@ -170,6 +170,57 @@ enum {
     CRNCYSTR, /* currency symbol */
 #define CRNCYSTR CRNCYSTR
 
+    /* month names used without a day (%OB) */
+    ALTMON_1,
+#define ALTMON_1 ALTMON_1
+    ALTMON_2,
+#define ALTMON_2 ALTMON_2
+    ALTMON_3,
+#define ALTMON_3 ALTMON_3
+    ALTMON_4,
+#define ALTMON_4 ALTMON_4
+    ALTMON_5,
+#define ALTMON_5 ALTMON_5
+    ALTMON_6,
+#define ALTMON_6 ALTMON_6
+    ALTMON_7,
+#define ALTMON_7 ALTMON_7
+    ALTMON_8,
+#define ALTMON_8 ALTMON_8
+    ALTMON_9,
+#define ALTMON_9 ALTMON_9
+    ALTMON_10,
+#define ALTMON_10 ALTMON_10
+    ALTMON_11,
+#define ALTMON_11 ALTMON_11
+    ALTMON_12,
+#define ALTMON_12 ALTMON_12
+
+    /* abbreviated month names used without a day (%Ob) */
+    ABALTMON_1,
+#define ABALTMON_1 ABALTMON_1
+    ABALTMON_2,
+#define ABALTMON_2 ABALTMON_2
+    ABALTMON_3,
+#define ABALTMON_3 ABALTMON_3
+    ABALTMON_4,
+#define ABALTMON_4 ABALTMON_4
+    ABALTMON_5,
+#define ABALTMON_5 ABALTMON_5
+    ABALTMON_6,
+#define ABALTMON_6 ABALTMON_6
+    ABALTMON_7,
+#define ABALTMON_7 ABALTMON_7
+    ABALTMON_8,
+#define ABALTMON_8 ABALTMON_8
+    ABALTMON_9,
+#define ABALTMON_9 ABALTMON_9
+    ABALTMON_10,
+#define ABALTMON_10 ABALTMON_10
+    ABALTMON_11,
+#define ABALTMON_11 ABALTMON_11
+    ABALTMON_12,
+#define ABALTMON_12 ABALTMON_12
 };
 
 _BEGIN_STD_C
diff --git a/libc/locale/nl_langinfo.c b/libc/locale/nl_langinfo.c
index e56d78e891..6f5dc82fdd 100644
--- a/libc/locale/nl_langinfo.c
+++ b/libc/locale/nl_langinfo.c
@@ -97,6 +97,33 @@ nl_langinfo_l(nl_item item, locale_t locale)
     case ABMON_11:
     case ABMON_12:
         return (char *)TIME_MON[item - ABMON_1];
+    /* The POSIX locale has no alternative month names; use the usual ones */
+    case ALTMON_1:
+    case ALTMON_2:
+    case ALTMON_3:
+    case ALTMON_4:
+    case ALTMON_5:
+    case ALTMON_6:
+    case ALTMON_7:
+    case ALTMON_8:
+    case ALTMON_9:
+    case ALTMON_10:
+    case ALTMON_11:
+    case ALTMON_12:
+        return (char *)TIME_MONTH[item - ALTMON_1];
+    case ABALTMON_1:
+    case ABALTMON_2:
+    case ABALTMON_3:
+    case ABALTMON_4:
+    case ABALTMON_5:
+    case ABALTMON_6:
+    case ABALTMON_7:
+    case ABALTMON_8:
+    case ABALTMON_9:
+    case ABALTMON_10:
+    case ABALTMON_11:
+    case ABALTMON_12:
+        return (char *)TIME_MON[item - ABALTMON_1];
     case ERA:
         return TIME_ERA;
     case ERA_D_FMT:
-- 
2.47.3

