From cf199e1eb05c92e1ce7550e5b74ba845179428b7 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 06:53:04 +0000
Subject: [PATCH 16/19] test-posix: Check <nl_types.h> and catopen's failures
 for files

Check the header's types, constants and prototypes, and that catopen
fails with ENOENT for a missing catalog, an empty name and a file that
isn't a catalog, given by pathname or found through NLSPATH.
---
 test/test-posix/test-nl_types/CMakeLists.txt  |   1 +
 test/test-posix/test-nl_types/meson.build     |   1 +
 .../test-nl_types/test-catopen-files.c        | 163 ++++++++++++++++++
 3 files changed, 165 insertions(+)
 create mode 100644 test/test-posix/test-nl_types/test-catopen-files.c

diff --git a/test/test-posix/test-nl_types/CMakeLists.txt b/test/test-posix/test-nl_types/CMakeLists.txt
index acf6bc5462..b48f15f56a 100644
--- a/test/test-posix/test-nl_types/CMakeLists.txt
+++ b/test/test-posix/test-nl_types/CMakeLists.txt
@@ -35,6 +35,7 @@
 
 set(tests
   test-catopen
+  test-catopen-files
   )
 
 foreach(test IN LISTS tests)
diff --git a/test/test-posix/test-nl_types/meson.build b/test/test-posix/test-nl_types/meson.build
index 47dbad71b2..073609546f 100644
--- a/test/test-posix/test-nl_types/meson.build
+++ b/test/test-posix/test-nl_types/meson.build
@@ -35,4 +35,5 @@
 
 dir_tests = [
   'test-catopen',
+  'test-catopen-files',
 ]
diff --git a/test/test-posix/test-nl_types/test-catopen-files.c b/test/test-posix/test-nl_types/test-catopen-files.c
new file mode 100644
index 0000000000..a83730047a
--- /dev/null
+++ b/test/test-posix/test-nl_types/test-catopen-files.c
@@ -0,0 +1,163 @@
