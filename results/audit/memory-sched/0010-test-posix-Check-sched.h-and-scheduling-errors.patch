From 46c0dc8000aa7136b7f73d512ce328137a698bbb Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Fri, 20 Nov 2026 23:55:54 +0000
Subject: [PATCH 10/10] test-posix: Check <sched.h> and scheduling errors

The header's types, constants and strict namespace; priorities outside
each policy's range, leaving the policy unchanged; and EPERM for
another user's process.
---
 test/test-posix/test-sched/CMakeLists.txt     |   1 +
 test/test-posix/test-sched/meson.build        |   1 +
 test/test-posix/test-sched/test-sched_h.c     | 125 ++++++++++++++++++
 .../test-sched/test-sched_setparam.c          |  14 ++
 .../test-sched/test-sched_setscheduler.c      |  39 +++++-
 5 files changed, 179 insertions(+), 1 deletion(-)
 create mode 100644 test/test-posix/test-sched/test-sched_h.c

diff --git a/test/test-posix/test-sched/CMakeLists.txt b/test/test-posix/test-sched/CMakeLists.txt
index 14d920f099..4d9d3757a0 100644
--- a/test/test-posix/test-sched/CMakeLists.txt
+++ b/test/test-posix/test-sched/CMakeLists.txt
@@ -38,6 +38,7 @@ set(tests
   test-sched_get_priority_min
   test-sched_getparam
   test-sched_getscheduler
+  test-sched_h
   test-sched_rr_get_interval
   test-sched_setparam
   test-sched_setscheduler
diff --git a/test/test-posix/test-sched/meson.build b/test/test-posix/test-sched/meson.build
index dea841b7be..678383b3e3 100644
--- a/test/test-posix/test-sched/meson.build
+++ b/test/test-posix/test-sched/meson.build
@@ -38,6 +38,7 @@ dir_tests = [
   'test-sched_get_priority_min',
   'test-sched_getparam',
   'test-sched_getscheduler',
+  'test-sched_h',
   'test-sched_rr_get_interval',
   'test-sched_setparam',
   'test-sched_setscheduler',
diff --git a/test/test-posix/test-sched/test-sched_h.c b/test/test-posix/test-sched/test-sched_h.c
new file mode 100644
index 0000000000..88836c76e5
--- /dev/null
+++ b/test/test-posix/test-sched/test-sched_h.c
@@ -0,0 +1,125 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
