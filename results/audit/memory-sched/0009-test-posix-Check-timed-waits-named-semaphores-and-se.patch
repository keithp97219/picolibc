 .../test-semaphore/test-semaphore_h.c         | 126 ++++++++
 5 files changed, 651 insertions(+)
 create mode 100644 test/test-posix/test-semaphore/test-sem_timedwait.c
 create mode 100644 test/test-posix/test-semaphore/test-sem_unlink.c
 create mode 100644 test/test-posix/test-semaphore/test-semaphore_h.c

