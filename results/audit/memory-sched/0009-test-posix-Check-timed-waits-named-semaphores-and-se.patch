diff --git a/test/test-posix/test-semaphore/test-sem_timedwait.c b/test/test-posix/test-semaphore/test-sem_timedwait.c
new file mode 100644
index 0000000000..c939be22aa
--- /dev/null
+++ b/test/test-posix/test-semaphore/test-sem_timedwait.c
@@ -0,0 +1,248 @@
+/*
