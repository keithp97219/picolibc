From a57cd3d27e7057d609c706063ac2a58cb747faec Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:29:33 +0000
Subject: [PATCH 03/15] aio: Keep appending writes and synchronization in
 queued order

Each request ran in its own thread as soon as it was queued, so
writes to a file opened with O_APPEND, or to a pipe or socket, could
land in any order, and aio_fsync could finish before the requests
queued ahead of it. POSIX has such writes append in the order of the
calls, and aio_fsync complete the I/O queued when it was called. A
write that appends now waits for earlier writes on the same
descriptor, and aio_fsync for every earlier request on it.
---
 libc/posix/aio/__aio_submit.c | 32 ++++++++++++++++++++++++++++++++
 libc/posix/aio/local-aio.h    |  2 ++
 2 files changed, 34 insertions(+)

diff --git a/libc/posix/aio/__aio_submit.c b/libc/posix/aio/__aio_submit.c
index 995b87a981..5472d845ac 100644
--- a/libc/posix/aio/__aio_submit.c
+++ b/libc/posix/aio/__aio_submit.c
@@ -57,6 +57,29 @@ __aio_unlink(struct __aio_req *req)
         }
 }
 
+/*
+ * Whether an earlier request on the same descriptor must finish first:
+ * appending writes go in the order they were queued, and a
+ * synchronization waits for every request queued before it. The lock
+ * is held.
+ */
+static bool
+__aio_must_wait(const struct __aio_req *req)
+{
+    const struct __aio_req *r;
+
+    /* Earlier requests follow this one in the list */
+    for (r = req->next; r; r = r->next) {
+        if (r->fildes != req->fildes)
+            continue;
+        if (req->op == __AIO_FSYNC || req->op == __AIO_FDATASYNC)
+            return true;
+        if (req->append && r->op == LIO_WRITE)
+            return true;
+    }
+    return false;
+}
+
 /* Run one request; each runs in its own thread */
 static void *
 __aio_run(void *arg)
@@ -68,6 +91,11 @@ __aio_run(void *arg)
     ssize_t            ret;
     int                error = 0;
 
+    pthread_mutex_lock(&__aio_lock);
+    while (__aio_must_wait(req))
+        pthread_cond_wait(&__aio_done, &__aio_lock);
+    pthread_mutex_unlock(&__aio_lock);
+
     /*
      * Pipes, sockets and terminals can't seek, so there the offset
      * doesn't apply and the transfer is a plain read or write
@@ -189,6 +217,10 @@ __aio_submit(struct aiocb *cb, int op, struct __aio_list *list)
     req->sigevent = cb->aio_sigevent;
     req->op = op;
     req->fildes = cb->aio_fildes;
+    /* Writes with O_APPEND, or to files that can't seek, append */
+    if (op == LIO_WRITE)
+        req->append = (fcntl(req->fd, F_GETFL) & O_APPEND) != 0
+            || (lseek(req->fd, 0, SEEK_CUR) < 0 && errno == ESPIPE);
 
     /*
      * Signals stay blocked while the lock is held, and in the new
diff --git a/libc/posix/aio/local-aio.h b/libc/posix/aio/local-aio.h
index d69a0a1196..7cd54d4dd0 100644
--- a/libc/posix/aio/local-aio.h
+++ b/libc/posix/aio/local-aio.h
@@ -71,6 +71,8 @@ struct __aio_req {
     /* The application's descriptor, and a duplicate the request uses */
     int                fildes;
     int                fd;
+    /* A write that appends, so it must follow earlier writes */
+    bool               append;
 };
 
