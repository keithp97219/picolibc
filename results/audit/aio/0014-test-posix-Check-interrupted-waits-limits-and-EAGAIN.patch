From 64c4e3713ff9dc0a7e4fa952b953b45544a69b1a Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:50:16 +0000
Subject: [PATCH 14/15] test-posix: Check interrupted waits, limits and EAGAIN
 in aio_suspend and lio_listio

---
 test/test-posix/test-aio/test-aio_suspend.c |  87 ++++++++-
 test/test-posix/test-aio/test-lio_listio.c  | 201 +++++++++++++++++++-
 2 files changed, 284 insertions(+), 4 deletions(-)

diff --git a/test/test-posix/test-aio/test-aio_suspend.c b/test/test-posix/test-aio/test-aio_suspend.c
index 83cd7030ca..f1f6f1695a 100644
--- a/test/test-posix/test-aio/test-aio_suspend.c
+++ b/test/test-posix/test-aio/test-aio_suspend.c
@@ -38,11 +38,13 @@
 
 /* Without the system support this test needs, it is skipped */
 #if _POSIX_ASYNCHRONOUS_IO > 0 && _POSIX_THREADS > 0 && defined(__PICOLIBC_POSIX_FILE_SYSTEM) \
-    && defined(__PICOLIBC_POSIX_FILE_SYSTEM_EXT)
+    && defined(__PICOLIBC_POSIX_FILE_SYSTEM_EXT) && defined(__PICOLIBC_POSIX_PIPE)            \
+    && defined(__PICOLIBC_POSIX_SIGNALS)
 
 #include <aio.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <pthread.h>
 #include <signal.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -93,14 +95,60 @@ wait_for(struct aiocb *cb)
         check(aio_suspend(list, 1, NULL) == 0 || errno == EINTR, "aio_suspend");
 }
 
+static volatile sig_atomic_t interrupted;
+static volatile int          stop_interrupting;
+static pthread_t             main_thread;
+
+static void
+handler(int sig)
+{
+    (void)sig;
+    interrupted = 1;
+}
+
+/*
+ * Signals the main thread until told to stop; one of them arrives while
+ * it waits, whenever it starts to
+ */
+static void *
+interrupter(void *arg)
+{
+    struct timespec pause = { 0, 5000000 };
+
+    (void)arg;
+    while (!__atomic_load_n(&stop_interrupting, __ATOMIC_ACQUIRE)) {
+        pthread_kill(main_thread, SIGUSR1);
+        nanosleep(&pause, NULL);
+    }
+    return NULL;
+}
+
+/* Calls aio_suspend with a cancellation pending */
+static void *
+cancel_pending(void *arg)
+{
+    const struct aiocb * const *list = arg;
+
+    pthread_cancel(pthread_self());
+    aio_suspend(list, 1, NULL);
+    return NULL;
+}
+
 int
 main(void)
 {
     struct aiocb        cb, *none = NULL;
     const struct aiocb *list[2];
     struct timespec     timeout = { 0, 50000000 };
+    struct sigaction    sa;
+    pthread_t           thread;
+    void               *result;
     char                buf[4];
-    int                 fd = scratch("data");
+    int                 fd = scratch("data"), pipefd[2], ret;
+
+    /* A request that hangs ends the test */
+    alarm(60);
+    main_thread = pthread_self();
 
     memset(&cb, 0, sizeof(cb));
     cb.aio_fildes = fd;
@@ -123,10 +171,43 @@ main(void)
     while (aio_error(&cb) == EINPROGRESS)
         check(aio_suspend(list, 2, NULL) == 0, "aio_suspend again");
     check(aio_suspend(list, 2, &timeout) == 0, "already done");
+
+#ifndef __GLIBC__
+    /* Even so, a pending cancellation is acted on (glibc returns 0) */
+    check(pthread_create(&thread, NULL, cancel_pending, &list[1]) == 0, "pthread_create");
+    check(pthread_join(thread, &result) == 0 && result == PTHREAD_CANCELED, "cancelled");
+#else
+    (void)cancel_pending;
+    (void)result;
+#endif
     (void)aio_return(&cb);
 
+    /* A request that can't finish times out */
+    check(pipe(pipefd) == 0, "pipe");
+    cb.aio_fildes = pipefd[0];
+    check(aio_read(&cb) == 0, "aio_read from an empty pipe");
+    check(aio_suspend(list, 2, &timeout) == -1 && errno == EAGAIN, "timed out");
+
+    /* A signal handler interrupts the wait */
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = handler;
+    sigemptyset(&sa.sa_mask);
+    check(sigaction(SIGUSR1, &sa, NULL) == 0, "sigaction");
+    check(pthread_create(&thread, NULL, interrupter, NULL) == 0, "pthread_create");
+    ret = aio_suspend(list, 2, NULL);
+    check(ret == -1 && errno == EINTR && interrupted, "EINTR");
+    __atomic_store_n(&stop_interrupting, 1, __ATOMIC_RELEASE);
+    check(pthread_join(thread, NULL) == 0, "pthread_join");
+    check(aio_error(&cb) == EINPROGRESS, "still waiting");
+
+    /* Then the request completes */
+    check(write(pipefd[1], "x", 1) == 1, "write to the pipe");
+    check(aio_suspend(list, 2, NULL) == 0 || errno == EINTR, "aio_suspend");
+    wait_for(&cb);
+    check(aio_return(&cb) == 1, "pipe read");
+    check(close(pipefd[0]) == 0 && close(pipefd[1]) == 0, "close the pipe");
+
     cleanup(fd);
-    (void)wait_for;
     printf("success\n");
     return 0;
 }
diff --git a/test/test-posix/test-aio/test-lio_listio.c b/test/test-posix/test-aio/test-lio_listio.c
index ff416d366b..c29ffb964f 100644
--- a/test/test-posix/test-aio/test-lio_listio.c
+++ b/test/test-posix/test-aio/test-lio_listio.c
@@ -39,17 +39,23 @@
 /* Without the system support this test needs, it is skipped */
 #if _POSIX_ASYNCHRONOUS_IO > 0 && _POSIX_THREADS > 0 && defined(__PICOLIBC_POSIX_DEVICE_IO) \
     && defined(__PICOLIBC_POSIX_FILE_SYSTEM) && defined(__PICOLIBC_POSIX_FILE_SYSTEM_EXT)   \
-    && defined(__PICOLIBC_POSIX_SIGNALS)
+    && defined(__PICOLIBC_POSIX_SIGNALS) && defined(__PICOLIBC_POSIX_PIPE)                  \
+    && defined(__PICOLIBC_POSIX_MULTI_PROCESS)
 
 #include <aio.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
 #include <signal.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
 #include <time.h>
 #include <unistd.h>
+#include "../is-qemu.h"
 
 /* lio_listio runs a list of requests, waiting or notifying */
 
@@ -106,6 +112,102 @@ handler(int sig, siginfo_t *info, void *context)
     list_done = 1;
 }
 
+static volatile sig_atomic_t interrupted;
+static volatile int          stop_interrupting;
+static pthread_t             main_thread;
+
+static void
+interrupt(int sig)
+{
+    (void)sig;
+    interrupted = 1;
+}
+
+/* Signals the main thread until told to stop */
+static void *
+interrupter(void *arg)
+{
+    struct timespec pause = { 0, 5000000 };
+
+    (void)arg;
+    while (!__atomic_load_n(&stop_interrupting, __ATOMIC_ACQUIRE)) {
+        pthread_kill(main_thread, SIGUSR2);
+        nanosleep(&pause, NULL);
+    }
+    return NULL;
+}
+
+static int           notify_pipe[2];
+static struct aiocb *notify_list[2];
+static volatile int  notify_all_done;
+
+/* The SIGEV_THREAD list notification */
+static void
+list_notified(union sigval value)
+{
+    struct aiocb **l = value.sival_ptr;
+
+    notify_all_done = aio_error(l[0]) != EINPROGRESS && aio_error(l[1]) != EINPROGRESS;
+    check(write(notify_pipe[1], "", 1) == 1, "notify");
+}
+
+/* Reads the process's address space size from /proc, without allocating */
+static long
+address_space(void)
+{
+    char    buf[64];
+    ssize_t n;
+    int     fd = open("/proc/self/statm", O_RDONLY);
+
+    if (fd < 0)
+        return -1;
+    n = read(fd, buf, sizeof(buf) - 1);
+    close(fd);
+    if (n <= 0)
+        return -1;
+    buf[n] = '\0';
+    return atol(buf) * sysconf(_SC_PAGESIZE);
+}
+
+/* Without memory for a request's thread, lio_listio and aio_read fail with EAGAIN */
+static void
+no_resources(int fd)
+{
+    struct aiocb  rd, *list[1] = { &rd };
+    char          buf[4];
+    struct rlimit rl;
+    pid_t         pid;
+    int           status;
+    long          size;
+
+    if (is_qemu()) {
+        printf("qemu places its own mappings; skipping the EAGAIN check\n");
+        return;
+    }
+    pid = fork();
+    check(pid >= 0, "fork");
+    if (pid == 0) {
+        alarm(30);
+        memset(&rd, 0, sizeof(rd));
+        rd.aio_fildes = fd;
+        rd.aio_buf = buf;
+        rd.aio_nbytes = 4;
+        rd.aio_lio_opcode = LIO_READ;
+        rd.aio_sigevent.sigev_notify = SIGEV_NONE;
+        size = address_space();
+        check(size > 0, "address space size");
+        /* No new mappings fit, so no thread stacks */
+        rl.rlim_cur = rl.rlim_max = size;
+        check(setrlimit(RLIMIT_AS, &rl) == 0, "setrlimit");
+        check(aio_read(&rd) == -1 && errno == EAGAIN, "aio_read EAGAIN");
+        check(lio_listio(LIO_WAIT, list, 1, NULL) == -1 && errno == EAGAIN, "LIO_WAIT EAGAIN");
+        check(aio_error(&rd) == EAGAIN || aio_error(&rd) == EINPROGRESS, "request status");
+        exit(0);
+    }
+    check(waitpid(pid, &status, 0) == pid && WIFEXITED(status) && WEXITSTATUS(status) == 0,
+          "no resources");
+}
+
 int
 main(void)
 {
@@ -116,6 +218,15 @@ main(void)
     char             buf[4];
     int              fd = scratch("abcdefgh");
 
+    /* A request that hangs ends the test */
+    alarm(60);
+
+    /*
+     * Before any other request: a child of a process that has used
+     * glibc's aio can wait for request threads it doesn't have
+     */
+    no_resources(fd);
+
     memset(&rd, 0, sizeof(rd));
     rd.aio_fildes = fd;
     rd.aio_buf = buf;
@@ -177,6 +288,94 @@ main(void)
     check(lio_listio(LIO_NOWAIT, list, 4, NULL) == -1 && errno == EIO, "invalid LIO_NOWAIT");
 #endif
     rd.aio_reqprio = 0;
+    wr.aio_lio_opcode = LIO_WRITE;
+
+    {
+        struct aiocb   **big;
+        long             max = sysconf(_SC_AIO_LISTIO_MAX);
+        struct aiocb     prd;
+        struct sigaction isa;
+        pthread_t        thread;
+        int              pipefd[2], ret;
+        char             c;
+
+        /* No more than AIO_LISTIO_MAX entries */
+        check(max >= _POSIX_AIO_LISTIO_MAX || max == -1, "_SC_AIO_LISTIO_MAX");
+        if (max > 0 && max < 100000) {
+            big = calloc(max + 1, sizeof(*big));
+            check(big != NULL, "calloc");
+            check(lio_listio(LIO_WAIT, big, (int)max, NULL) == 0, "AIO_LISTIO_MAX entries");
+            check(lio_listio(LIO_WAIT, big, (int)max + 1, NULL) == -1 && errno == EINVAL,
+                  "too many entries");
+            free(big);
+        }
+
+        /* LIO_WAIT ignores sig */
+        sev.sigev_notify = 12345;
+        check(lio_listio(LIO_WAIT, list, 4, &sev) == 0, "LIO_WAIT ignores sig");
+        check(aio_return(&rd) == 4 && aio_return(&wr) == 4, "results");
+
+#ifndef __GLIBC__
+        /* An invalid sig fails with nothing started (glibc doesn't check it) */
+        check(pwrite(fd, "wxyz", 4, 4) == 4, "pwrite");
+        check(lio_listio(LIO_NOWAIT, list, 4, &sev) == -1 && errno == EINVAL, "bad sig");
+        check(pread(fd, buf, 4, 4) == 4 && memcmp(buf, "wxyz", 4) == 0, "nothing written");
+#endif
+
+        /* SIGEV_THREAD notifies once every request is done */
+        check(pipe(pipefd) == 0 && pipe(notify_pipe) == 0, "pipe");
+        memset(&prd, 0, sizeof(prd));
+        prd.aio_fildes = pipefd[0];
+        prd.aio_buf = buf;
+        prd.aio_nbytes = 1;
+        prd.aio_lio_opcode = LIO_READ;
+        prd.aio_sigevent.sigev_notify = SIGEV_NONE;
+        notify_list[0] = &prd;
+        notify_list[1] = &wr;
+        memset(&sev, 0, sizeof(sev));
+        sev.sigev_notify = SIGEV_THREAD;
+        sev.sigev_notify_function = list_notified;
+        sev.sigev_value.sival_ptr = notify_list;
+        check(lio_listio(LIO_NOWAIT, notify_list, 2, &sev) == 0, "LIO_NOWAIT, SIGEV_THREAD");
+        wait_for(&wr);
+        /* The pipe read can't be done, so neither is the list */
+        check(aio_error(&prd) == EINPROGRESS, "pipe read waiting");
+        check(write(pipefd[1], "p", 1) == 1, "write to the pipe");
+        check(read(notify_pipe[0], &c, 1) == 1, "list notification");
+        check(notify_all_done, "notified after every request");
+        check(aio_return(&prd) == 1 && aio_return(&wr) == 4, "results");
+
+#ifndef __GLIBC__
+        /*
+         * A signal handler interrupts LIO_WAIT, leaving the requests
+         * running (glibc returns EINTR, then its request thread crashes)
+         */
+        main_thread = pthread_self();
+        memset(&isa, 0, sizeof(isa));
+        isa.sa_handler = interrupt;
+        sigemptyset(&isa.sa_mask);
+        check(sigaction(SIGUSR2, &isa, NULL) == 0, "sigaction");
+        check(pthread_create(&thread, NULL, interrupter, NULL) == 0, "pthread_create");
+        ret = lio_listio(LIO_WAIT, notify_list, 1, NULL);
+        check(ret == -1 && errno == EINTR && interrupted, "EINTR");
+        __atomic_store_n(&stop_interrupting, 1, __ATOMIC_RELEASE);
+        check(pthread_join(thread, NULL) == 0, "pthread_join");
+        check(aio_error(&prd) == EINPROGRESS, "still waiting");
+        check(write(pipefd[1], "q", 1) == 1, "write to the pipe");
+        wait_for(&prd);
+        check(aio_return(&prd) == 1 && buf[0] == 'q', "interrupted list's read");
+#else
+        (void)thread;
+        (void)ret;
+        (void)isa;
+        (void)interrupter;
+        (void)interrupt;
+#endif
+        check(close(pipefd[0]) == 0 && close(pipefd[1]) == 0 && close(notify_pipe[0]) == 0
+                  && close(notify_pipe[1]) == 0,
+              "close the pipes");
+    }
+
     cleanup(fd);
     (void)wait_for;
     printf("success\n");
-- 
