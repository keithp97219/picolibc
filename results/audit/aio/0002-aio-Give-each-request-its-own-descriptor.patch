From 8afe766403e84572eea580e2ba28a4fa6161e9cf Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:28:41 +0000
Subject: [PATCH 02/15] aio: Give each request its own descriptor

A request used the application's descriptor whenever its thread got
to run, so a close right after queuing it made it fail with EBADF,
or act on whatever file reused the number. POSIX has an uncanceled
request complete as if the close hadn't happened yet. Each request
now duplicates the descriptor when it is queued, which also reports
a bad descriptor at once, and keeps what it needs after completion
in its own structure instead of the aiocb.
---
 libc/include/aio.h            |  7 +--
 libc/posix/aio/__aio_submit.c | 99 ++++++++++++++++++++++-------------
 libc/posix/aio/aio_cancel.c   | 10 ++--
 libc/posix/aio/local-aio.h    | 27 +++++++---
 4 files changed, 91 insertions(+), 52 deletions(-)

diff --git a/libc/include/aio.h b/libc/include/aio.h
index 4c16fd1b73..c25597847b 100644
--- a/libc/include/aio.h
+++ b/libc/include/aio.h
@@ -53,11 +53,8 @@ struct aiocb {
     int             aio_lio_opcode; /* Operation to be performed */
 
     /* Private to the implementation */
-    int           __aio_op;
-    int           __aio_error;
-    ssize_t       __aio_return;
-    struct aiocb *__aio_next;
-    void         *__aio_list;
+    int             __aio_error;
+    ssize_t         __aio_return;
 };
 
 /* aio_cancel results */
diff --git a/libc/posix/aio/__aio_submit.c b/libc/posix/aio/__aio_submit.c
index 112cd0796d..995b87a981 100644
--- a/libc/posix/aio/__aio_submit.c
+++ b/libc/posix/aio/__aio_submit.c
@@ -34,24 +34,37 @@
  */
 
 #include "local-aio.h"
+#include <fcntl.h>
 #include <limits.h>
 #include <signal.h>
 #include <stdlib.h>
 #include <unistd.h>
 
-pthread_mutex_t __aio_lock = PTHREAD_MUTEX_INITIALIZER;
-pthread_cond_t  __aio_done = PTHREAD_COND_INITIALIZER;
-struct aiocb   *__aio_running;
+pthread_mutex_t   __aio_lock = PTHREAD_MUTEX_INITIALIZER;
+pthread_cond_t    __aio_done = PTHREAD_COND_INITIALIZER;
+struct __aio_req *__aio_running;
+
+/* Takes a request off the running list; the lock is held */
+static void
+__aio_unlink(struct __aio_req *req)
+{
+    struct __aio_req **prev;
+
+    for (prev = &__aio_running; *prev; prev = &(*prev)->next)
+        if (*prev == req) {
+            *prev = req->next;
+            break;
+        }
+}
 
 /* Run one request; each runs in its own thread */
 static void *
 __aio_run(void *arg)
 {
-    struct aiocb      *cb = arg;
-    struct sigevent    sigevent = cb->aio_sigevent;
-    struct __aio_list *list = cb->__aio_list;
+    struct __aio_req  *req = arg;
+    struct aiocb      *cb = req->cb;
+    struct __aio_list *list = req->list;
     bool               notify_list = false;
-    struct aiocb     **prev;
     ssize_t            ret;
     int                error = 0;
 
@@ -59,33 +72,30 @@ __aio_run(void *arg)
      * Pipes, sockets and terminals can't seek, so there the offset
      * doesn't apply and the transfer is a plain read or write
      */
-    switch (cb->__aio_op) {
+    switch (req->op) {
     case LIO_READ:
-        ret = pread(cb->aio_fildes, (void *)cb->aio_buf, cb->aio_nbytes, cb->aio_offset);
+        ret = pread(req->fd, (void *)cb->aio_buf, cb->aio_nbytes, cb->aio_offset);
         if (ret < 0 && errno == ESPIPE)
-            ret = read(cb->aio_fildes, (void *)cb->aio_buf, cb->aio_nbytes);
+            ret = read(req->fd, (void *)cb->aio_buf, cb->aio_nbytes);
         break;
     case LIO_WRITE:
-        ret = pwrite(cb->aio_fildes, (const void *)cb->aio_buf, cb->aio_nbytes, cb->aio_offset);
+        ret = pwrite(req->fd, (const void *)cb->aio_buf, cb->aio_nbytes, cb->aio_offset);
         if (ret < 0 && errno == ESPIPE)
-            ret = write(cb->aio_fildes, (const void *)cb->aio_buf, cb->aio_nbytes);
+            ret = write(req->fd, (const void *)cb->aio_buf, cb->aio_nbytes);
         break;
     case __AIO_FDATASYNC:
-        ret = fdatasync(cb->aio_fildes);
+        ret = fdatasync(req->fd);
         break;
     default:
-        ret = fsync(cb->aio_fildes);
+        ret = fsync(req->fd);
         break;
     }
     if (ret < 0)
         error = errno;
+    close(req->fd);
 
     pthread_mutex_lock(&__aio_lock);
-    for (prev = &__aio_running; *prev; prev = &(*prev)->__aio_next)
-        if (*prev == cb) {
-            *prev = cb->__aio_next;
-            break;
-        }
+    __aio_unlink(req);
     __aio_set_status(cb, ret, error);
     if (list) {
         if (error)
@@ -97,11 +107,12 @@ __aio_run(void *arg)
     pthread_mutex_unlock(&__aio_lock);
 
     /* The caller may reuse cb as soon as the status is visible */
-    __aio_notify(&sigevent);
+    __aio_notify(&req->sigevent);
     if (notify_list) {
         __aio_notify(&list->sigevent);
         free(list);
     }
+    free(req);
     return NULL;
 }
 
@@ -141,23 +152,43 @@ __aio_check_sigevent(const struct sigevent *sev)
 int
 __aio_submit(struct aiocb *cb, int op, struct __aio_list *list)
 {
-    pthread_attr_t attr;
-    pthread_t      thread;
-    sigset_t       old;
-    int            ret;
+    struct __aio_req *req = NULL;
+    pthread_attr_t    attr;
+    pthread_t         thread;
+    sigset_t          old;
+    int               ret;
 
     if (cb->aio_reqprio < 0 || cb->aio_reqprio > AIO_PRIO_DELTA_MAX)
         ret = EINVAL;
     else
         ret = __aio_check_sigevent(&cb->aio_sigevent);
+    if (ret == 0) {
+        req = calloc(1, sizeof(*req));
+        if (!req)
+            ret = EAGAIN;
+    }
+    if (ret == 0) {
+        /*
+         * The request uses its own descriptor, so it completes as if a
+         * close of the application's descriptor came after it
+         */
+        req->fd = fcntl(cb->aio_fildes, F_DUPFD_CLOEXEC, 0);
+        if (req->fd < 0) {
+            ret = errno == EBADF ? EBADF : EAGAIN;
+            free(req);
+        }
+    }
     if (ret) {
         /* Don't leave an earlier request's status behind */
         __aio_set_status(cb, -1, ret);
         return ret;
     }
 
-    cb->__aio_op = op;
-    cb->__aio_list = list;
+    req->cb = cb;
+    req->list = list;
+    req->sigevent = cb->aio_sigevent;
+    req->op = op;
+    req->fildes = cb->aio_fildes;
 
     /*
      * Signals stay blocked while the lock is held, and in the new
@@ -165,8 +196,8 @@ __aio_submit(struct aiocb *cb, int op, struct __aio_list *list)
      */
     __aio_lock_nosig(&old);
     __aio_set_status(cb, -1, EINPROGRESS);
-    cb->__aio_next = __aio_running;
-    __aio_running = cb;
+    req->next = __aio_running;
+    __aio_running = req;
     if (list)
         list->count++;
     pthread_mutex_unlock(&__aio_lock);
@@ -174,23 +205,19 @@ __aio_submit(struct aiocb *cb, int op, struct __aio_list *list)
     ret = pthread_attr_init(&attr);
     if (ret == 0) {
         pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
-        ret = pthread_create(&thread, &attr, __aio_run, cb);
+        ret = pthread_create(&thread, &attr, __aio_run, req);
         pthread_attr_destroy(&attr);
     }
 
     if (ret) {
-        struct aiocb **prev;
-
         pthread_mutex_lock(&__aio_lock);
-        for (prev = &__aio_running; *prev; prev = &(*prev)->__aio_next)
-            if (*prev == cb) {
-                *prev = cb->__aio_next;
-                break;
-            }
+        __aio_unlink(req);
         __aio_set_status(cb, -1, EAGAIN);
         if (list)
             list->count--;
         pthread_mutex_unlock(&__aio_lock);
+        close(req->fd);
+        free(req);
     }
     pthread_sigmask(SIG_SETMASK, &old, NULL);
     return ret ? EAGAIN : 0;
diff --git a/libc/posix/aio/aio_cancel.c b/libc/posix/aio/aio_cancel.c
index 8c466ef7eb..68bdc41b98 100644
--- a/libc/posix/aio/aio_cancel.c
+++ b/libc/posix/aio/aio_cancel.c
@@ -40,9 +40,9 @@
 int
 aio_cancel(int fd, struct aiocb *cb)
 {
-    struct aiocb *r;
-    sigset_t      old;
-    int           ret = AIO_ALLDONE;
+    struct __aio_req *r;
+    sigset_t          old;
+    int               ret = AIO_ALLDONE;
 
     if (fcntl(fd, F_GETFD) < 0)
         return -1;
@@ -51,8 +51,8 @@ aio_cancel(int fd, struct aiocb *cb)
         return -1;
     }
     __aio_lock_nosig(&old);
-    for (r = __aio_running; r; r = r->__aio_next)
-        if (r->aio_fildes == fd && (!cb || r == cb)) {
+    for (r = __aio_running; r; r = r->next)
+        if (r->fildes == fd && (!cb || r->cb == cb)) {
             ret = AIO_NOTCANCELED;
             break;
         }
diff --git a/libc/posix/aio/local-aio.h b/libc/posix/aio/local-aio.h
index 1fc4b43d6a..d69a0a1196 100644
--- a/libc/posix/aio/local-aio.h
+++ b/libc/posix/aio/local-aio.h
@@ -58,21 +58,36 @@ struct __aio_list {
     struct sigevent sigevent;
 };
 
+/*
+ * A queued request. It holds what the request needs once its status
+ * is set, when the application may reuse the aiocb.
+ */
+struct __aio_req {
+    struct __aio_req  *next;
+    struct aiocb      *cb;
+    struct __aio_list *list;
+    struct sigevent    sigevent;
+    int                op;
+    /* The application's descriptor, and a duplicate the request uses */
+    int                fildes;
+    int                fd;
+};
+
 /*
  * Guards the list of running requests and the lio_listio counts. A
  * request's status, __aio_error, is also read without it, as aio_error
  * and aio_return must work in signal handlers: __aio_return is set
  * first and __aio_error stored last, with release ordering.
  */
-extern pthread_mutex_t __aio_lock;
+extern pthread_mutex_t   __aio_lock;
 /* Broadcast whenever a request completes */
-extern pthread_cond_t  __aio_done;
-/* The running requests */
-extern struct aiocb   *__aio_running;
+extern pthread_cond_t    __aio_done;
+/* The running requests, newest first */
+extern struct __aio_req *__aio_running;
 
 /* Take __aio_lock with signals blocked, so no handler runs while it's held */
-void                   __aio_lock_nosig(sigset_t *old);
-void                   __aio_unlock_nosig(const sigset_t *old);
+void                     __aio_lock_nosig(sigset_t *old);
+void                     __aio_unlock_nosig(const sigset_t *old);
 
 /* Records a request's final status */
 static inline void
-- 
2.47.3

