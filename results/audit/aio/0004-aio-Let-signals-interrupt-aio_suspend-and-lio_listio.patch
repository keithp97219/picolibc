From 0ffdd6358e8254e0b15d2827cd2d653c037297a0 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:30:55 +0000
Subject: [PATCH 04/15] aio: Let signals interrupt aio_suspend and lio_listio

Both waited on a condition variable, which a signal handler doesn't
interrupt, so neither ever failed with EINTR as POSIX requires. They
now wait on a semaphore of their own that each completion posts.
lio_listio, when interrupted, leaves the list for its last request to
free. aio_suspend no longer holds the aio lock with signals allowed,
where a handler calling it would deadlock.
---
 libc/posix/aio/__aio_submit.c | 48 ++++++++++++++++++++++++++++-------
 libc/posix/aio/aio_suspend.c  | 44 ++++++++++++++++++++++----------
 libc/posix/aio/lio_listio.c   | 39 ++++++++++++++++++++++------
 libc/posix/aio/local-aio.h    | 22 ++++++++++++++--
 4 files changed, 121 insertions(+), 32 deletions(-)

diff --git a/libc/posix/aio/__aio_submit.c b/libc/posix/aio/__aio_submit.c
index 5472d845ac..e6fc783b5f 100644
--- a/libc/posix/aio/__aio_submit.c
+++ b/libc/posix/aio/__aio_submit.c
@@ -40,9 +40,10 @@
 #include <stdlib.h>
 #include <unistd.h>
 
-pthread_mutex_t   __aio_lock = PTHREAD_MUTEX_INITIALIZER;
-pthread_cond_t    __aio_done = PTHREAD_COND_INITIALIZER;
-struct __aio_req *__aio_running;
+pthread_mutex_t      __aio_lock = PTHREAD_MUTEX_INITIALIZER;
+pthread_cond_t       __aio_done = PTHREAD_COND_INITIALIZER;
+struct __aio_req    *__aio_running;
+struct __aio_waiter *__aio_waiters;
 
 /* Takes a request off the running list; the lock is held */
 static void
@@ -84,12 +85,13 @@ __aio_must_wait(const struct __aio_req *req)
 static void *
 __aio_run(void *arg)
 {
-    struct __aio_req  *req = arg;
-    struct aiocb      *cb = req->cb;
-    struct __aio_list *list = req->list;
-    bool               notify_list = false;
-    ssize_t            ret;
-    int                error = 0;
+    struct __aio_req    *req = arg;
+    struct aiocb        *cb = req->cb;
+    struct __aio_list   *list = req->list;
+    bool                 notify_list = false;
+    struct __aio_waiter *w;
+    ssize_t              ret;
+    int                  error = 0;
 
     pthread_mutex_lock(&__aio_lock);
     while (__aio_must_wait(req))
@@ -132,6 +134,8 @@ __aio_run(void *arg)
             notify_list = true;
     }
     pthread_cond_broadcast(&__aio_done);
+    for (w = __aio_waiters; w; w = w->next)
+        sem_post(&w->sem);
     pthread_mutex_unlock(&__aio_lock);
 
     /* The caller may reuse cb as soon as the status is visible */
@@ -161,6 +165,32 @@ __aio_unlock_nosig(const sigset_t *old)
     pthread_sigmask(SIG_SETMASK, old, NULL);
 }
 
+void
+__aio_add_waiter(struct __aio_waiter *w)
+{
+    sigset_t old;
+
+    __aio_lock_nosig(&old);
+    w->next = __aio_waiters;
+    __aio_waiters = w;
+    __aio_unlock_nosig(&old);
+}
+
+void
+__aio_remove_waiter(struct __aio_waiter *w)
+{
+    struct __aio_waiter **prev;
+    sigset_t              old;
+
+    __aio_lock_nosig(&old);
+    for (prev = &__aio_waiters; *prev; prev = &(*prev)->next)
+        if (*prev == w) {
+            *prev = w->next;
+            break;
+        }
+    __aio_unlock_nosig(&old);
+}
+
 int
 __aio_check_sigevent(const struct sigevent *sev)
 {
diff --git a/libc/posix/aio/aio_suspend.c b/libc/posix/aio/aio_suspend.c
index fb2249745e..d1456e32bc 100644
--- a/libc/posix/aio/aio_suspend.c
+++ b/libc/posix/aio/aio_suspend.c
@@ -46,18 +46,22 @@ __aio_any_done(const struct aiocb * const list[], int nent)
     return false;
 }
 
+/* Cancellation removes the waiter */
 static void
-__aio_unlock(void *arg)
+__aio_suspend_cleanup(void *arg)
 {
-    (void)arg;
-    pthread_mutex_unlock(&__aio_lock);
+    struct __aio_waiter *w = arg;
+
+    __aio_remove_waiter(w);
+    sem_destroy(&w->sem);
 }
 
 int
 aio_suspend(const struct aiocb * const list[], int nent, const struct timespec *timeout)
 {
-    struct timespec end;
-    int             ret = 0;
+    struct __aio_waiter w;
+    struct timespec     end;
+    int                 ret = 0;
 
     if (nent < 0) {
         errno = EINVAL;
@@ -76,21 +80,35 @@ aio_suspend(const struct aiocb * const list[], int nent, const struct timespec *
             end.tv_nsec -= 1000000000L;
         }
     }
-    pthread_mutex_lock(&__aio_lock);
-    /* aio_suspend is a cancellation point; don't leave the lock held */
-    pthread_cleanup_push(__aio_unlock, NULL);
+    if (__aio_any_done(list, nent))
+        return 0;
+
+    /*
+     * Requests that complete after the waiter is added post its
+     * semaphore; the status of any that completed before is visible
+     * once it is added. Nothing is locked while waiting, so a signal
+     * handler can use aio functions, and sem_wait and sem_clockwait
+     * return EINTR after a handler runs.
+     */
+    sem_init(&w.sem, 0, 0);
+    __aio_add_waiter(&w);
+    pthread_cleanup_push(__aio_suspend_cleanup, &w);
     while (!__aio_any_done(list, nent)) {
+        int r;
+
         if (timeout)
-            ret = pthread_cond_clockwait(&__aio_done, &__aio_lock, CLOCK_MONOTONIC, &end);
+            r = sem_clockwait(&w.sem, CLOCK_MONOTONIC, &end);
         else
-            ret = pthread_cond_wait(&__aio_done, &__aio_lock);
-        if (ret == ETIMEDOUT && !__aio_any_done(list, nent))
+            r = sem_wait(&w.sem);
+        if (r < 0 && (errno == ETIMEDOUT || errno == EINTR)) {
+            if (!__aio_any_done(list, nent))
+                ret = errno == ETIMEDOUT ? EAGAIN : EINTR;
             break;
-        ret = 0;
+        }
     }
     pthread_cleanup_pop(1);
     if (ret) {
-        errno = EAGAIN;
+        errno = ret;
         return -1;
     }
     return 0;
diff --git a/libc/posix/aio/lio_listio.c b/libc/posix/aio/lio_listio.c
index 7c2286af49..bd2f2037bc 100644
--- a/libc/posix/aio/lio_listio.c
+++ b/libc/posix/aio/lio_listio.c
@@ -94,20 +94,43 @@ lio_listio(int mode, struct aiocb * __restrict const list[__restrict], int nent,
     }
 
