+    check(aio_write(&cb) == 0 && aio_write(&cb2) == 0, "aio_write to a full pipe");
+    check(close(pipefd[1]) == 0, "close the pipe");
+    check(drain(pipefd[0], filled, buf, sizeof(buf)) == 11, "read to the end");
