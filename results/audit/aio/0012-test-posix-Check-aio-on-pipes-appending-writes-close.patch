+    check(sigaction(SIGUSR1, &sa, NULL) == 0, "sigaction");
+    sigemptyset(&block);
+    sigaddset(&block, SIGUSR1);
+    /* Blocked until sigsuspend, so the signal can't arrive before the wait */
