+    check(aio_write(&cb) == 0, "aio_write before close");
+    check(close(cb.aio_fildes) == 0, "close");
+    wait_for(&cb);
+#ifndef __GLIBC__
+    check(aio_error(&cb) == 0 && aio_return(&cb) == 2, "written after close");
+#else
+    if (aio_return(&cb) != 2)
+        check(pwrite(fd, "YZ", 2, 8) == 2, "write instead");
