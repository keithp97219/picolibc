+    check(write(pipefd[1], "xyz", 3) == 3, "write to the pipe");
+    wait_for(&cb);
+    check(aio_error(&cb) == 0 && aio_return(&cb) == 3 && memcmp(buf, "xyz", 3) == 0, "pipe read");
