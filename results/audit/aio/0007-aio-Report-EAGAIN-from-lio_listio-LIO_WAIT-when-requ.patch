From 53670ab0b0dfe71c0f6bfd9e3467d3843fd448d0 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:31:18 +0000
Subject: [PATCH 07/15] aio: Report EAGAIN from lio_listio(LIO_WAIT) when
 requests can't be queued

lio_listio fails with EAGAIN when the resources to queue the requests
aren't available, but with LIO_WAIT it said EIO.
---
 libc/posix/aio/lio_listio.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libc/posix/aio/lio_listio.c b/libc/posix/aio/lio_listio.c
index bd2f2037bc..336b4d07e2 100644
--- a/libc/posix/aio/lio_listio.c
+++ b/libc/posix/aio/lio_listio.c
@@ -142,7 +142,7 @@ lio_listio(int mode, struct aiocb * __restrict const list[__restrict], int nent,
     if (wait) {
         free(l);
         if (failed || submit_failed) {
-            errno = EIO;
+            errno = submit_error ? submit_error : EIO;
             return -1;
         }
         return 0;
