From b54aca103589eeddd63f34e63d3fd2af953dcb36 Mon Sep 17 00:00:00 2001
From: Keith Packard <keithp@keithp.com>
Date: Sat, 21 Nov 2026 01:34:16 +0000
Subject: [PATCH 10/12] wordexp: Don't act on cancellation requests

wordexp may be a cancellation point, but a request acting in read or
waitpid left the pipe, the output buffer and an unreaped child behind,
and the child acted on it too. Hold cancellation off throughout.
---
 libc/posix/wordexp/wordexp.c | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/libc/posix/wordexp/wordexp.c b/libc/posix/wordexp/wordexp.c
index afc9feb687..48adf92573 100644
--- a/libc/posix/wordexp/wordexp.c
+++ b/libc/posix/wordexp/wordexp.c
@@ -42,6 +42,10 @@
 #include <string.h>
 #include <sys/wait.h>
 #include <unistd.h>
+#include <picolibc.h>
+#ifdef __PICOLIBC_PTHREADS
+#include <pthread.h>
+#endif
 
 /*
  * Checks for characters the shell would treat as operators outside of
@@ -245,8 +249,8 @@ __wordexp_ok(int status, size_t len)
     return WIFEXITED(status) && WEXITSTATUS(status) == 0 && len >= 2;
 }
 
-int
-wordexp(const char * __restrict words, wordexp_t * __restrict we, int flags)
+static int
+__wordexp(const char * __restrict words, wordexp_t * __restrict we, int flags)
 {
     char  *out, *p, **wordv;
     size_t len, count = 0, offs, i;
@@ -324,3 +328,23 @@ wordexp(const char * __restrict words, wordexp_t * __restrict we, int flags)
     free(out);
     return 0;
 }
+
+int
+wordexp(const char * __restrict words, wordexp_t * __restrict we, int flags)
+{
+    int ret;
+#ifdef __PICOLIBC_PTHREADS
+    int cancel;
+
+    /*
+     * wordexp may be a cancellation point, but acting on a request in
+     * the middle would leak the pipe, the output and the child
+     */
+    pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cancel);
+#endif
+    ret = __wordexp(words, we, flags);
+#ifdef __PICOLIBC_PTHREADS
+    pthread_setcancelstate(cancel, NULL);
+#endif
+    return ret;
+}
