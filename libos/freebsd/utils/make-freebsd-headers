class Probe:
    def __init__(self, sysdir, arch, workdir):
        self.sysdir = sysdir
        self.arch = arch
        self.workdir = workdir
        inc = os.path.join(workdir, "inc")
        os.makedirs(inc, exist_ok=True)
        machine, x86 = MACHINE_DIRS[arch]
        for name, sub in (("machine", machine), ("x86", x86)):
            link = os.path.join(inc, name)
            if not os.path.exists(link):
                os.symlink(os.path.join(sysdir, sub, "include"), link)
        # The kernel headers include a few userland headers; empty ones do
        stub = os.path.join(workdir, "stub")
        os.makedirs(stub, exist_ok=True)
        for h in ("time.h", "stddef.h", "signal.h", "stdbool.h", "stdint.h"):
            open(os.path.join(stub, h), "w").close()
        self.args = ["clang", "--target=" + TRIPLES[arch], "-nostdinc",
                     "-I", sysdir, "-I", inc, "-I", stub, "-w", "-S", "-o", "-"]

    def values(self, exprs):
        """Evaluate integer constant expressions, dropping those that fail"""
        exprs = dict(exprs)
        while exprs:
            names = list(exprs)
            lines = ["#include <%s>" % h for h in PROBE_HEADERS]
            lines.append("void __probe(void) {")
            first = len(lines) + 1
            for n in names:
                lines.append('__asm__ volatile(".ascii \\"@@VAL %s %%c0\\"" :: "i"((long)(%s)));'
                             % (n, exprs[n]))
            lines.append("}")
            src = os.path.join(self.workdir, "probe.c")
            with open(src, "w") as f:
                f.write("\n".join(lines) + "\n")
            r = subprocess.run(self.args + [src], capture_output=True, text=True)
            if r.returncode == 0:
                out = {}
                for m in re.finditer(r'@@VAL (\S+) (-?\d+)', r.stdout):
                    out[m.group(1)] = int(m.group(2))
                return out
            bad = set()
            for m in re.finditer(r'probe\.c:(\d+):\d+: error', r.stderr):
                i = int(m.group(1)) - first
                if 0 <= i < len(names):
                    bad.add(names[i])
            if not bad:
                sys.stderr.write(r.stderr)
                raise SystemExit("probe failed outside the markers")
            for n in bad:
                del exprs[n]
        return {}

    def macro_names(self, headers, pattern):
        """Object-like macros defined in these headers matching pattern"""
        names = []
        rx = re.compile(r'^#\s*define\s+(' + pattern + r')\b(?!\()', re.M)
        for h in headers:
            for base in (self.sysdir, os.path.join(self.workdir, "inc")):
                path = os.path.join(base, h)
                if os.path.exists(path):
                    with open(path) as f:
                        for m in rx.finditer(f.read()):
                            if m.group(1) not in names:
                                names.append(m.group(1))
                    break
        return names


def guard(name):
    return "_FREEBSD_%s_H_" % name.upper().replace("-", "_")


def write_header(path, name, body):
    with open(path, "w") as f:
        f.write(COPYRIGHT)
        f.write("\n#ifndef %s\n#define %s\n\n" % (guard(name), guard(name)))
        f.write(body)
        f.write("\n#endif /* %s */\n" % guard(name))
    subprocess.run(["clang-format", "-i", path], check=False)


def fmt(v, flags):
    # Values beyond int need a long suffix; the most negative long has no literal
    suffix = "" if -2**31 <= v < 2**31 else "L"
    if v == -2**63:
        return "(-0x7fffffffffffffffL - 1)"
    if flags and v >= 0:
        return "0x%08x%s" % (v, suffix)
    return "%d%s" % (v, suffix)


def gen_syscall(sysdir, outdir):
    rx = re.compile(r'^#define\s+SYS_(\w+)\s+(\d+)', re.M)
    with open(os.path.join(sysdir, "sys", "syscall.h")) as f:
        calls = [(m.group(1), int(m.group(2))) for m in rx.finditer(f.read())]
    body = "".join("#define FREEBSD_SYS_%s %d\n" % c for c in sorted(calls, key=lambda c: c[1]))
    write_header(os.path.join(outdir, "freebsd-syscall.h"), "syscall", body)


def gen_errno(probe, outdir):
    names = probe.macro_names(["sys/errno.h"], r"E[A-Z0-9]+")
    names = [n for n in names if n not in ("ELAST", "ERESTART", "EJUSTRETURN",
                                           "ENOIOCTL", "EDIRIOCTL", "ERELOOKUP")]
    vals = probe.values({n: n for n in names})
    order = sorted(vals, key=lambda n: (vals[n], n))
    body = "".join("#define FREEBSD_%s %d\n" % (n, vals[n]) for n in order)
    maxe = max(vals.values())
    body += "\n#define FREEBSD_ERRNO_MAX %d\n\n" % maxe
    body += ("/* Kernel errno to picolibc errno; 0 marks one picolibc lacks */\n"
             "static const unsigned char __freebsd_errno_map[FREEBSD_ERRNO_MAX + 1] = {\n")
    seen = set()
    for n in order:
        if vals[n] in seen:
            continue
        seen.add(vals[n])
        body += "#ifdef %s\n    [FREEBSD_%s] = %s,\n#endif\n" % (n, n, n)
    body += "};\n"
    write_header(os.path.join(outdir, "freebsd-errno.h"), "errno", body)


def gen_constants(probe, outdir):
    for name, headers, pattern, flags in CONSTANTS:
        names = probe.macro_names(headers, pattern)
        exprs = {n: n for n in names}
        exprs.update(EXTRA_CONSTANTS.get(name, {}))
        vals = probe.values(exprs)
        order = sorted(vals, key=lambda n: n)
        body = "".join("#define FREEBSD_%s %s\n" % (n, fmt(vals[n], flags)) for n in order)
        write_header(os.path.join(outdir, "freebsd-%s.h" % name), name, body)


def gen_structs(probe, outdir):
    for name, ctype, members in STRUCTS:
        exprs = {"SIZE": "sizeof(%s)" % ctype}
        members = [(mt[0], mt[1], mt[2] if len(mt) > 2 else mt[0]) for mt in members]
        for m, _, k in members:
            exprs["OFF_" + m] = "__builtin_offsetof(%s, %s)" % (ctype, k)
            exprs["SZ_" + m] = "sizeof(((%s *)0)->%s)" % (ctype, k)
        vals = probe.values(exprs)
        missing = [m for m, _, _ in members if "OFF_" + m not in vals]
        if missing or "SIZE" not in vals:
            raise SystemExit("%s: no member %s" % (ctype, ", ".join(missing)))
        lines = ["struct __freebsd_%s {" % name]
        pos = 0
        for m, t, _ in sorted(members, key=lambda mt: vals["OFF_" + mt[0]]):
            off = vals["OFF_" + m]
            if off > pos:
                lines.append("    __uint8_t __adjust_%d[%d];" % (pos, off - pos))
            if off < pos:
                raise SystemExit("%s: %s overlaps" % (ctype, m))
            arr = re.match(r'(.*)\[(\d+)\]$', t)
            if arr:
                lines.append("    %s %s[%s];" % (arr.group(1), m, arr.group(2)))
            else:
                lines.append("    %s %s;" % (t, m))
            pos = off + vals["SZ_" + m]
        if vals["SIZE"] > pos:
            lines.append("    __uint8_t __adjust_%d[%d];" % (pos, vals["SIZE"] - pos))
        lines.append("};\n")
        lines.append("_Static_assert(sizeof(struct __freebsd_%s) == %d, \"%s size\");"
                     % (name, vals["SIZE"], ctype))
        for m, _, _ in members:
            lines.append("_Static_assert(__builtin_offsetof(struct __freebsd_%s, %s) == %d, \"%s.%s\");"
                         % (name, m, vals["OFF_" + m], ctype, m))
        body = "\n".join(lines) + "\n"
        write_header(os.path.join(outdir, "freebsd-%s-struct.h" % name), name + "-struct", body)


def main():
    ap = argparse.ArgumentParser(description=__doc__.strip().split("\n")[0])
    ap.add_argument("--sys", required=True, help="FreeBSD source tree's sys directory")
    ap.add_argument("--out", required=True, help="libos/freebsd directory")
    ap.add_argument("--arch", default="x86_64", choices=sorted(TRIPLES))
    args = ap.parse_args()

    outdir = os.path.join(args.out, "machine", args.arch, "freebsd")
    os.makedirs(outdir, exist_ok=True)
    with tempfile.TemporaryDirectory() as work:
        probe = Probe(os.path.abspath(args.sys), args.arch, work)
        gen_syscall(args.sys, outdir)
        gen_errno(probe, outdir)
        gen_constants(probe, outdir)
        gen_structs(probe, outdir)


if __name__ == "__main__":
    main()
