# Check that a header never tests an undefined macro in #if, so that
# applications building with -Wundef -Werror can include it. The
# answer depends on the feature-test macros and on strict ISO C, so try
# each mode.
#
# usage: check-wundef <header> <compiler> [args...]

input="$1"
shift
status=0
for mode in "" -D_POSIX_C_SOURCE=202405L -D_POSIX_C_SOURCE=200112L -D_XOPEN_SOURCE=800 -std=c99 -std=c11; do
    if ! output=$(echo '#include "'"$input"'"' | "$@" $mode -Wundef -Werror=undef -E -o /dev/null - 2>&1); then
        echo "$input${mode:+ with $mode}:"
        echo "$output"
        status=1
    fi
done
exit $status
